diff --git a/libtailscale/p21relay/guard.go b/libtailscale/p21relay/guard.go
new file mode 100644
index 0000000..a946a79
--- /dev/null
+++ b/libtailscale/p21relay/guard.go
@@ -0,0 +1,165 @@
+// Copyright (c) Phone21
+// SPDX-License-Identifier: BSD-3-Clause
+
+package p21relay
+
+import (
+	"net"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// connGuard bounds the connections other apps can hold open on one of the
+// relay's 127.0.0.1 ports. Each costs a descriptor and a goroutine of this
+// process, which the calling library and the tunnel need as well. Accepted
+// connections are never queued; when a limit is hit, a connection that is
+// not making progress goes:
+//
+//   - silent: accepted, nothing received yet. Closed after silentTimeout;
+//     above maxSilent the oldest silent one goes. The app's own clients
+//     send right after connecting, so they leave this state at once.
+//   - busy: has sent data. Above maxBusy the one that has waited longest
+//     for more data goes, never one marked in use (an authorised HTTP
+//     request in progress). A handshake that keeps making progress thus
+//     outlives connections that were opened and dropped or that stall.
+//
+// An app that keeps many connections busy with fresh data can still slow
+// the app's own connections down; complete protection against a local
+// denial of service is not possible on a port every app can reach.
+type connGuard struct {
+	name          string // counter prefix
+	maxSilent     int
+	maxBusy       int
+	silentTimeout time.Duration
+	cnt           *counters
+
+	mu     sync.Mutex
+	silent []*guardedConn // oldest first
+	busy   []*guardedConn
+}
+
+// guardedConn is an accepted connection watched by a connGuard.
+type guardedConn struct {
+	net.Conn
+	g     *connGuard
+	last  atomic.Int64 // unix nanoseconds of the latest read with data; 0 = silent
+	inUse atomic.Int32
+	timer *time.Timer // silence timeout; set under g.mu
+}
+
+func (g *connGuard) add(c net.Conn) *guardedConn {
+	gc := &guardedConn{Conn: c, g: g}
+	g.mu.Lock()
+	g.silent = append(g.silent, gc)
+	var victim *guardedConn
+	if len(g.silent) > g.maxSilent {
+		victim = g.silent[0]
+		g.silent = g.silent[1:]
+	}
+	gc.timer = time.AfterFunc(g.silentTimeout, func() { g.silenceExpired(gc) })
+	g.mu.Unlock()
+	if victim != nil {
+		g.evict(victim, "evicted_silent")
+	}
+	return gc
+}
+
+func (g *connGuard) silenceExpired(gc *guardedConn) {
+	g.mu.Lock()
+	expired := removeConn(&g.silent, gc)
+	g.mu.Unlock()
+	if expired {
+		g.cnt.inc(g.name + ".silent_timeout")
+		gc.Conn.Close()
+	}
+}
+
+// started moves gc from silent to busy after its first data.
+func (g *connGuard) started(gc *guardedConn) {
+	g.mu.Lock()
+	if !removeConn(&g.silent, gc) {
+		g.mu.Unlock()
+		return // evicted, timed out or no longer tracked
+	}
+	gc.timer.Stop()
+	g.busy = append(g.busy, gc)
+	var victim *guardedConn
+	if len(g.busy) > g.maxBusy {
+		for _, c := range g.busy {
+			if c == gc || c.inUse.Load() > 0 {
+				continue
+			}
+			if victim == nil || c.last.Load() < victim.last.Load() {
+				victim = c
+			}
+		}
+		if victim == nil {
+			victim = gc // all others are in use
+		}
+		removeConn(&g.busy, victim)
+	}
+	g.mu.Unlock()
+	if victim != nil {
+		g.evict(victim, "evicted_busy")
+	}
+}
+
+func (g *connGuard) evict(gc *guardedConn, why string) {
+	g.cnt.inc(g.name + "." + why)
+	gc.timer.Stop()
+	gc.Conn.Close() // its owner sees the error and closes the wrapper
+}
+
+// forget stops tracking gc (the connection is closed or trusted now).
+func (g *connGuard) forget(gc *guardedConn) {
+	g.mu.Lock()
+	if !removeConn(&g.silent, gc) {
+		removeConn(&g.busy, gc)
+	}
+	gc.timer.Stop()
+	g.mu.Unlock()
+}
+
+func (g *connGuard) counts() (silent, busy int) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	return len(g.silent), len(g.busy)
+}
+
+func removeConn(list *[]*guardedConn, gc *guardedConn) bool {
+	for i, c := range *list {
+		if c == gc {
+			*list = append((*list)[:i], (*list)[i+1:]...)
+			return true
+		}
+	}
+	return false
+}
+
+func (gc *guardedConn) Read(b []byte) (int, error) {
+	n, err := gc.Conn.Read(b)
+	if n > 0 && gc.last.Swap(time.Now().UnixNano()) == 0 {
+		gc.g.started(gc)
+	}
+	return n, err
+}
+
+func (gc *guardedConn) Close() error {
+	gc.g.forget(gc)
+	return gc.Conn.Close()
+}
+
+// guardedListener puts every accepted connection under a connGuard.
+type guardedListener struct {
+	net.Listener
+	g *connGuard
+}
+
+func (l guardedListener) Accept() (net.Conn, error) {
+	c, err := l.Listener.Accept()
+	if err != nil {
+		return nil, err
+	}
+	return l.g.add(c), nil
+}
