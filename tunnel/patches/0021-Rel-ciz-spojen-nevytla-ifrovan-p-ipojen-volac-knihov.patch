@@ -0,0 +1,141 @@
+// Copyright (c) Phone21
+// SPDX-License-Identifier: BSD-3-Clause
+
+package p21relay
+
+import (
+	"net"
+	"strconv"
+	"sync"
+	"testing"
+	"time"
+)
+
+// churn makes n goroutines open connections to addr as fast as they can;
+// half close them at once, half leave them silent for a while.
+func churn(t *testing.T, addr string, n int) (stop func()) {
+	t.Helper()
+	done := make(chan struct{})
+	var wg sync.WaitGroup
+	for i := 0; i < n; i++ {
+		wg.Add(1)
+		go func(keep bool) {
+			defer wg.Done()
+			var open []net.Conn
+			defer func() {
+				for _, c := range open {
+					c.Close()
+				}
+			}()
+			for {
+				select {
+				case <-done:
+					return
+				default:
+				}
+				c, err := net.DialTimeout("tcp4", addr, time.Second)
+				if err != nil {
+					continue
+				}
+				if !keep {
+					c.Close()
+					continue
+				}
+				open = append(open, c)
+				if len(open) > 32 {
+					open[0].Close()
+					open = open[1:]
+				}
+			}
+		}(i%2 == 0)
+	}
+	var once sync.Once
+	return func() { once.Do(func() { close(done); wg.Wait() }) }
+}
+
+// Other apps opening and dropping connections on the SIP port must not
+// push out the calling library's handshakes.
+func TestHandshakeChurn(t *testing.T) {
+	e := newEnv(t)
+	stop := churn(t, "127.0.0.1:"+strconv.Itoa(e.info.SIPPort), 8)
+	defer stop()
+	time.Sleep(100 * time.Millisecond)
+	failed := 0
+	for i := 0; i < 20; i++ {
+		before := e.counter("client.accepted")
+		conn, err := dialClient(t, e.info.SIPPort, &e.clientCert.tls)
+		if err != nil {
+			failed++
+			continue
+		}
+		deadline := time.Now().Add(waitLong)
+		for e.counter("client.accepted") == before && time.Now().Before(deadline) {
+			time.Sleep(time.Millisecond)
+		}
+		if e.counter("client.accepted") == before {
+			failed++
+		}
+		conn.Close()
+	}
+	stop()
+	if failed > 0 {
+		t.Fatalf("%d of 20 handshakes of the calling library failed", failed)
+	}
+	if e.counter("client.handshake.evicted_silent") == 0 {
+		t.Fatal("the limit for silent connections was never reached")
+	}
+	t.Logf("evicted silent %d, busy %d, silence timeouts %d", e.counter("client.handshake.evicted_silent"),
+		e.counter("client.handshake.evicted_busy"), e.counter("client.handshake.silent_timeout"))
+}
+
+// Connections that start a handshake and stall give way to one that
+// makes progress.
+func TestHandshakeStalledEvicted(t *testing.T) {
+	e := newEnv(t)
+	var stalled []net.Conn
+	for i := 0; i < maxPendingHandshakes+4; i++ {
+		c, err := net.Dial("tcp4", "127.0.0.1:"+strconv.Itoa(e.info.SIPPort))
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer c.Close()
+		c.Write([]byte{0x16}) // start of a handshake record, then nothing
+		stalled = append(stalled, c)
+	}
+	waitFor(t, func() bool {
+		_, busy := e.relay.sip.hsGuard.counts()
+		return busy == maxPendingHandshakes && e.counter("client.handshake.evicted_busy") == 4
+	})
+	// The oldest stalled ones went first.
+	for _, c := range stalled[:4] {
+		c.SetReadDeadline(time.Now().Add(waitLong))
+		if _, err := c.Read(make([]byte, 1)); err == nil {
+			t.Fatal("stalled connection got data")
+		}
+	}
+	newFakeClient(t, e)
+	if silent, busy := e.relay.sip.hsGuard.counts(); silent != 0 || busy > maxPendingHandshakes {
+		t.Fatalf("pending: %d silent, %d busy", silent, busy)
+	}
+}
+
+// A connection that sends nothing is closed after helloTimeout.
+func TestHandshakeSilentTimeout(t *testing.T) {
+	e := newEnv(t)
+	c, err := net.Dial("tcp4", "127.0.0.1:"+strconv.Itoa(e.info.SIPPort))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	start := time.Now()
+	c.SetReadDeadline(time.Now().Add(helloTimeout + waitLong))
+	if _, err := c.Read(make([]byte, 1)); err == nil {
+		t.Fatal("got data")
+	}
+	if d := time.Since(start); d < helloTimeout/2 || d > helloTimeout+time.Second {
+		t.Fatalf("closed after %v", d)
+	}
+	if e.counter("client.handshake.silent_timeout") != 1 {
+		t.Fatalf("silent_timeout %d", e.counter("client.handshake.silent_timeout"))
+	}
+}
