--- /dev/null
+++ b/libtailscale/p21relay/srtp.go
@@ -0,0 +1,464 @@
+// Copyright (c) Phone21
+// SPDX-License-Identifier: BSD-3-Clause
+
+package p21relay
+
+// Šifrování hlasu na úseku volací knihovna ↔ relé (SRTP s klíči z SDP,
+// RFC 3711 a RFC 4568). Volací knihovna přijímá RTP od kohokoli, takže
+// bez šifrování by cizí appka v telefonu mohla do hovoru podstrčit zvuk.
+// Relé šifrování ukončuje: k ústředně jde dál obyčejné RTP tunelem.
+//
+// Každá strana posílá v SDP klíč, kterým šifruje to, co sama odesílá:
+// klíčem volací knihovny relé ověřuje a dešifruje, svým klíčem šifruje
+// hlas směrem ke knihovně. Knihovna mění stav šifrování (počítadlo
+// přetečení, okno proti opakování) jen při změně klíče, proto relé při
+// stejném klíči kontext ponechává a při novém klíči začíná nový.
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/base64"
+	"errors"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/pion/rtcp"
+	"github.com/pion/rtp"
+	"github.com/pion/srtp/v3"
+	"github.com/pion/transport/v5/replaydetector"
+)
+
+// srtpSuite je podporovaná šifrovací sada (RFC 4568 6.2).
+type srtpSuite uint8
+
+const (
+	suiteNone srtpSuite = iota
+	suite80             // AES_CM_128_HMAC_SHA1_80
+	suite32             // AES_CM_128_HMAC_SHA1_32
+)
+
+// relaySuites jsou sady, které relé nabízí, v pořadí přednosti.
+var relaySuites = []srtpSuite{suite80, suite32}
+
+func (s srtpSuite) String() string {
+	switch s {
+	case suite80:
+		return "AES_CM_128_HMAC_SHA1_80"
+	case suite32:
+		return "AES_CM_128_HMAC_SHA1_32"
+	}
+	return ""
+}
+
+func suiteByName(name string) srtpSuite {
+	switch name {
+	case "AES_CM_128_HMAC_SHA1_80":
+		return suite80
+	case "AES_CM_128_HMAC_SHA1_32":
+		return suite32
+	}
+	return suiteNone
+}
+
+func (s srtpSuite) profile() srtp.ProtectionProfile {
+	if s == suite32 {
+		return srtp.ProtectionProfileAes128CmHmacSha1_32
+	}
+	return srtp.ProtectionProfileAes128CmHmacSha1_80
+}
+
+const (
+	srtpKeyLen    = 16
+	srtpSaltLen   = 14
+	srtpMasterLen = srtpKeyLen + srtpSaltLen
+
+	// srtpReplayWindow: okno proti opakování pro pakety volací knihovny.
+	// Na 127.0.0.1 se pakety nepřehazují, větší okno jen nic nestojí.
+	srtpReplayWindow = 1024
+	// srtpPeerWindow: okno libsrtp ve volací knihovně (výchozí 128, knihovna
+	// ho nemění). Paket o tolik a víc za nejvyšším číslem by zahodila.
+	srtpPeerWindow = 128
+	// Bezprostřední opakování téhož paketu (konec tónové volby se posílá
+	// třikrát se stejným číslem) se předá nejvýš tolikrát a jen v této době.
+	srtpMaxRepeats  = 2
+	srtpRepeatDelay = time.Second
+	// maxTrackedSSRC omezuje stav přečíslování na jeden proud.
+	maxTrackedSSRC = 16
+
+	maxSRTPIndex  = 1<<48 - 1
+	maxSRTCPIndex = 1<<31 - 1
+)
+
+// srtpKey je hlavní klíč a sůl jedné sady.
+type srtpKey struct {
+	suite  srtpSuite
+	master [srtpMasterLen]byte
+}
+
+func newRelayKey(s srtpSuite) srtpKey {
+	k := srtpKey{suite: s}
+	rand.Read(k.master[:]) // crypto/rand.Read nikdy nevrací chybu
+	return k
+}
+
+// cryptoLine je jeden použitelný atribut a=crypto.
+type cryptoLine struct {
+	tag int
+	key srtpKey
+}
+
+func (c cryptoLine) String() string {
+	return strconv.Itoa(c.tag) + " " + c.key.suite.String() + " inline:" + base64.StdEncoding.EncodeToString(c.key.master[:])
+}
+
+// parseCrypto přečte hodnotu atributu a=crypto (RFC 4568 9.1). Odmítne
+// nepodporované sady, víc klíčů nebo MKI, a parametry, které by vypnuly
+// šifrování nebo ověřování, nebo kterým relé nerozumí.
+func parseCrypto(v string) (cryptoLine, bool) {
+	f := strings.Fields(v)
+	if len(f) < 3 || len(f[0]) > 9 {
+		return cryptoLine{}, false
+	}
+	tag, err := strconv.Atoi(f[0])
+	if err != nil || tag < 0 {
+		return cryptoLine{}, false
+	}
+	suite := suiteByName(f[1])
+	if suite == suiteNone {
+		return cryptoLine{}, false
+	}
+	params, ok := strings.CutPrefix(f[2], "inline:")
+	if !ok || strings.Contains(params, ";") {
+		return cryptoLine{}, false
+	}
+	parts := strings.Split(params, "|")
+	if len(parts) > 2 || (len(parts) == 2 && strings.Contains(parts[1], ":")) {
+		return cryptoLine{}, false // MKI
+	}
+	raw, err := base64.StdEncoding.DecodeString(parts[0])
+	if err != nil {
+		raw, err = base64.RawStdEncoding.DecodeString(parts[0])
+	}
+	if err != nil || len(raw) != srtpMasterLen {
+		return cryptoLine{}, false
+	}
+	for _, p := range f[3:] {
+		switch {
+		case p == "KDR=0", strings.HasPrefix(p, "WSH="):
+		case strings.HasPrefix(p, "-"): // nepovinný parametr
+		default:
+			// UNENCRYPTED_SRTP/SRTCP, UNAUTHENTICATED_SRTP, KDR, FEC…
+			return cryptoLine{}, false
+		}
+	}
+	c := cryptoLine{tag: tag, key: srtpKey{suite: suite}}
+	copy(c.key.master[:], raw)
+	return c, true
+}
+
+// firstSupportedCrypto vybere první použitelný řádek (pořadí přednosti
+// určuje volací knihovna).
+func firstSupportedCrypto(values []string) (cryptoLine, bool) {
+	for _, v := range values {
+		if c, ok := parseCrypto(v); ok {
+			return c, true
+		}
+	}
+	return cryptoLine{}, false
+}
+
+// ---- kontexty ----
+
+// srtpCtx je kontext jednoho klíče pro jeden směr.
+type srtpCtx struct {
+	key    srtpKey
+	ctx    *srtp.Context
+	replay bool // poslední neúspěch byl opakovaný paket
+}
+
+// replayFlag obaluje detektor opakování a poznamená si odmítnutí.
+type replayFlag struct {
+	d   replaydetector.ReplayDetector
+	hit *bool
+}
+
+func (r replayFlag) Check(seq uint64) (func() bool, bool) {
+	accept, ok := r.d.Check(seq)
+	if !ok {
+		*r.hit = true
+	}
+	return accept, ok
+}
+
+func newSRTPCtx(k srtpKey, decrypt bool) (*srtpCtx, error) {
+	c := &srtpCtx{key: k}
+	var opts []srtp.ContextOption
+	if decrypt {
+		opts = []srtp.ContextOption{
+			srtp.SRTPReplayDetectorFactory(func() replaydetector.ReplayDetector {
+				return replayFlag{d: replaydetector.New(srtpReplayWindow, maxSRTPIndex), hit: &c.replay}
+			}),
+			srtp.SRTCPReplayDetectorFactory(func() replaydetector.ReplayDetector {
+				return replayFlag{d: replaydetector.New(srtpReplayWindow, maxSRTCPIndex), hit: &c.replay}
+			}),
+		}
+	}
+	ctx, err := srtp.CreateContext(k.master[:srtpKeyLen], k.master[srtpKeyLen:], k.suite.profile(), opts...)
+	if err != nil {
+		return nil, err
+	}
+	c.ctx = ctx
+	return c, nil
+}
+
+// classifyRTP rozliší RTP a RTCP na jednom portu (RFC 5761 4); ok=false
+// pro cokoli jiného.
+func classifyRTP(pkt []byte) (isRTCP, ok bool) {
+	if len(pkt) < 8 || pkt[0]>>6 != 2 {
+		return false, false
+	}
+	if pkt[1] >= 192 && pkt[1] <= 223 {
+		return true, true
+	}
+	return false, len(pkt) >= 12
+}
+
+// openResult říká, co se stalo s paketem od volací knihovny.
+type openResult int
+
+const (
+	openOK     openResult = iota
+	openSwitch            // v pořádku, knihovna přešla na nový klíč
+	openRepeat
+	openNoKey
+	openAuthFail
+	openReplay
+	openMalformed
+)
+
+// srtpRecv ověřuje a dešifruje pakety volací knihovny.
+type srtpRecv struct {
+	mu   sync.Mutex
+	cur  *srtpCtx // platný klíč
+	next *srtpCtx // nový klíč z SDP, dokud ho knihovna nezačne používat
+
+	// Poslední přijatý paket RTP kvůli bezprostřednímu opakování.
+	last, lastPlain []byte
+	lastAt          time.Time
+	repeats         int
+
+	hdr  rtp.Header
+	rhdr rtcp.Header
+}
+
+// setKey převezme klíč volací knihovny z SDP. Stejný klíč kontext
+// nemění; nový čeká jako kandidát, dokud jím knihovna nepodepíše paket
+// (do té doby platí i starý: knihovna přepne až po dokončení výměny SDP,
+// a výměna může i selhat).
+func (r *srtpRecv) setKey(k srtpKey) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	switch {
+	case r.cur != nil && r.cur.key == k:
+		r.next = nil
+		return nil
+	case r.next != nil && r.next.key == k:
+		return nil
+	}
+	c, err := newSRTPCtx(k, true)
+	if err != nil {
+		return err
+	}
+	if r.cur == nil {
+		r.cur = c
+	} else {
+		r.next = c
+	}
+	return nil
+}
+
+func (r *srtpRecv) clear() {
+	r.mu.Lock()
+	r.cur, r.next, r.last, r.lastPlain = nil, nil, nil, nil
+	r.mu.Unlock()
+}
+
+func (r *srtpRecv) hasKey() bool {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.cur != nil
+}
+
+// open ověří a dešifruje paket do dst. rtcpOnly: paket přišel na port
+// RTCP (bez rtcp-mux).
+func (r *srtpRecv) open(dst, pkt []byte, rtcpOnly bool, now time.Time) ([]byte, openResult) {
+	isRTCP, ok := classifyRTP(pkt)
+	if !ok || (rtcpOnly && !isRTCP) {
+		return nil, openMalformed
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.cur == nil {
+		return nil, openNoKey
+	}
+	if !isRTCP && r.last != nil && r.repeats < srtpMaxRepeats && now.Sub(r.lastAt) < srtpRepeatDelay && bytes.Equal(pkt, r.last) {
+		// Bajtově shodný s právě přijatým, tedy ověřeným paketem.
+		r.repeats++
+		return append(dst[:0], r.lastPlain...), openRepeat
+	}
+	out, res := r.try(r.cur, dst, pkt, isRTCP)
+	if res != openOK && r.next != nil {
+		var res2 openResult
+		if out, res2 = r.try(r.next, dst, pkt, isRTCP); res2 == openOK {
+			r.cur, r.next = r.next, nil
+			res = openSwitch
+		} else if res2 == openReplay {
+			res = openReplay
+		}
+	}
+	if res != openOK && res != openSwitch {
+		return nil, res
+	}
+	if !isRTCP {
+		r.last = append(r.last[:0], pkt...)
+		r.lastPlain = append(r.lastPlain[:0], out...)
+		r.lastAt, r.repeats = now, 0
+	}
+	return out, res
+}
+
+func (r *srtpRecv) try(c *srtpCtx, dst, pkt []byte, isRTCP bool) ([]byte, openResult) {
+	c.replay = false
+	var out []byte
+	var err error
+	if isRTCP {
+		out, err = c.ctx.DecryptRTCP(dst, pkt, &r.rhdr)
+	} else {
+		out, err = c.ctx.DecryptRTP(dst, pkt, &r.hdr)
+	}
+	switch {
+	case err == nil:
+		return out, openOK
+	case c.replay:
+		return nil, openReplay
+	case errors.Is(err, srtp.ErrFailedToVerifyAuthTag):
+		return nil, openAuthFail
+	}
+	return nil, openMalformed
+}
+
+// sealResult říká, co se stalo s paketem pro volací knihovnu.
+type sealResult int
+
+const (
+	sealOK     sealResult = iota
+	sealResync            // v pořádku, čísla paketů vyrovnána (seqTrack)
+	sealNoKey
+	sealFail
+)
+
+// seqTrack drží řadu čísel paketů jedné SSRC směrem ke knihovně.
+type seqTrack struct {
+	last, offset uint16
+}
+
+// next vrátí číslo paketu pro knihovnu. Skok zpět o srtpPeerWindow a víc
+// (nebo dopředu o víc než 2^15, což vypadá stejně) by libsrtp ve volací
+// knihovně zahodila jako starý paket a zvuk by do dosažení původního
+// čísla zmlkl. Takový skok relé vyrovná: dál čísluje od posledního čísla.
+func (t *seqTrack) next(seq uint16) (out uint16, resync bool) {
+	out = seq + t.offset
+	d := int16(out - t.last)
+	switch {
+	case d > 0:
+		t.last = out
+	case d <= -srtpPeerWindow:
+		t.offset += t.last + 1 - out
+		out = t.last + 1
+		t.last = out
+		resync = true
+	}
+	return out, resync
+}
+
+// srtpSend šifruje pakety pro volací knihovnu klíčem relé.
+type srtpSend struct {
+	mu   sync.Mutex
+	cur  *srtpCtx
+	seq  map[uint32]*seqTrack
+	hdr  rtp.Header
+	rhdr rtcp.Header
+}
+
+// setKey nastaví klíč relé, který knihovna dostala v SDP. Stejný klíč
+// kontext ponechá (knihovna ho také ponechá), nový začne od nuly.
+func (s *srtpSend) setKey(k srtpKey) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.cur != nil && s.cur.key == k {
+		return nil
+	}
+	c, err := newSRTPCtx(k, false)
+	if err != nil {
+		return err
+	}
+	s.cur, s.seq = c, nil
+	return nil
+}
+
+func (s *srtpSend) clear() {
+	s.mu.Lock()
+	s.cur, s.seq = nil, nil
+	s.mu.Unlock()
+}
+
+func (s *srtpSend) key() (srtpKey, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.cur == nil {
+		return srtpKey{}, false
+	}
+	return s.cur.key, true
+}
+
+// seal zašifruje paket (pkt se smí změnit) do dst.
+func (s *srtpSend) seal(dst, pkt []byte, rtcpOnly bool) ([]byte, sealResult) {
+	isRTCP, ok := classifyRTP(pkt)
+	if !ok || (rtcpOnly && !isRTCP) {
+		return nil, sealFail
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.cur == nil {
+		return nil, sealNoKey
+	}
+	var out []byte
+	var err error
+	res := sealOK
+	if isRTCP {
+		out, err = s.cur.ctx.EncryptRTCP(dst, pkt, &s.rhdr)
+	} else {
+		ssrc := uint32(pkt[8])<<24 | uint32(pkt[9])<<16 | uint32(pkt[10])<<8 | uint32(pkt[11])
+		seq := uint16(pkt[2])<<8 | uint16(pkt[3])
+		t := s.seq[ssrc]
+		if t == nil {
+			if s.seq == nil || len(s.seq) >= maxTrackedSSRC {
+				s.seq = make(map[uint32]*seqTrack)
+			}
+			t = &seqTrack{last: seq}
+			s.seq[ssrc] = t
+		}
+		n, resync := t.next(seq)
+		if resync {
+			res = sealResync
+		}
+		pkt[2], pkt[3] = byte(n>>8), byte(n)
+		out, err = s.cur.ctx.EncryptRTP(dst, pkt, &s.hdr)
+	}
+	if err != nil {
+		return nil, sealFail
+	}
+	return out, res
+}
