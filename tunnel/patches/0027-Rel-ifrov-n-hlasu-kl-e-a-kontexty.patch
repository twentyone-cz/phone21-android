+
+func TestParseCrypto(t *testing.T) {
+	for _, v := range []string{
+		"1 AES_CM_128_HMAC_SHA1_80 inline:" + testKey1,
+		"7 AES_CM_128_HMAC_SHA1_32 inline:" + testKey1 + "|2^31",
+		"2 AES_CM_128_HMAC_SHA1_80 inline:" + testKey1 + " WSH=64",
+		"3 AES_CM_128_HMAC_SHA1_80 inline:" + testKey1 + " KDR=0",
+	} {
+		c, ok := parseCrypto(v)
+		if !ok {
+			t.Errorf("rejected %q", v)
+			continue
+		}
+		if c.key.master[0] != 0 || c.key.master[29] != 29 {
+			t.Errorf("%q: key not decoded", v)
+		}
+	}
+	for _, v := range []string{
+		"1 AES_256_CM_HMAC_SHA1_80 inline:" + testKey1,                         // nepodporovaná sada
+		"1 AES_CM_128_HMAC_SHA1_80 inline:" + testKey1 + "|2^20|1:4",           // MKI
+		"1 AES_CM_128_HMAC_SHA1_80 inline:" + testKey1 + ";inline:" + testKey2, // víc klíčů
+		"1 AES_CM_128_HMAC_SHA1_80 inline:" + testKey1 + " UNENCRYPTED_SRTP",
+		"1 AES_CM_128_HMAC_SHA1_80 inline:" + testKey1 + " UNENCRYPTED_SRTCP",
+		"1 AES_CM_128_HMAC_SHA1_80 inline:" + testKey1 + " UNAUTHENTICATED_SRTP",
+		"1 AES_CM_128_HMAC_SHA1_80 inline:" + testKey1 + " KDR=1",
+		"1 AES_CM_128_HMAC_SHA1_80 inline:AAEC",                 // krátký klíč
+		"1 AES_CM_128_HMAC_SHA1_80 inline:" + testKey1 + "AAAA", // dlouhý klíč
+		"1 AES_CM_128_HMAC_SHA1_80 inline:!!!",
+		"1 AES_CM_128_HMAC_SHA1_80 " + testKey1,
+		"x AES_CM_128_HMAC_SHA1_80 inline:" + testKey1,
+		"1 AES_CM_128_HMAC_SHA1_80",
+	} {
+		if _, ok := parseCrypto(v); ok {
+			t.Errorf("accepted %q", v)
+		}
+	}
+	c, ok := firstSupportedCrypto([]string{
+		"1 AES_256_CM_HMAC_SHA1_80 inline:" + testKey1,
+		"2 AES_CM_128_HMAC_SHA1_32 inline:" + testKey2,
+		"3 AES_CM_128_HMAC_SHA1_80 inline:" + testKey1,
+	})
+	if !ok || c.tag != 2 || c.key.suite != suite32 {
+		t.Fatalf("first supported: %+v %v", c, ok)
+	}
+	// Formát řádku relé přečte i druhá strana.
+	k := newRelayKey(suite32)
+	back, ok := parseCrypto(cryptoLine{tag: 5, key: k}.String())
+	if !ok || back.tag != 5 || back.key != k {
+		t.Fatal("own line does not parse back")
+	}
+}
+
+func TestSeqTrack(t *testing.T) {
+	tr := &seqTrack{last: 100}
+	for _, c := range []struct {
+		in, want uint16
+		resync   bool
+	}{
+		{100, 100, false},
+		{101, 101, false},
+		{99, 99, false},       // pozdní paket v okně knihovny
+		{110, 110, false},     // malá mezera
+		{12000, 12000, false}, // skok dopředu do 2^15
+		{11000, 12001, true},  // skok zpět za okno: navázat
+		{11001, 12002, false},
+		{11001 + 40000, 12003, true}, // skok dopředu přes 2^15 vypadá jako zpět
+		{51002, 12004, false},
+		{51000, 12002, false}, // zpět v okně: beze změny vůči posunu
+	} {
+		got, resync := tr.next(c.in)
+		if got != c.want || resync != c.resync {
+			t.Fatalf("next(%d) = %d,%v; want %d,%v", c.in, got, resync, c.want, c.resync)
+		}
+	}
+	// Přetečení čísel je běžný posun dopředu.
+	tr = &seqTrack{last: 65535}
+	if got, resync := tr.next(0); got != 0 || resync {
+		t.Fatalf("wrap: %d %v", got, resync)
+	}
+}
+
+func testKey(t *testing.T, b64 string, s srtpSuite) srtpKey {
+	t.Helper()
+	c, ok := parseCrypto("1 " + s.String() + " inline:" + b64)
+	if !ok {
+		t.Fatal("bad test key")
+	}
+	return c.key
+}
+
+func pionCtx(t *testing.T, k srtpKey, opts ...srtp.ContextOption) *srtp.Context {
+	t.Helper()
+	c, err := srtp.CreateContext(k.master[:16], k.master[16:], k.suite.profile(), opts...)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return c
+}
+
+func TestSRTPRecv(t *testing.T) {
+	var r srtpRecv
+	now := time.Now()
+	k1, k2 := testKey(t, testKey1, suite80), testKey(t, testKey2, suite32)
+	if _, res := r.open(nil, rtpPkt(1, 1, 1, "x"), false, now); res != openNoKey {
+		t.Fatalf("without key: %v", res)
+	}
+	if err := r.setKey(k1); err != nil {
+		t.Fatal(err)
+	}
+	enc1 := pionCtx(t, k1)
+	seal := func(c *srtp.Context, seq uint16, payload string) []byte {
+		b, err := c.EncryptRTP(nil, rtpPkt(5, seq, uint32(seq)*160, payload), nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return b
+	}
+	open := func(pkt []byte, want openResult) []byte {
+		t.Helper()
+		out, res := r.open(make([]byte, 0, 2048), pkt, false, now)
+		if res != want {
+			t.Fatalf("open: %v, want %v", res, want)
+		}
+		return out
+	}
+	p1, p2 := seal(enc1, 10, "one"), seal(enc1, 11, "two")
+	if got := open(p1, openOK); !bytes.Equal(got, rtpPkt(5, 10, 1600, "one")) {
+		t.Fatalf("plain %x", got)
+	}
+	// Bezprostřední opakování (konec tónové volby) projde nejvýš dvakrát.
+	open(p1, openRepeat)
+	open(p1, openRepeat)
+	open(p1, openReplay)
+	open(p2, openOK)
+	open(p1, openReplay) // staré opakování
+	open(rtpPkt(5, 12, 0, "plain-packet-payload"), openAuthFail)
+	bad := seal(enc1, 13, "bad")
+	bad[len(bad)-1] ^= 1
+	open(bad, openAuthFail)
+	open([]byte("junk-not-rtp"), openMalformed)
+	open(seal(pionCtx(t, testKey(t, testKey2, suite80)), 14, "other key"), openAuthFail)
+
+	// RTCP na samostatném portu, a paket RTP tam nepatří.
+	rtcpPlain := rtcpPkt(5, "report-with-enough-bytes")
+	rtcpSealed, err := enc1.EncryptRTCP(nil, rtcpPlain, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out, res := r.open(nil, rtcpSealed, true, now); res != openOK || !bytes.Equal(out, rtcpPlain) {
+		t.Fatalf("rtcp: %v %x", res, out)
+	}
+	if _, res := r.open(nil, rtcpSealed, true, now); res != openReplay {
+		t.Fatalf("rtcp replay: %v", res)
+	}
+	if _, res := r.open(nil, seal(enc1, 15, "rtp"), true, now); res != openMalformed {
+		t.Fatalf("rtp on rtcp port: %v", res)
+	}
+	if _, res := r.open(nil, rtcpPlain, true, now); res != openAuthFail {
+		t.Fatalf("plain rtcp: %v", res)
+	}
+
+	// Nový klíč: starý platí, dokud knihovna nepošle paket novým.
+	if err := r.setKey(k2); err != nil {
+		t.Fatal(err)
+	}
+	open(seal(enc1, 16, "old key still"), openOK)
+	enc2 := pionCtx(t, k2)
+	open(seal(enc2, 17, "new key"), openSwitch)
+	open(seal(enc1, 18, "old key again"), openAuthFail)
+	open(seal(enc2, 19, "new key"), openOK)
+	// Stejný klíč znovu: beze změny (okno proti opakování zůstává).
+	p20 := seal(enc2, 20, "x")
+	open(p20, openOK)
+	r.setKey(k2)
+	open(seal(enc2, 21, "y"), openOK)
+	open(p20, openReplay)
+}
+
+// Při stejném klíči zůstává kontext relé (počítadlo přetečení), stejně
+// jako ve volací knihovně; nový klíč začíná od nuly.
+func TestSRTPSendKeepsContext(t *testing.T) {
+	var s srtpSend
+	k1, k2 := testKey(t, testKey1, suite80), testKey(t, testKey2, suite80)
+	if _, res := s.seal(nil, rtpPkt(1, 1, 1, "x"), false); res != sealNoKey {
+		t.Fatalf("without key: %v", res)
+	}
+	s.setKey(k1)
+	dec := pionCtx(t, k1, srtp.SRTPReplayProtection(128))
+	send := func(seq uint16) {
+		t.Helper()
+		out, res := s.seal(nil, rtpPkt(9, seq, 0, "p"), false)
+		if res != sealOK {
+			t.Fatalf("seal %d: %v", seq, res)
+		}
+		if _, err := dec.DecryptRTP(nil, out, nil); err != nil {
+			t.Fatalf("decrypt %d: %v", seq, err)
+		}
+	}
+	for _, seq := range []uint16{65533, 65534, 65535, 0, 1} { // přetečení
+		send(seq)
+	}
+	s.setKey(k1) // re-INVITE se stejným klíčem
+	send(2)
+	if roc, _ := s.cur.ctx.ROC(9); roc != 1 {
+		t.Fatalf("ROC %d after re-INVITE", roc)
+	}
+	s.setKey(k2)
+	dec = pionCtx(t, k2, srtp.SRTPReplayProtection(128))
+	send(3)
+	if roc, _ := s.cur.ctx.ROC(9); roc != 0 {
+		t.Fatalf("ROC %d with a new key", roc)
+	}
+	if _, res := s.seal(nil, []byte("junk-not-rtp"), false); res != sealFail {
+		t.Fatalf("junk: %v", res)
+	}
+}
+
+// ---- pakety ----
+
+func rtpPkt(ssrc uint32, seq uint16, ts uint32, payload string) []byte {
+	b := make([]byte, 12, 12+len(payload))
+	b[0], b[1] = 0x80, 0 // V=2, PCMU
+	binary.BigEndian.PutUint16(b[2:], seq)
+	binary.BigEndian.PutUint32(b[4:], ts)
+	binary.BigEndian.PutUint32(b[8:], ssrc)
+	return append(b, payload...)
+}
+
+// rtcpPkt je RR bez bloků s profilovým rozšířením (payload, doplněno na 4).
+func rtcpPkt(ssrc uint32, payload string) []byte {
+	p := []byte(payload)
+	for len(p)%4 != 0 {
+		p = append(p, 0)
+	}
+	b := make([]byte, 8, 8+len(p))
+	b[0], b[1] = 0x80, 201
+	binary.BigEndian.PutUint16(b[2:], uint16((8+len(p))/4-1))
+	binary.BigEndian.PutUint32(b[4:], ssrc)
+	return append(b, p...)
+}
