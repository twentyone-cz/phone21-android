+++ b/libtailscale/p21relay/sdp_test.go
@@ -0,0 +1,90 @@
+// Copyright (c) Phone21
+// SPDX-License-Identifier: BSD-3-Clause
+
+package p21relay
+
+import (
+	"net/netip"
+	"strings"
+	"testing"
+)
+
+func TestRewriteSDP(t *testing.T) {
+	in := "v=0\r\n" +
+		"o=test 1 2 IN IP4 192.0.2.10\r\n" +
+		"s=-\r\n" +
+		"c=IN IP4 192.0.2.10\r\n" +
+		"a=ice-ufrag:abcd\r\n" +
+		"t=0 0\r\n" +
+		"m=audio 40000 RTP/AVP 9 0 101\r\n" +
+		"a=rtcp:40001 IN IP4 192.0.2.10\r\n" +
+		"a=candidate:1 1 UDP 1 192.0.2.10 40000 typ host\r\n" +
+		"a=sendrecv\r\n" +
+		"m=video 0 RTP/AVP 96\r\n" +
+		"m=audio 41000 RTP/AVP 0\r\n" +
+		"c=IN IP4 0.0.0.0\r\n" +
+		"a=rtcp:41000\r\n" +
+		"a=rtcp-mux\r\n" +
+		"m=text 42000/2 RTP/AVP 98\r\n" +
+		"c=IN IP6 2001:db8::1\r\n"
+	var got []sdpStream
+	out, err := rewriteSDP([]byte(in), netip.MustParseAddr("100.64.0.4"), func(s sdpStream) (int, int, bool) {
+		got = append(got, s)
+		switch s.index {
+		case 0:
+			return 30000, 30001, true
+		case 2:
+			return 30010, 30010, true
+		}
+		return 0, 0, false
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "v=0\r\n" +
+		"o=test 1 2 IN IP4 100.64.0.4\r\n" +
+		"s=-\r\n" +
+		"c=IN IP4 100.64.0.4\r\n" +
+		"t=0 0\r\n" +
+		"m=audio 30000 RTP/AVP 9 0 101\r\n" +
+		"a=rtcp:30001 IN IP4 100.64.0.4\r\n" +
+		"a=sendrecv\r\n" +
+		"m=video 0 RTP/AVP 96\r\n" +
+		"m=audio 30010 RTP/AVP 0\r\n" +
+		"c=IN IP4 0.0.0.0\r\n" +
+		"a=rtcp:30010\r\n" +
+		"a=rtcp-mux\r\n" +
+		"m=text 0/2 RTP/AVP 98\r\n" +
+		"c=IN IP4 100.64.0.4\r\n"
+	if string(out) != want {
+		t.Fatalf("got:\n%s\nwant:\n%s", out, want)
+	}
+	if len(got) != 3 {
+		t.Fatalf("alloc calls %+v", got)
+	}
+	if got[0] != (sdpStream{index: 0, port: 40000, rtcpPort: 40001}) {
+		t.Fatalf("stream 0 %+v", got[0])
+	}
+	if got[1] != (sdpStream{index: 2, port: 41000, rtcpPort: 41000, held: true}) {
+		t.Fatalf("stream 2 %+v", got[1])
+	}
+	if got[2].index != 3 || got[2].port != 42000 || got[2].held {
+		t.Fatalf("stream 3 %+v", got[2])
+	}
+}
+
+func TestRewriteSDPLineEndingsAndErrors(t *testing.T) {
+	out, err := rewriteSDP([]byte("v=0\nc=IN IP4 192.0.2.1\nm=audio 5000 RTP/AVP 0\n"), loopback4,
+		func(sdpStream) (int, int, bool) { return 6000, 6001, true })
+	if err != nil || string(out) != "v=0\nc=IN IP4 127.0.0.1\nm=audio 6000 RTP/AVP 0\n" {
+		t.Fatalf("%q %v", out, err)
+	}
+	for _, bad := range []string{"x=1\r\n", "v=0\r\nm=audio\r\n", "v=0\r\nm=audio x RTP/AVP 0\r\n", "v=0\r\nm=audio 1 RTP/AVP 0\r\na=rtcp:\r\n"} {
+		if _, err := rewriteSDP([]byte(bad), loopback4, func(sdpStream) (int, int, bool) { return 1, 2, true }); err == nil {
+			t.Errorf("accepted %q", bad)
+		}
+	}
+	if strings.Contains(string(out), "\r") {
+		t.Fatal("CR added")
+	}
+}
diff --git a/libtailscale/p21relay/stats.go b/libtailscale/p21relay/stats.go
new file mode 100644
index 0000000..de2acde
--- /dev/null
+++ b/libtailscale/p21relay/stats.go
@@ -0,0 +1,109 @@
+// Copyright (c) Phone21
+// SPDX-License-Identifier: BSD-3-Clause
+
+package p21relay
+
+import (
+	"context"
+	"errors"
+	"net"
+	"os"
+	"sync"
+	"syscall"
+	"time"
+)
+
+// counters is a set of named counters for Stats(); names never contain
+// personal data. Hot paths (media packets) use atomics elsewhere.
+type counters struct {
+	mu sync.Mutex
+	m  map[string]int64
+}
+
+func (c *counters) add(name string, n int64) {
+	c.mu.Lock()
+	if c.m == nil {
+		c.m = make(map[string]int64)
+	}
+	c.m[name] += n
+	c.mu.Unlock()
+}
+
+func (c *counters) inc(name string) { c.add(name, 1) }
+
+func (c *counters) get(name string) int64 {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.m[name]
+}
+
+func (c *counters) snapshot() map[string]int64 {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	out := make(map[string]int64, len(c.m))
+	for k, v := range c.m {
+		out[k] = v
+	}
+	return out
+}
+
+// rateLog forwards to Logf at most once per interval per key.
+type rateLog struct {
+	logf     func(format string, args ...any)
+	interval time.Duration
+	mu       sync.Mutex
+	last     map[string]time.Time
+}
+
+func (l *rateLog) printf(key, format string, args ...any) {
+	if l.logf == nil {
+		return
+	}
+	now := time.Now()
+	l.mu.Lock()
+	if l.last == nil {
+		l.last = make(map[string]time.Time)
+	}
+	if t, ok := l.last[key]; ok && now.Sub(t) < l.interval {
+		l.mu.Unlock()
+		return
+	}
+	l.last[key] = now
+	l.mu.Unlock()
+	l.logf(format, args...)
+}
+
+// fixedErr is an error whose text is safe to log as is.
+type fixedErr string
+
+func (e fixedErr) Error() string { return string(e) }
+
+// errClass reduces an error to a fixed word, so that no address, path or
+// other detail of a request ends up in the log.
+func errClass(err error) string {
+	var (
+		ne net.Error
+		fe fixedErr
+	)
+	switch {
+	case err == nil:
+		return "ok"
+	case errors.Is(err, context.Canceled):
+		return "canceled"
+	case errors.Is(err, context.DeadlineExceeded), errors.Is(err, os.ErrDeadlineExceeded):
+		return "timeout"
+	case errors.As(err, &fe):
+		return string(fe)
+	case errors.Is(err, net.ErrClosed):
+		return "closed"
+	case errors.Is(err, syscall.ECONNREFUSED):
+		return "refused"
+	case errors.Is(err, syscall.ECONNRESET):
+		return "reset"
+	case errors.Is(err, syscall.EHOSTUNREACH), errors.Is(err, syscall.ENETUNREACH):
+		return "unreachable"
+	case errors.As(err, &ne) && ne.Timeout():
+		return "timeout"
+	}
+	return "error"
+}
diff --git a/libtailscale/p21relay/stats_test.go b/libtailscale/p21relay/stats_test.go
new file mode 100644
index 0000000..3a6eb68
--- /dev/null
+++ b/libtailscale/p21relay/stats_test.go
@@ -0,0 +1,37 @@
+// Copyright (c) Phone21
+// SPDX-License-Identifier: BSD-3-Clause
+
+package p21relay
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+)
+
+func TestRateLog(t *testing.T) {
+	n := 0
+	l := &rateLog{logf: func(string, ...any) { n++ }, interval: time.Hour}
+	l.printf("a", "x")
+	l.printf("a", "x")
+	l.printf("b", "x")
+	if n != 2 {
+		t.Fatalf("logged %d", n)
+	}
+	(&rateLog{}).printf("a", "nil logf must not panic")
+}
+
+func TestErrClass(t *testing.T) {
+	for err, want := range map[error]string{
+		nil:                      "ok",
+		context.Canceled:         "canceled",
+		context.DeadlineExceeded: "timeout",
+		fmt.Errorf("dial sip:test@127.0.0.1/secret: %w", fixedErr("no free media port pair")): "no free media port pair",
+		fmt.Errorf("GET /contacts/person.vcf failed"):                                         "error",
+	} {
+		if got := errClass(err); got != want {
+			t.Errorf("%v: %q, want %q", err, got, want)
+		}
+	}
+}
