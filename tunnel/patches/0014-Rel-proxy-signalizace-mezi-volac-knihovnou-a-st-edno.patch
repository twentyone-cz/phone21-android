+	e.up.sendUDP(e.privSIP(), inv)
+	ci := c.expectRequest("INVITE")
+	if _, p := sdpMedia(t, ci.body); p != cl.relayC {
+		t.Fatalf("upstream re-INVITE moved the stream %d -> %d", cl.relayC, p)
