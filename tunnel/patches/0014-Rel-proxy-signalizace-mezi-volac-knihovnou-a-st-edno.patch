+	c.send(responseText(ci, 200, "OK", "c1", []string{"Contact: <" + c.contact() + ">"}, sdpBody("127.0.0.1", cl.cli.port)))
+	e.up.expectResponse(200, "INVITE")
+	e.up.sendUDP(e.privSIP(), upRequest(e, "ACK", cl.callID, 300, "c1"))
+	c.expectRequest("ACK")
+	cl.up = newUp
+	cl.checkMedia(t, "resumed")
+	if e.mediaStat("streams") != 1 {
+		t.Fatalf("streams %d", e.mediaStat("streams"))
+	}
+}
