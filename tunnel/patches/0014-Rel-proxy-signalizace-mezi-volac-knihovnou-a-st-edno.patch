+// establishOutgoing runs a full outgoing call setup incl. early media.
+func establishOutgoing(t *testing.T, e *testEnv, c *fakeClient) *call {
+	t.Helper()
+	cl := startOutgoing(t, e, c)
+	e.up.reply(cl.upInvite, 100, "Trying", nil, "")
+	c.expectResponse(100, "INVITE")
+	e.up.reply(cl.upInvite, 180, "Ringing", []string{cl.upContact(e)}, "")
+	r180 := c.expectResponse(180, "INVITE")
+	if want := fmt.Sprintf("<sip:127.0.0.1:%d;transport=tls>", e.info.SIPPort); r180.get("contact") != want {
+		t.Fatalf("180 Contact %q, want %q", r180.get("contact"), want)
+	}
+
+	e.up.reply(cl.upInvite, 183, "Session Progress", []string{cl.upContact(e)}, sdpBody(upIP.String(), cl.up.port))
+	r183 := c.expectResponse(183, "INVITE")
+	addr, port := sdpMedia(t, r183.body)
+	if addr != "127.0.0.1" || port%2 != 0 {
+		t.Fatalf("183 SDP not anchored: %s:%d", addr, port)
+	}
+	cl.relayC = port
+
+	// Early media, both directions, RTP and RTCP, before the 200.
+	expectPacket(t, cl.up.rtp, cl.relayPrivRTP(), cl.cli.rtp, cl.relayClientRTP(), "early-rtp-down")
+	expectPacket(t, cl.up.rtcp, cl.relayPrivRTCP(), cl.cli.rtcp, cl.relayClientRTCP(), "early-rtcp-down")
+	expectPacket(t, cl.cli.rtp, cl.relayClientRTP(), cl.up.rtp, cl.relayPrivRTP(), "early-rtp-up")
+	expectPacket(t, cl.cli.rtcp, cl.relayClientRTCP(), cl.up.rtcp, cl.relayPrivRTCP(), "early-rtcp-up")
+
+	e.up.reply(cl.upInvite, 200, "OK", []string{cl.upContact(e)}, sdpBody(upIP.String(), cl.up.port))
