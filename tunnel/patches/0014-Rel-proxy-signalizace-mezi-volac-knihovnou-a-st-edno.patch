+func TestCancel(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+	cl := startOutgoing(t, e, c)
+	e.up.reply(cl.upInvite, 100, "Trying", nil, "")
+	e.up.reply(cl.upInvite, 180, "Ringing", []string{cl.upContact(e)}, "")
+	c.expectResponse(100, "INVITE")
+	c.expectResponse(180, "INVITE")
+	if e.mediaStat("streams") != 1 {
+		t.Fatal("no stream while ringing")
+	}
+
+	inviteRURI := "sip:" + testNumber + "@" + upIP.String()
+	cancelHdrs := cl.clientHeaders(c, cl.branch, cl.cseq, "CANCEL", false)
+	c.send(requestText("CANCEL", inviteRURI, append(cancelHdrs[:len(cancelHdrs)-1], e.relayRoute()), ""))
+	uc := e.up.expectRequest("CANCEL")
+	invBranch := topVia(t, cl.upInvite.m).branch()
+	if topVia(t, uc.m).branch() != invBranch {
+		t.Fatal("CANCEL branch differs from INVITE branch")
+	}
+	e.up.reply(uc, 200, "OK", nil, "")
+	e.up.reply(cl.upInvite, 487, "Request Terminated", nil, "")
+	c.expectResponse(200, "CANCEL")
+	c.expectResponse(487, "INVITE")
+	waitFor(t, func() bool { return e.mediaStat("streams") == 0 })
+
+	ackHdrs := cl.clientHeaders(c, cl.branch, cl.cseq, "ACK", true)
+	c.send(requestText("ACK", inviteRURI, append(ackHdrs[:len(ackHdrs)-1], e.relayRoute()), ""))
+	ua := e.up.expectRequest("ACK")
+	if topVia(t, ua.m).branch() != invBranch {
+		t.Fatal("non-2xx ACK branch differs from INVITE branch")
+	}
+
+	// The ACK got lost: the miniserver repeats the 487. The relay answers it
+	// with the stored ACK and does not bother the calling library.
+	e.up.reply(cl.upInvite, 487, "Request Terminated", nil, "")
+	waitFor(t, func() bool { return e.counter("sip.ack_repeated") == 1 })
+	c.expectNothing()
+}
