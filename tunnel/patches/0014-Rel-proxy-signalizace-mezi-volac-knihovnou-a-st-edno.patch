@@ -7,13 +7,26 @@
 // private-network interface. Nothing here may become reachable for other
 // apps on the phone: SIP is TLS with a pinned client certificate, RTP is
 // accepted only from the calling library's own ports, HTTP needs a token.
+//
+// The relay never opens sockets outside 127.0.0.1 and the Network it is
+// given, so in this mode no traffic bypasses another VPN on the phone.
 package p21relay
 
 import (
+	"bytes"
 	"context"
+	"crypto/rand"
+	"crypto/subtle"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"encoding/pem"
 	"errors"
+	"fmt"
 	"net"
 	"net/netip"
+	"sync"
+	"time"
 )
 
 // Network is the private-network side (in-process interface of the tunnel).
@@ -40,6 +53,14 @@ type Config struct {
 	ClientCertPEM []byte
 	// Logf receives diagnostics; must never get SIP bodies, numbers or tokens.
 	Logf func(format string, args ...any)
+
+	// SIPPort and HTTPPort are preferred ports on 127.0.0.1 (0 = any).
+	// When taken, a free port is used instead; Info tells which.
+	SIPPort, HTTPPort int
+	// PrivateSIPPort is the preferred UDP/TCP port on the private address
+	// (0 = any). Keeping it across restarts keeps the miniserver's
+	// registration binding valid.
