+// Copyright (c) Phone21
+// SPDX-License-Identifier: BSD-3-Clause
+
+package p21relay
+
+import (
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/json"
+	"encoding/pem"
+	"fmt"
+	"math/big"
+	"net"
+	"net/netip"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// Synthetic test identities only.
+const (
+	testUser   = "test"
+	testNumber = "+420000000000"
+)
+
+// ---- certificates ----
+
+type testCert struct {
+	certPEM, keyPEM []byte
+	tls             tls.Certificate
+}
+
+func makeCert(t *testing.T, cn string) testCert {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tmpl := &x509.Certificate{
+		SerialNumber: big.NewInt(time.Now().UnixNano()),
+		Subject:      pkix.Name{CommonName: cn},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+		IPAddresses:  []net.IP{net.IPv4(127, 0, 0, 1)},
+		KeyUsage:     x509.KeyUsageDigitalSignature,
+		ExtKeyUsage:  []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth, x509.ExtKeyUsageClientAuth},
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	kb, err := x509.MarshalECPrivateKey(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := testCert{
+		certPEM: pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}),
+		keyPEM:  pem.EncodeToMemory(&pem.Block{Type: "EC PRIVATE KEY", Bytes: kb}),
+	}
+	if c.tls, err = tls.X509KeyPair(c.certPEM, c.keyPEM); err != nil {
+		t.Fatal(err)
+	}
+	return c
+}
+
+// ---- log capture ----
+
+type logBuf struct {
+	mu sync.Mutex
+	b  strings.Builder
+}
+
+func (l *logBuf) logf(format string, args ...any) {
+	l.mu.Lock()
+	fmt.Fprintf(&l.b, format+"\n", args...)
+	l.mu.Unlock()
+}
+
+func (l *logBuf) String() string {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.b.String()
+}
+
+// ---- the fake miniserver ----
+
+type upMsg struct {
+	m    *sipMsg
+	raw  []byte
+	src  netip.AddrPort
+	conn net.Conn // nil: UDP
+}
+
+type fakeUpstream struct {
+	t    *testing.T
+	udp  *net.UDPConn
+	ln   net.Listener
+	addr netip.AddrPort
+	in   chan upMsg
+	mu   sync.Mutex
+	seen map[string]bool
+	dups int
+}
+
+func newFakeUpstream(t *testing.T) *fakeUpstream {
+	t.Helper()
+	u := &fakeUpstream{t: t, in: make(chan upMsg, 64), seen: make(map[string]bool)}
+	for _, port := range []int{5060, 0, 0, 0} {
+		udp, err := net.ListenUDP("udp4", &net.UDPAddr{IP: upIP.AsSlice(), Port: port})
+		if err != nil {
+			continue
+		}
+		p := udp.LocalAddr().(*net.UDPAddr).Port
+		ln, err := net.Listen("tcp4", netip.AddrPortFrom(upIP, uint16(p)).String())
+		if err != nil {
+			udp.Close()
+			continue
+		}
+		u.udp, u.ln, u.addr = udp, ln, netip.AddrPortFrom(upIP, uint16(p))
+		break
+	}
+	if u.udp == nil {
+		t.Fatal("cannot bind fake miniserver")
+	}
+	t.Cleanup(func() { u.udp.Close(); u.ln.Close() })
+	go func() {
+		buf := make([]byte, 65536)
+		for {
+			n, a, err := u.udp.ReadFromUDPAddrPort(buf)
+			if err != nil {
+				return
+			}
+			u.deliver(append([]byte(nil), buf[:n]...), a, nil)
+		}
+	}()
+	go func() {
+		for {
+			c, err := u.ln.Accept()
+			if err != nil {
+				return
+			}
+			go u.readStream(c)
+		}
+	}()
+	return u
+}
+
+func (u *fakeUpstream) readStream(c net.Conn) {
+	r := newSIPStreamReader(c)
+	src := addrPortOf(c.RemoteAddr())
+	for {
+		msg, ping, err := r.next()
+		if err != nil {
+			return
+		}
+		if !ping {
+			u.deliver(msg, src, c)
+		}
+	}
+}
+
+func (u *fakeUpstream) deliver(raw []byte, src netip.AddrPort, c net.Conn) {
+	m, err := parseSIP(raw)
+	if err != nil {
+		u.t.Errorf("miniserver got unparsable message: %v\n%s", err, raw)
+		return
+	}
+	u.in <- upMsg{m: m, raw: raw, src: netip.AddrPortFrom(src.Addr().Unmap(), src.Port()), conn: c}
+}
+
+// recv returns the next message that is not an exact retransmission.
+func (u *fakeUpstream) recv() upMsg {
+	u.t.Helper()
+	deadline := time.After(waitLong)
+	for {
+		select {
+		case m := <-u.in:
+			u.mu.Lock()
+			dup := u.seen[string(m.raw)]
+			u.seen[string(m.raw)] = true
+			if dup {
+				u.dups++
+			}
+			u.mu.Unlock()
+			if dup {
+				continue
+			}
+			return m
+		case <-deadline:
+			u.t.Fatal("miniserver: timeout waiting for a message")
+			return upMsg{}
+		}
+	}
+}
+
+func (u *fakeUpstream) expectRequest(method string) upMsg {
+	u.t.Helper()
+	m := u.recv()
+	if !m.m.isReq || m.m.method != method {
+		u.t.Fatalf("miniserver: want %s, got:\n%s", method, m.raw)
+	}
+	return m
+}
+
+func (u *fakeUpstream) expectResponse(status int, method string) upMsg {
+	u.t.Helper()
+	m := u.recv()
+	_, cm, _ := m.m.cseq()
+	if m.m.isReq || m.m.status != status || cm != method {
+		u.t.Fatalf("miniserver: want %d %s, got:\n%s", status, method, m.raw)
+	}
+	return m
+}
+
+func (u *fakeUpstream) expectNothing() {
+	u.t.Helper()
+	select {
+	case m := <-u.in:
+		u.mu.Lock()
+		dup := u.seen[string(m.raw)]
+		u.mu.Unlock()
+		if !dup {
+			u.t.Fatalf("miniserver: unexpected message:\n%s", m.raw)
+		}
+	case <-time.After(waitShort):
+	}
+}
+
+// reply answers a request the way the miniserver does: over the same TCP
+// connection, or over UDP to the packet's source (rport).
+func (u *fakeUpstream) reply(req upMsg, status int, reason string, extra []string, body string) {
+	u.t.Helper()
+	u.sendTo(req, responseText(req.m, status, reason, "up-tag", extra, body))
+}
+
+func (u *fakeUpstream) sendTo(req upMsg, s string) {
+	u.t.Helper()
+	if req.conn != nil {
+		if _, err := req.conn.Write([]byte(s)); err != nil {
+			u.t.Fatal(err)
+		}
+		return
+	}
+	if _, err := u.udp.WriteToUDPAddrPort([]byte(s), req.src); err != nil {
+		u.t.Fatal(err)
+	}
+}
+
+func (u *fakeUpstream) sendUDP(to netip.AddrPort, s string) {
+	u.t.Helper()
+	if _, err := u.udp.WriteToUDPAddrPort([]byte(s), to); err != nil {
+		u.t.Fatal(err)
+	}
+}
+
+// dialTCP opens a connection from the miniserver to the phone.
+func (u *fakeUpstream) dialTCP(to netip.AddrPort) net.Conn {
+	u.t.Helper()
+	d := net.Dialer{LocalAddr: &net.TCPAddr{IP: upIP.AsSlice()}}
+	c, err := d.Dial("tcp4", to.String())
+	if err != nil {
+		u.t.Fatal(err)
+	}
+	u.t.Cleanup(func() { c.Close() })
+	go u.readStream(c)
+	return c
+}
+
+// ---- the fake calling library ----
+
+type fakeClient struct {
+	t    *testing.T
+	conn *tls.Conn
+	port int
+	in   chan *sipMsg
+	raw  chan []byte
+}
+
+func dialClient(t *testing.T, sipPort int, cert *tls.Certificate) (*tls.Conn, error) {
+	cfg := &tls.Config{InsecureSkipVerify: true, MinVersion: tls.VersionTLS12}
+	if cert != nil {
+		cfg.Certificates = []tls.Certificate{*cert}
+	}
+	c, err := tls.DialWithDialer(&net.Dialer{Timeout: waitLong}, "tcp4", "127.0.0.1:"+strconv.Itoa(sipPort), cfg)
+	if err != nil {
+		return nil, err
+	}
+	t.Cleanup(func() { c.Close() })
+	return c, nil
+}
+
+func newFakeClient(t *testing.T, e *testEnv) *fakeClient {
+	t.Helper()
+	conn, err := dialClient(t, e.info.SIPPort, &e.clientCert.tls)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := &fakeClient{t: t, conn: conn, port: conn.LocalAddr().(*net.TCPAddr).Port, in: make(chan *sipMsg, 64), raw: make(chan []byte, 64)}
+	go func() {
+		r := newSIPStreamReader(conn)
+		for {
+			msg, _, err := r.next()
+			if err != nil {
+				close(c.in)
+				return
+			}
+			m, err := parseSIP(msg)
+			if err != nil {
+				t.Errorf("client got unparsable message: %v\n%s", err, msg)
+				continue
+			}
+			c.raw <- msg
+			c.in <- m
+		}
+	}()
+	// The relay registers the connection asynchronously.
+	waitFor(t, func() bool { return e.relay.sip.clientOn.Load() })
+	return c
+}
+
+func (c *fakeClient) send(s string) {
+	c.t.Helper()
+	if _, err := c.conn.Write([]byte(s)); err != nil {
+		c.t.Fatal(err)
+	}
+}
+
+func (c *fakeClient) recv() (*sipMsg, []byte) {
+	c.t.Helper()
+	select {
+	case m, ok := <-c.in:
+		if !ok {
+			c.t.Fatal("client: connection closed")
+		}
+		return m, <-c.raw
+	case <-time.After(waitLong):
+		c.t.Fatal("client: timeout waiting for a message")
+	}
+	return nil, nil
+}
+
+func (c *fakeClient) expectRequest(method string) *sipMsg {
+	c.t.Helper()
+	m, raw := c.recv()
+	if !m.isReq || m.method != method {
+		c.t.Fatalf("client: want %s, got:\n%s", method, raw)
+	}
+	return m
+}
+
+func (c *fakeClient) expectResponse(status int, method string) *sipMsg {
+	c.t.Helper()
+	m, raw := c.recv()
+	_, cm, _ := m.cseq()
+	if m.isReq || m.status != status || cm != method {
+		c.t.Fatalf("client: want %d %s, got:\n%s", status, method, raw)
+	}
+	return m
+}
+
+func (c *fakeClient) expectNothing() {
+	c.t.Helper()
+	select {
+	case m, ok := <-c.in:
+		if ok {
+			<-c.raw
+			c.t.Fatalf("client: unexpected message %+v", m)
+		}
+	case <-time.After(waitShort):
+	}
+}
+
+func (c *fakeClient) via(branch string) string {
+	return fmt.Sprintf("Via: SIP/2.0/TLS 127.0.0.1:%d;branch=%s;rport", c.port, branch)
+}
+
+func (c *fakeClient) contact() string {
+	return fmt.Sprintf("sip:%s@127.0.0.1:%d;transport=tls", testUser, c.port)
+}
+
+// ---- environment ----
+
+type testEnv struct {
+	t          *testing.T
+	relay      *Relay
+	info       Info
+	up         *fakeUpstream
+	serverCert testCert
+	clientCert testCert
+	logs       *logBuf
+	httpHosts  []netip.Addr
+}
+
+func newEnv(t *testing.T, hosts ...netip.Addr) *testEnv {
+	t.Helper()
+	e := &testEnv{t: t, up: newFakeUpstream(t), serverCert: makeCert(t, "relay"), clientCert: makeCert(t, "client"), logs: &logBuf{}}
+	if len(hosts) == 0 {
+		hosts = []netip.Addr{upIP}
+	}
+	cfg := Config{
+		UpstreamSIP:      e.up.addr,
+		HTTPAllowedHosts: hosts,
+		ServerCertPEM:    e.serverCert.certPEM,
+		ServerKeyPEM:     e.serverCert.keyPEM,
+		ClientCertPEM:    e.clientCert.certPEM,
+		Logf:             e.logs.logf,
+	}
+	r, info, err := Start(context.Background(), cfg, fakeNet{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.relay, e.info = r, info
+	t.Cleanup(func() {
+		r.Close()
+		e.checkLogs()
+	})
+	return e
+}
+
+// checkLogs asserts that no personal data or secrets reached the log.
+func (e *testEnv) checkLogs() {
+	l := e.logs.String()
+	for _, bad := range []string{testUser + "@", testNumber, e.info.HTTPToken, "BEGIN", "v=0", "branch="} {
+		if strings.Contains(l, bad) {
+			e.t.Errorf("log contains %q:\n%s", bad, l)
+		}
+	}
+}
+
+func (e *testEnv) privSIP() netip.AddrPort {
+	return netip.AddrPortFrom(privIP, uint16(e.info.PrivateSIPPort))
+}
+
+func (e *testEnv) stats() map[string]any {
+	var m map[string]any
+	if err := json.Unmarshal([]byte(e.relay.Stats()), &m); err != nil {
+		e.t.Fatal(err)
+	}
+	return m
+}
+
+func (e *testEnv) counter(name string) int64 { return e.relay.cnt.get(name) }
+
+func (e *testEnv) mediaStat(name string) int64 {
+	return e.relay.media.stats()[name]
+}
+
+func waitFor(t *testing.T, cond func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(waitLong)
+	for !cond() {
+		if time.Now().After(deadline) {
+			t.Fatal("condition not reached")
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+}
+
+// ---- message helpers ----
+
+var branchSeq struct {
+	sync.Mutex
+	n int
+}
+
+func newBranch() string {
+	branchSeq.Lock()
+	defer branchSeq.Unlock()
+	branchSeq.n++
+	return fmt.Sprintf("z9hG4bKtest%d", branchSeq.n)
+}
+
+func requestText(method, ruri string, hdrs []string, body string) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "%s %s SIP/2.0\r\n", method, ruri)
+	for _, h := range hdrs {
+		b.WriteString(h + "\r\n")
+	}
+	if body != "" {
+		b.WriteString("Content-Type: application/sdp\r\n")
+	}
+	fmt.Fprintf(&b, "Content-Length: %d\r\n\r\n%s", len(body), body)
+	return b.String()
+}
+
+// responseText builds a response the way a UA does: Vias, From, Call-ID,
+// CSeq copied, To tagged.
+func responseText(req *sipMsg, status int, reason, tag string, extra []string, body string) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "SIP/2.0 %d %s\r\n", status, reason)
+	for _, h := range req.hdrs {
+		switch h.key {
+		case "via", "from", "call-id", "cseq":
+			fmt.Fprintf(&b, "%s: %s\r\n", h.name, h.value)
+		case "to":
+			v := h.value
+			if !strings.Contains(v, "tag=") && status > 100 {
+				v += ";tag=" + tag
+			}
+			fmt.Fprintf(&b, "%s: %s\r\n", h.name, v)
+		}
+	}
+	for _, h := range extra {
+		b.WriteString(h + "\r\n")
+	}
+	if body != "" {
+		b.WriteString("Content-Type: application/sdp\r\n")
+	}
+	fmt.Fprintf(&b, "Content-Length: %d\r\n\r\n%s", len(body), body)
+	return b.String()
+}
+
+func sdpBody(addr string, port int, extra ...string) string {
+	s := "v=0\r\no=- 1 1 IN IP4 " + addr + "\r\ns=-\r\nc=IN IP4 " + addr + "\r\nt=0 0\r\n" +
+		"m=audio " + strconv.Itoa(port) + " RTP/AVP 0 101\r\na=rtpmap:101 telephone-event/8000\r\n"
+	for _, x := range extra {
+		s += x + "\r\n"
+	}
+	return s
+}
+
+// sdpMedia returns the c= address and the first m= port of an SDP body.
+func sdpMedia(t *testing.T, body []byte) (string, int) {
+	t.Helper()
+	var addr string
+	port := -1
+	for _, l := range strings.Split(string(body), "\r\n") {
+		if strings.HasPrefix(l, "c=IN IP4 ") && addr == "" {
+			addr = strings.TrimPrefix(l, "c=IN IP4 ")
+		}
+		if strings.HasPrefix(l, "m=") && port < 0 {
+			p, err := strconv.Atoi(strings.Fields(l)[1])
+			if err != nil {
+				t.Fatal(err)
+			}
+			port = p
+		}
+	}
+	if addr == "" || port < 0 {
+		t.Fatalf("no media in SDP:\n%s", body)
+	}
+	return addr, port
+}
+
+func topVia(t *testing.T, m *sipMsg) *sipVia {
+	t.Helper()
+	top, _ := m.topValue("via")
+	v, ok := parseVia(top)
+	if !ok {
+		t.Fatalf("bad top Via %q", top)
+	}
+	return v
+}
