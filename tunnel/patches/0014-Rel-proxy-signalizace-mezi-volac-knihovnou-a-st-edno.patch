+func TestMalformedInput(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+
+	c.send("GARBAGE\r\n\r\n")
+	c.send("OPTIONS sip:x SIP/2.0\r\nVia: SIP/2.0/TLS 127.0.0.1:1;branch=z9hG4bK1\r\nCSeq: 1 OPTIONS\r\nContent-Length: 0\r\n\r\n")
+	waitFor(t, func() bool { return e.counter("sip.drop.client_malformed") == 2 })
+	// A response with a Via that is not the relay's.
+	c.send("SIP/2.0 200 OK\r\nVia: SIP/2.0/UDP 127.0.0.9:5060;branch=z9hG4bKx\r\nFrom: <sip:a@b>;tag=1\r\nTo: <sip:a@b>;tag=2\r\nCall-ID: x\r\nCSeq: 1 OPTIONS\r\nContent-Length: 0\r\n\r\n")
+	waitFor(t, func() bool { return e.counter("sip.drop.via_not_ours") == 1 })
+	// Max-Forwards exhausted.
+	c.send(requestText("OPTIONS", "sip:"+upIP.String(), []string{
+		c.via(newBranch()), "Max-Forwards: 0", "From: <sip:a@b>;tag=1", "To: <sip:a@b>", "Call-ID: mf-" + newBranch(), "CSeq: 1 OPTIONS",
+	}, ""))
+	c.expectResponse(483, "OPTIONS")
+	// Unparsable SDP is refused, not forwarded.
+	c.send(requestText("INVITE", "sip:"+testNumber+"@"+upIP.String(), []string{
+		c.via(newBranch()), "From: <sip:a@b>;tag=1", "To: <sip:a@b>", "Call-ID: sdp-" + newBranch(), "CSeq: 1 INVITE",
+	}, "this is not sdp"))
+	c.expectResponse(488, "INVITE")
+	e.up.expectNothing()
+
+	// From the private side.
+	e.up.sendUDP(e.privSIP(), "NOT SIP AT ALL\r\n\r\n")
+	waitFor(t, func() bool { return e.counter("sip.drop.upstream_malformed") == 1 })
+	e.up.sendUDP(e.privSIP(), "SIP/2.0 200 OK\r\nVia: SIP/2.0/UDP 127.0.0.9:5060;branch=z9hG4bKx\r\nFrom: <sip:a@b>;tag=1\r\nTo: <sip:a@b>;tag=2\r\nCall-ID: x\r\nCSeq: 1 OPTIONS\r\nContent-Length: 0\r\n\r\n")
+	waitFor(t, func() bool { return e.counter("sip.drop.via_not_ours") == 2 })
+
+	// Another peer of the private network is ignored (UDP and TCP).
+	other, err := net.ListenUDP("udp4", &net.UDPAddr{IP: otherIP.AsSlice()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer other.Close()
+	other.WriteToUDPAddrPort([]byte(upRequest(e, "OPTIONS", "f-"+newBranch(), 1, "t")), e.privSIP())
+	waitFor(t, func() bool { return e.counter("sip.drop.foreign_source") == 1 })
+	d := net.Dialer{LocalAddr: &net.TCPAddr{IP: otherIP.AsSlice()}}
+	tc, err := d.Dial("tcp4", e.privSIP().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tc.Close()
+	tc.SetReadDeadline(time.Now().Add(waitLong))
+	if _, err := tc.Read(make([]byte, 1)); err == nil {
+		t.Fatal("foreign TCP connection stayed open")
+	}
+	c.expectNothing()
+
+	// The connection still works.
+	c.send(requestText("OPTIONS", "sip:"+upIP.String(), []string{
+		c.via(newBranch()), "From: <sip:a@b>;tag=1", "To: <sip:a@b>", "Call-ID: ok-" + newBranch(), "CSeq: 1 OPTIONS",
+	}, ""))
+	e.up.expectRequest("OPTIONS")
+
+	// Broken framing closes the connection.
+	c.send("\rX")
+	waitFor(t, func() bool { return !e.relay.sip.clientOn.Load() })
+}
