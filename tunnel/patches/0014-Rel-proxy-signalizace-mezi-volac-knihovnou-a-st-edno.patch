+func certDER(pemBytes []byte) ([]byte, error) {
+	for {
+		var blk *pem.Block
+		blk, pemBytes = pem.Decode(pemBytes)
+		if blk == nil {
+			return nil, errors.New("no CERTIFICATE block")
+		}
+		if blk.Type == "CERTIFICATE" {
+			if _, err := x509.ParseCertificate(blk.Bytes); err != nil {
+				return nil, err
+			}
+			return blk.Bytes, nil
+		}
+	}
+}
+
+var errClientCert = errors.New("client certificate not accepted")
+
+// serverTLSConfig requires a client certificate and accepts exactly one.
+// Suites cover what the calling library's TLS stack offers.
+func serverTLSConfig(cert tls.Certificate, clientDER []byte) *tls.Config {
+	pinned := func(raw []byte) bool {
+		return len(raw) == len(clientDER) && subtle.ConstantTimeCompare(raw, clientDER) == 1
+	}
+	return &tls.Config{
+		Certificates: []tls.Certificate{cert},
+		ClientAuth:   tls.RequireAnyClientCert,
+		MinVersion:   tls.VersionTLS12,
+		CipherSuites: []uint16{
+			tls.TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,
+			tls.TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,
+			tls.TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256,
+			tls.TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,
+			tls.TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,
+			tls.TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256,
+		},
+		// Resumed sessions would skip VerifyPeerCertificate.
+		SessionTicketsDisabled: true,
+		VerifyPeerCertificate: func(raw [][]byte, _ [][]*x509.Certificate) error {
+			if len(raw) == 0 || !pinned(raw[0]) {
+				return errClientCert
+			}
+			return nil
+		},
+		VerifyConnection: func(cs tls.ConnectionState) error {
+			if len(cs.PeerCertificates) == 0 || !bytes.Equal(cs.PeerCertificates[0].Raw, clientDER) {
+				return errClientCert
+			}
+			return nil
+		},
+	}
+}
+
+// listenPrivateSIP binds UDP and TCP on the same private-network port.
+func listenPrivateSIP(nw Network, want uint16) (net.PacketConn, net.Listener, int, error) {
+	var lastErr error
+	for try := 0; try < 16; try++ {
+		port := uint16(0)
+		if try == 0 {
+			port = want
+		}
+		u, err := nw.ListenUDP(port)
+		if err != nil {
+			lastErr = err
+			continue
+		}
+		up := addrPortOf(u.LocalAddr()).Port()
+		if up == 0 {
+			u.Close()
+			return nil, nil, 0, errors.New("private UDP socket has no port")
+		}
+		t, err := nw.ListenTCP(up)
+		if err != nil {
+			u.Close()
+			lastErr = err
+			continue
+		}
+		return u, t, int(up), nil
+	}
+	return nil, nil, 0, fmt.Errorf("private SIP port: %w", lastErr)
+}
