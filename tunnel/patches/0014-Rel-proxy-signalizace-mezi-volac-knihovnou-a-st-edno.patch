+func TestKeepalive(t *testing.T) {
+	e := newEnv(t)
+	conn, err := dialClient(t, e.info.SIPPort, &e.clientCert.tls)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 2; i++ {
+		if _, err := conn.Write([]byte("\r\n\r\n")); err != nil {
+			t.Fatal(err)
+		}
+		conn.SetReadDeadline(time.Now().Add(waitLong))
+		buf := make([]byte, 8)
+		n, err := conn.Read(buf)
+		if err != nil || string(buf[:n]) != "\r\n" {
+			t.Fatalf("pong %q %v", buf[:n], err)
+		}
+	}
+	if e.counter("client.keepalive") != 2 {
+		t.Fatalf("keepalive counter %d", e.counter("client.keepalive"))
+	}
+}
