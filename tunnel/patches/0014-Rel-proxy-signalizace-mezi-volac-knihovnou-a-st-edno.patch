+// register runs REGISTER -> 401 -> REGISTER -> 200 and returns the 200 the
+// calling library sees.
+func register(t *testing.T, e *testEnv, c *fakeClient) *sipMsg {
+	t.Helper()
+	callID := "reg-" + newBranch()
+	hdrs := func(branch string, cseq int, extra ...string) []string {
+		return append([]string{
+			c.via(branch),
+			e.relayRoute(),
+			"Max-Forwards: 70",
+			"From: <sip:" + testUser + "@" + upIP.String() + ">;tag=reg1",
+			"To: <sip:" + testUser + "@" + upIP.String() + ">",
+			"Call-ID: " + callID,
+			"CSeq: " + strconv.Itoa(cseq) + " REGISTER",
+			`Contact: <` + c.contact() + `>;+sip.instance="<urn:uuid:00000000-0000-0000-0000-000000000000>";expires=3600`,
+			"Expires: 3600",
+		}, extra...)
+	}
+	c.send(requestText("REGISTER", e.relayURI(), hdrs(newBranch(), 1), ""))
+	r1 := e.up.expectRequest("REGISTER")
+
+	// What the miniserver sees.
+	if r1.conn != nil || r1.src != e.privSIP() {
+		t.Fatalf("REGISTER came from %v (tcp=%v), want UDP from %v", r1.src, r1.conn != nil, e.privSIP())
+	}
+	if want := "sip:" + e.up.addr.String(); r1.m.ruri != want {
+		t.Fatalf("R-URI %q, want %q", r1.m.ruri, want)
+	}
+	vias := r1.m.values("via")
+	if len(vias) != 2 {
+		t.Fatalf("Vias %q", vias)
+	}
+	v := topVia(t, r1.m)
+	if v.transport != "UDP" || v.host != privIP.String() || v.port != e.info.PrivateSIPPort || !strings.HasPrefix(v.branch(), branchPrefix) || !hasParam(v.params, "rport") {
+		t.Fatalf("relay Via %q", vias[0])
+	}
+	cv, _ := parseVia(vias[1])
+	if rp, _ := paramValue(cv.params, "rport"); rp != strconv.Itoa(c.port) {
+		t.Fatalf("client Via rport not filled: %q", vias[1])
+	}
+	if r1.m.has("route") {
+		t.Fatal("Route to the relay was forwarded")
+	}
+	if r1.m.get("max-forwards") != "69" {
+		t.Fatalf("Max-Forwards %q", r1.m.get("max-forwards"))
+	}
+	wantContact := fmt.Sprintf(`<sip:%s@%s>;+sip.instance="<urn:uuid:00000000-0000-0000-0000-000000000000>";expires=3600`, testUser, e.privSIP())
+	if got := r1.m.get("contact"); got != wantContact {
+		t.Fatalf("Contact %q, want %q", got, wantContact)
+	}
+
+	e.up.reply(r1, 401, "Unauthorized", []string{`WWW-Authenticate: Digest realm="test",nonce="n1",algorithm=MD5`}, "")
+	m401 := c.expectResponse(401, "REGISTER")
+	if vs := m401.values("via"); len(vs) != 1 || !strings.Contains(vs[0], fmt.Sprintf("127.0.0.1:%d", c.port)) {
+		t.Fatalf("401 Vias %q", vs)
+	}
+	if !m401.has("www-authenticate") {
+		t.Fatal("challenge lost")
+	}
+
+	c.send(requestText("REGISTER", e.relayURI(), hdrs(newBranch(), 2,
+		`Authorization: Digest username="test",realm="test",nonce="n1",uri="sip:x",response="00"`), ""))
+	r2 := e.up.expectRequest("REGISTER")
+	if topVia(t, r2.m).branch() == v.branch() {
+		t.Fatal("new transaction reused the branch")
+	}
+	e.up.reply(r2, 200, "OK", []string{
+		fmt.Sprintf("Contact: <sip:%s@%s;x-ast-orig-host=%s>;expires=3600, <sip:%s@100.64.0.9:5060>;expires=120",
+			testUser, e.privSIP(), e.privSIP(), testUser),
+		"Expires: 3600",
+	}, "")
+	return c.expectResponse(200, "REGISTER")
+}
