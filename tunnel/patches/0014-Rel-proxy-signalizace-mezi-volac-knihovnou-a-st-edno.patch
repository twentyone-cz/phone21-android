+package p21relay
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestBranchStateless(t *testing.T) {
+	p := &sipProxy{secret: []byte("k")}
+	mk := func(method, branch string) *sipMsg {
+		m, err := parseSIP([]byte(method + " sip:x@127.0.0.3 SIP/2.0\r\nVia: SIP/2.0/TLS 127.0.0.1:1;branch=" + branch +
+			"\r\nCall-ID: c\r\nFrom: <sip:a@b>;tag=f\r\nTo: <sip:x@b>\r\nCSeq: 1 " + method + "\r\n\r\n"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		return m
+	}
+	inv := p.branch("c", "z9hG4bKone", mk("INVITE", "z9hG4bKone"))
+	if inv != p.branch("c", "z9hG4bKone", mk("INVITE", "z9hG4bKone")) {
+		t.Fatal("not deterministic")
+	}
+	if inv != p.branch("c", "z9hG4bKone", mk("CANCEL", "z9hG4bKone")) || inv != p.branch("c", "z9hG4bKone", mk("ACK", "z9hG4bKone")) {
+		t.Fatal("CANCEL/ACK must share the INVITE branch")
+	}
+	if inv == p.branch("c", "z9hG4bKtwo", mk("ACK", "z9hG4bKtwo")) || inv == p.branch("c", "z9hG4bKone", mk("BYE", "z9hG4bKone")) {
+		t.Fatal("different transactions share a branch")
+	}
+	if !strings.HasPrefix(inv, branchPrefix) {
+		t.Fatal("prefix")
+	}
+	legacy := p.branch("c", "", mk("INVITE", "1"))
+	if legacy != p.branch("c", "", mk("CANCEL", "1")) {
+		t.Fatal("legacy CANCEL branch differs")
+	}
+}
