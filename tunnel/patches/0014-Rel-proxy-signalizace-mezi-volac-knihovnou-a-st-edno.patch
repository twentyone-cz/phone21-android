+func TestClientCertificatePinned(t *testing.T) {
+	e := newEnv(t)
+	other := makeCert(t, "client")
+	tryCert := func(cert *tls.Certificate) {
+		t.Helper()
+		conn, err := dialClient(t, e.info.SIPPort, cert)
+		if err != nil {
+			return // refused during the handshake
+		}
+		// TLS 1.3: the server's verdict arrives after the client finished.
+		conn.Write([]byte(requestText("OPTIONS", "sip:"+upIP.String(), []string{
+			"Via: SIP/2.0/TLS 127.0.0.1:1;branch=" + newBranch(), "From: <sip:a@b>;tag=1", "To: <sip:a@b>", "Call-ID: x", "CSeq: 1 OPTIONS",
+		}, "")))
+		conn.SetReadDeadline(time.Now().Add(waitLong))
+		if _, err := conn.Read(make([]byte, 1)); err == nil {
+			t.Fatal("connection without the pinned certificate was served")
+		}
+	}
+	before := e.counter("client.rejected")
+	tryCert(nil)
+	tryCert(&other.tls)
+	waitFor(t, func() bool { return e.counter("client.rejected") == before+2 })
+	e.up.expectNothing()
+	if e.relay.sip.clientOn.Load() {
+		t.Fatal("rejected client became active")
+	}
+
+	// TLS 1.2 with a suite the calling library's TLS stack uses.
+	cfg := &tls.Config{
+		InsecureSkipVerify: true,
+		MaxVersion:         tls.VersionTLS12,
+		CipherSuites:       []uint16{tls.TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256},
+		Certificates:       []tls.Certificate{e.clientCert.tls},
+	}
+	conn, err := tls.Dial("tcp4", "127.0.0.1:"+strconv.Itoa(e.info.SIPPort), cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	waitFor(t, func() bool { return e.relay.sip.clientOn.Load() })
+}
