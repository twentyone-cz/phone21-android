+func TestRetransmissionsOverUDP(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+	// The first copy of a request is "lost": the relay repeats it after T1.
+	c.send(requestText("OPTIONS", "sip:"+upIP.String(), []string{
+		c.via(newBranch()), "Max-Forwards: 70",
+		"From: <sip:" + testUser + "@" + upIP.String() + ">;tag=o1", "To: <sip:" + upIP.String() + ">",
+		"Call-ID: o-" + newBranch(), "CSeq: 1 OPTIONS",
+	}, ""))
+	first := <-e.up.in
+	select {
+	case again := <-e.up.in:
+		if string(again.raw) != string(first.raw) {
+			t.Fatalf("retransmission differs:\n%s\n---\n%s", first.raw, again.raw)
+		}
+	case <-time.After(waitLong):
+		t.Fatal("no retransmission")
+	}
+	e.up.reply(first, 200, "OK", nil, "")
+	c.expectResponse(200, "OPTIONS")
+	// A repeated final answer is not passed on again.
+	e.up.reply(first, 200, "OK", nil, "")
+	c.expectNothing()
+	n := e.counter("sip.retransmit")
+	time.Sleep(1200 * time.Millisecond)
+	if e.counter("sip.retransmit") != n {
+		t.Fatal("still retransmitting after the answer")
+	}
+
+	// The 200 to an incoming INVITE is repeated until the miniserver's ACK.
+	register(t, e, c)
+	upr := newRTPPair(t, upIP)
+	callID := "rt-" + newBranch()
+	e.up.sendUDP(e.privSIP(), incomingInvite(t, e, callID, 7, upr.port))
+	ci := c.expectRequest("INVITE")
+	c.send(responseText(ci, 200, "OK", "cli-tag", []string{"Contact: <" + c.contact() + ">"}, sdpBody("127.0.0.1", newRTPPair(t, loopback4).port)))
+	r := e.up.expectResponse(200, "INVITE")
+	select {
+	case again := <-e.up.in: // no ACK yet: the relay repeats its 200
+		if string(again.raw) != string(r.raw) {
+			t.Fatalf("repeated 200 differs:\n%s\n---\n%s", r.raw, again.raw)
+		}
+	case <-time.After(waitLong):
+		t.Fatal("200 not repeated")
+	}
+	e.up.sendUDP(e.privSIP(), upRequest(e, "ACK", callID, 7, "cli-tag"))
+	c.expectRequest("ACK")
+	n = e.counter("sip.retransmit")
+	time.Sleep(1200 * time.Millisecond)
+	if e.counter("sip.retransmit") != n {
+		t.Fatal("200 still repeated after ACK")
+	}
+}
