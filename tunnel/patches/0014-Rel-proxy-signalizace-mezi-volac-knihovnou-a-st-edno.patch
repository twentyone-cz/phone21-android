+func TestLargeMessagesOverTCP(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+	register(t, e, c)
+	text := strings.Repeat("x", 1500)
+
+	msg := func(via, ruri string) string {
+		return "MESSAGE " + ruri + " SIP/2.0\r\n" + via + "\r\nMax-Forwards: 70\r\n" +
+			"From: <sip:" + testUser + "@" + upIP.String() + ">;tag=m1\r\nTo: <sip:" + testNumber + "@" + upIP.String() + ">\r\n" +
+			"Call-ID: msg-" + newBranch() + "\r\nCSeq: 1 MESSAGE\r\nContent-Type: text/plain\r\n" +
+			"Content-Length: " + strconv.Itoa(len(text)) + "\r\n\r\n" + text
+	}
+	// Calling library -> miniserver: relay switches to TCP.
+	c.send(msg(c.via(newBranch()), "sip:"+testNumber+"@"+upIP.String()))
+	um := e.up.expectRequest("MESSAGE")
+	if um.conn == nil {
+		t.Fatal("big MESSAGE went over UDP")
+	}
+	if v := topVia(t, um.m); v.transport != "TCP" || v.port != e.info.PrivateSIPPort {
+		t.Fatalf("Via %+v", v)
+	}
+	if string(um.m.body) != text {
+		t.Fatal("body changed")
+	}
+	e.up.reply(um, 200, "OK", nil, "")
+	c.expectResponse(200, "MESSAGE")
+
+	// Miniserver -> calling library over a TCP connection it opens itself.
+	conn := e.up.dialTCP(e.privSIP())
+	if _, err := conn.Write([]byte(msg("Via: SIP/2.0/TCP "+e.up.addr.String()+";rport;branch="+newBranch(), "sip:"+testUser+"@"+e.privSIP().String()))); err != nil {
+		t.Fatal(err)
+	}
+	cm := c.expectRequest("MESSAGE")
+	if conn, _ := paramValue(topVia(t, cm).params, viaConnParam); conn == "u" || conn == "" {
+		t.Fatalf("TCP origin not recorded: %q", conn)
+	}
+	if cm.ruri != c.contact() {
+		t.Fatalf("R-URI %q", cm.ruri)
+	}
+	c.send(responseText(cm, 200, "OK", "cli-tag", nil, ""))
+	r := e.up.expectResponse(200, "MESSAGE")
+	if r.conn != conn {
+		t.Fatal("answer did not use the miniserver's connection")
+	}
+}
