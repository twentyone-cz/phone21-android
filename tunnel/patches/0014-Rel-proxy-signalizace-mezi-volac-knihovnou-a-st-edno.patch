+func TestIncomingCall(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+	register(t, e, c)
+	cl := &call{callID: "in-" + newBranch(), cli: newRTPPair(t, loopback4), up: newRTPPair(t, upIP)}
+
+	e.up.sendUDP(e.privSIP(), incomingInvite(t, e, cl.callID, 100, cl.up.port))
+	ci := c.expectRequest("INVITE")
+	if ci.ruri != c.contact() {
+		t.Fatalf("R-URI %q, want the registered contact %q", ci.ruri, c.contact())
+	}
+	v := topVia(t, ci)
+	if v.transport != "TLS" || v.host != "127.0.0.1" || v.port != e.info.SIPPort || !strings.HasPrefix(v.branch(), branchPrefix) {
+		t.Fatalf("relay Via %+v", v)
+	}
+	if conn, _ := paramValue(v.params, viaConnParam); conn != "u" {
+		t.Fatalf("transport param %q", conn)
+	}
+	if up, _ := parseVia(ci.values("via")[1]); func() string { r, _ := paramValue(up.params, "rport"); return r }() != strconv.Itoa(int(e.up.addr.Port())) {
+		t.Fatalf("miniserver Via rport not filled: %q", ci.values("via")[1])
+	}
+	if want := fmt.Sprintf("<sip:asterisk@127.0.0.1:%d;transport=tls>", e.info.SIPPort); ci.get("contact") != want {
+		t.Fatalf("Contact %q, want %q", ci.get("contact"), want)
+	}
+	addr, port := sdpMedia(t, ci.body)
+	if addr != "127.0.0.1" {
+		t.Fatalf("offer to the client not anchored: %s", addr)
+	}
+	cl.relayC = port
+
+	c.send(responseText(ci, 180, "Ringing", "cli-tag", []string{"Contact: <" + c.contact() + ">"}, ""))
+	r180 := e.up.expectResponse(180, "INVITE")
+	if vs := r180.m.values("via"); len(vs) != 1 {
+		t.Fatalf("180 Vias %q", vs)
+	}
+	if want := "<sip:" + testUser + "@" + e.privSIP().String() + ">"; r180.m.get("contact") != want {
+		t.Fatalf("180 Contact %q, want %q", r180.m.get("contact"), want)
+	}
+	if r180.src != e.privSIP() {
+		t.Fatalf("180 from %v", r180.src)
+	}
+	c.send(responseText(ci, 200, "OK", "cli-tag", []string{"Contact: <" + c.contact() + ">"}, sdpBody("127.0.0.1", cl.cli.port)))
+	r200 := e.up.expectResponse(200, "INVITE")
+	addr, port = sdpMedia(t, r200.m.body)
+	if addr != privIP.String() {
+		t.Fatalf("answer not anchored: %s", addr)
+	}
+	cl.relayU = port
+
+	e.up.sendUDP(e.privSIP(), upRequest(e, "ACK", cl.callID, 100, "cli-tag"))
+	c.expectRequest("ACK")
+	cl.checkMedia(t, "in")
+
+	// After the ACK the relay stops repeating its 200.
+	before := e.counter("sip.retransmit")
+	time.Sleep(1200 * time.Millisecond)
+	if after := e.counter("sip.retransmit"); after != before {
+		t.Fatalf("200 still retransmitted after ACK (%d -> %d)", before, after)
+	}
+
+	// BYE from the miniserver.
+	e.up.sendUDP(e.privSIP(), upRequest(e, "BYE", cl.callID, 101, "cli-tag"))
+	cb := c.expectRequest("BYE")
+	c.send(responseText(cb, 200, "OK", "cli-tag", nil, ""))
+	e.up.expectResponse(200, "BYE")
+	waitFor(t, func() bool { return e.mediaStat("streams") == 0 })
+}
