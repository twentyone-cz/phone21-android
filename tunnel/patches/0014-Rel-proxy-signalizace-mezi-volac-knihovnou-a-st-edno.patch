+	if _, p := sdpMedia(t, r200.body); p != cl.relayC {
+		t.Fatalf("200 moved the stream: %d != %d", p, cl.relayC)
+	}
+	c.send(requestText("ACK", e.relayURI(), cl.clientHeaders(c, newBranch(), cl.cseq, "ACK", true), ""))
