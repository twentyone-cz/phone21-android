+			t.Fatal("old client got a message")
+		}
+	case <-time.After(waitLong):
+		t.Fatal("old client connection not closed")
+	}
+	waitFor(t, func() bool { return e.relay.sip.clientOn.Load() && e.counter("client.replaced") == 1 })
+	e.up.sendUDP(e.privSIP(), upRequest(e, "OPTIONS", "n-"+newBranch(), 1, "t"))
+	c2.expectRequest("OPTIONS")
+}
+
+func TestMediaForeignSourcesDropped(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+	cl := establishOutgoing(t, e, c)
+
+	// Another app on the phone sends to the relay's 127.0.0.1 RTP port.
+	intruder, err := net.ListenUDP("udp4", &net.UDPAddr{IP: loopback4.AsSlice()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer intruder.Close()
+	intruder.WriteToUDPAddrPort([]byte("inject"), cl.relayClientRTP())
+	intruder.WriteToUDPAddrPort([]byte("inject"), cl.relayClientRTCP())
+	expectNoPacket(t, cl.up.rtp)
+	expectNoPacket(t, cl.up.rtcp)
+	waitFor(t, func() bool { return e.mediaStat("dropForeignClient") == 2 })
+
+	// Another peer of the private network sends to the relay's private port.
+	peer, err := net.ListenUDP("udp4", &net.UDPAddr{IP: otherIP.AsSlice()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer peer.Close()
+	peer.WriteToUDPAddrPort([]byte("inject"), cl.relayPrivRTP())
+	expectNoPacket(t, cl.cli.rtp)
+	waitFor(t, func() bool { return e.mediaStat("dropForeignNetwork") == 1 })
+
+	// Nothing reaches the intruder either, and the call still works.
+	cl.checkMedia(t, "after")
+	expectNoPacket(t, intruder)
+}
+
+func TestMediaIdleRelease(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+	cl := startOutgoing(t, e, c)
+	if e.mediaStat("streams") != 1 {
+		t.Fatal("no stream")
+	}
+	// Pretend the call went silent long ago.
+	e.relay.media.mu.Lock()
+	call := e.relay.media.calls[cl.callID]
+	call.lastSIP = time.Now().Add(-2 * mediaIdleTimeout)
+	for _, s := range call.streams {
+		s.lastPkt.Store(call.lastSIP.UnixNano())
+	}
+	e.relay.media.mu.Unlock()
+	if next := e.relay.media.expire(time.Now()); !next.IsZero() {
+		t.Fatalf("next deadline %v", next)
+	}
+	if e.mediaStat("streams") != 0 || e.counter("media.released_idle") != 1 {
+		t.Fatalf("not released: %v", e.relay.media.stats())
+	}
+}
+
+func TestStatsAndClose(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+	cl := establishOutgoing(t, e, c)
+	_ = cl
+	s := e.stats()
+	if s["clientConnected"] != true {
+		t.Fatalf("stats %v", s)
+	}
+	if m := s["media"].(map[string]any); m["streams"].(float64) != 1 {
+		t.Fatalf("media stats %v", m)
+	}
+	if ctr := s["counters"].(map[string]any); ctr["sip.from_client"].(float64) < 2 {
+		t.Fatalf("counters %v", ctr)
+	}
+	for _, bad := range []string{testUser, testNumber, e.info.HTTPToken, cl.callID} {
+		if strings.Contains(e.relay.Stats(), bad) {
+			t.Fatalf("stats leak %q", bad)
+		}
+	}
+	e.relay.Close()
+	if _, err := net.DialTimeout("tcp4", "127.0.0.1:"+strconv.Itoa(e.info.SIPPort), time.Second); err == nil {
+		t.Fatal("SIP port still open after Close")
+	}
+	if e.mediaStat("streams") != 0 {
+		t.Fatal("media not released on Close")
+	}
+	e.relay.Close() // idempotent
+}
+
+func TestStartValidation(t *testing.T) {
+	sc, cc := makeCert(t, "relay"), makeCert(t, "client")
+	good := Config{UpstreamSIP: netip.MustParseAddrPort("127.0.0.3:5060"), ServerCertPEM: sc.certPEM, ServerKeyPEM: sc.keyPEM, ClientCertPEM: cc.certPEM}
+	for name, mut := range map[string]func(*Config){
+		"no upstream":   func(c *Config) { c.UpstreamSIP = netip.AddrPort{} },
+		"v6 upstream":   func(c *Config) { c.UpstreamSIP = netip.MustParseAddrPort("[fd00::1]:5060") },
+		"no server key": func(c *Config) { c.ServerKeyPEM = nil },
+		"no client":     func(c *Config) { c.ClientCertPEM = []byte("junk") },
+	} {
+		cfg := good
+		mut(&cfg)
+		if r, _, err := Start(context.Background(), cfg, fakeNet{}); err == nil {
+			r.Close()
+			t.Errorf("%s: accepted", name)
+		}
+	}
+	// Cancelling the context stops the relay.
+	ctx, cancel := context.WithCancel(context.Background())
+	r, info, err := Start(ctx, good, fakeNet{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	cancel()
+	waitFor(t, func() bool {
+		c, err := net.DialTimeout("tcp4", "127.0.0.1:"+strconv.Itoa(info.SIPPort), 100*time.Millisecond)
+		if err == nil {
+			c.Close()
+		}
+		return err != nil
+	})
+	r.Close()
+}
+
+func TestStartHTTPRelay(t *testing.T) {
+	_, upAddr := newHTTPUpstream(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		io.WriteString(w, r.Method+" "+r.RequestURI)
+	}))
+	e := newEnv(t, upIP)
+	if len(e.info.HTTPToken) != 64 {
+		t.Fatalf("token length %d", len(e.info.HTTPToken))
+	}
+	for _, tok := range []string{e.info.HTTPToken, ""} {
+		req, _ := http.NewRequest("GET", fmt.Sprintf("http://127.0.0.1:%d/%s/pristup?x=1", e.info.HTTPPort, upAddr), nil)
+		if tok != "" {
+			req.Header.Set(TokenHeader, tok)
+		}
+		resp, err := relayClient().Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		body, _ := io.ReadAll(resp.Body)
+		resp.Body.Close()
+		switch {
+		case tok != "" && (resp.StatusCode != 200 || string(body) != "GET /pristup?x=1"):
+			t.Fatalf("with token: %d %q", resp.StatusCode, body)
+		case tok == "" && resp.StatusCode != 403:
+			t.Fatalf("without token: %d", resp.StatusCode)
+		}
+	}
+}
diff --git a/libtailscale/p21relay/sipproxy.go b/libtailscale/p21relay/sipproxy.go
new file mode 100644
index 0000000..cbf8783
--- /dev/null
+++ b/libtailscale/p21relay/sipproxy.go
@@ -0,0 +1,1199 @@
+// Copyright (c) Phone21
+// SPDX-License-Identifier: BSD-3-Clause
+
+package p21relay
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"crypto/tls"
+	"encoding/hex"
+	"errors"
+	"net"
+	"net/netip"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+const (
+	sipT1                = 500 * time.Millisecond
+	sipT2                = 4 * time.Second
+	sipTxTimeout         = 64 * sipT1
+	maxUDPRequest        = 1200 // bigger requests go to the miniserver over TCP
+	maxTxEntries         = 256
+	maxUpstreamTCP       = 8
+	maxRememberedContact = 16
+	maxPendingHandshakes = 16
+	handshakeTimeout     = 10 * time.Second
+	tcpDialTimeout       = 10 * time.Second
+	writeTimeout         = 10 * time.Second
+	clientQueueLen       = 256
+	tcpQueueLen          = 64
+	branchPrefix         = "z9hG4bK-p21-"
+	viaConnParam         = "p21c" // which miniserver transport a request came on
+)
+
+type evKind int
+
+const (
+	evClientUp evKind = iota
+	evClientDown
+	evClientMsg
+	evUpstreamMsg
+	evTCPUp
+	evTCPDown
+)
+
+type sipEvent struct {
+	kind evKind
+	data []byte
+	cc   *clientConn
+	tc   *tcpConn // nil: UDP
+	src  netip.AddrPort
+}
+
+// clientConn is the TLS connection of the calling library.
+type clientConn struct {
+	conn   net.Conn
+	remote netip.AddrPort
+	out    chan []byte
+	done   chan struct{}
+	once   sync.Once
+}
+
+func (c *clientConn) send(b []byte) bool {
+	select {
+	case <-c.done:
+		return false
+	default:
+	}
+	select {
+	case c.out <- b:
+		return true
+	default:
+		return false
+	}
+}
+
+func (c *clientConn) close() {
+	c.once.Do(func() {
+		close(c.done)
+		c.conn.Close()
+	})
+}
+
+// tcpConn is a TCP connection to the miniserver, dialled by the relay
+// (outgoing) or accepted on the private address.
+type tcpConn struct {
+	id       uint64
+	outgoing bool
+	out      chan []byte
+	done     chan struct{}
+	once     sync.Once
+	mu       sync.Mutex
+	conn     net.Conn
+}
+
+func newTCPConn(id uint64, outgoing bool, c net.Conn) *tcpConn {
+	return &tcpConn{id: id, outgoing: outgoing, conn: c, out: make(chan []byte, tcpQueueLen), done: make(chan struct{})}
+}
+
+func (t *tcpConn) setConn(c net.Conn) bool {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	select {
+	case <-t.done:
+		c.Close()
+		return false
+	default:
+	}
+	t.conn = c
+	return true
+}
+
+func (t *tcpConn) getConn() net.Conn {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.conn
+}
+
+func (t *tcpConn) closed() bool {
+	select {
+	case <-t.done:
+		return true
+	default:
+		return false
+	}
+}
+
+func (t *tcpConn) send(b []byte) bool {
+	if t.closed() {
+		return false
+	}
+	select {
+	case t.out <- b:
+		return true
+	default:
+		return false
+	}
+}
+
+func (t *tcpConn) close() {
+	t.once.Do(func() {
+		t.mu.Lock()
+		close(t.done)
+		if t.conn != nil {
+			t.conn.Close()
+		}
+		t.mu.Unlock()
+	})
+}
+
+// txEntry makes the UDP leg toward the miniserver reliable: the calling
+// library talks TLS and therefore never retransmits.
+type txEntry struct {
+	data      []byte
+	dest      netip.AddrPort
+	invite    bool // INVITE client transaction: Timer A is not capped at T2
+	response  bool // final response to an INVITE from the miniserver, until its ACK
+	completed bool // final response seen (request entries only)
+	ack       []byte
+	next      time.Time // zero: no more retransmissions
+	interval  time.Duration
+	expire    time.Time
+}
+
+// sipProxy is a single-upstream SIP proxy between the calling library
+// (TLS on 127.0.0.1) and the miniserver (UDP/TCP in the private network).
+// All SIP state lives in one goroutine (run).
+type sipProxy struct {
+	cfg      *Config
+	nw       Network
+	cnt      *counters
+	log      *rateLog
+	media    *mediaManager
+	ctx      context.Context
+	wg       *sync.WaitGroup
+	tlsConf  *tls.Config
+	tlsLn    net.Listener
+	sipPort  int        // TLS port on 127.0.0.1
+	localIP  netip.Addr // this phone in the private network
+	upPort   int        // UDP and TCP port on localIP
+	udp      net.PacketConn
+	tcpLn    net.Listener
+	upstream netip.AddrPort
+	secret   []byte
+
+	events   chan sipEvent
+	nextID   atomic.Uint64
+	clientOn atomic.Bool
+
+	// Owned by run.
+	client   *clientConn
+	tcps     map[uint64]*tcpConn
+	outTCP   *tcpConn
+	contacts map[string]string // user part -> Contact URI the calling library registered
+	txs      map[string]*txEntry
+	timer    *time.Timer
+	timerOn  bool
+}
+
+func (p *sipProxy) post(ev sipEvent) bool {
+	select {
+	case p.events <- ev:
+		return true
+	case <-p.ctx.Done():
+		return false
+	}
+}
+
+func (p *sipProxy) drop(reason string) {
+	p.cnt.inc("sip.drop." + reason)
+	p.log.printf("drop-"+reason, "p21relay: SIP message dropped: %s", reason)
+}
+
+func (p *sipProxy) start() {
+	p.events = make(chan sipEvent, 256)
+	p.tcps = make(map[uint64]*tcpConn)
+	p.contacts = make(map[string]string)
+	p.txs = make(map[string]*txEntry)
+	p.timer = time.NewTimer(time.Hour)
+	p.timer.Stop()
+	p.wg.Add(4)
+	go p.run()
+	go p.acceptClients()
+	go p.readUDP()
+	go p.acceptUpstream()
+}
+
+// ---- goroutines feeding the loop ----
+
+// pendingConns tracks TLS handshakes in progress. When full, the oldest is
+// dropped instead of refusing the newcomer, so other apps holding
+// half-open connections cannot lock the calling library out.
+type pendingConns struct {
+	mu    sync.Mutex
+	conns []net.Conn
+}
+
+func (pc *pendingConns) add(c net.Conn) (evicted net.Conn) {
+	pc.mu.Lock()
+	defer pc.mu.Unlock()
+	pc.conns = append(pc.conns, c)
+	if len(pc.conns) > maxPendingHandshakes {
+		evicted = pc.conns[0]
+		pc.conns = pc.conns[1:]
+	}
+	return evicted
+}
+
+func (pc *pendingConns) remove(c net.Conn) {
+	pc.mu.Lock()
+	defer pc.mu.Unlock()
+	for i, x := range pc.conns {
+		if x == c {
+			pc.conns = append(pc.conns[:i], pc.conns[i+1:]...)
+			return
+		}
+	}
+}
+
+func (p *sipProxy) acceptClients() {
+	defer p.wg.Done()
+	var pending pendingConns
+	for {
+		c, err := p.tlsLn.Accept()
+		if err != nil {
+			if p.ctx.Err() != nil || errors.Is(err, net.ErrClosed) {
+				return
+			}
+			if !p.pause() {
+				return
+			}
+			continue
+		}
+		if old := pending.add(c); old != nil {
+			p.cnt.inc("client.handshake_evicted")
+			old.Close()
+		}
+		p.wg.Add(1)
+		go func() {
+			defer p.wg.Done()
+			cc := p.handshake(c)
+			pending.remove(c)
+			if cc != nil {
+				p.serveClient(cc)
+			}
+		}()
+	}
+}
+
+func (p *sipProxy) handshake(raw net.Conn) *clientConn {
+	tc := tls.Server(raw, p.tlsConf)
+	ctx, cancel := context.WithTimeout(p.ctx, handshakeTimeout)
+	defer cancel()
+	tc.SetDeadline(time.Now().Add(handshakeTimeout))
+	if err := tc.HandshakeContext(ctx); err != nil {
+		tc.Close()
+		p.cnt.inc("client.rejected")
+		p.log.printf("client-rejected", "p21relay: SIP client rejected (TLS handshake failed)")
+		return nil
+	}
+	tc.SetDeadline(time.Time{})
+	return &clientConn{
+		conn:   tc,
+		remote: addrPortOf(raw.RemoteAddr()),
+		out:    make(chan []byte, clientQueueLen),
+		done:   make(chan struct{}),
+	}
+}
+
+func (p *sipProxy) serveClient(cc *clientConn) {
+	// Close with the relay even if the loop never saw this connection.
+	stop := context.AfterFunc(p.ctx, cc.close)
+	defer stop()
+	if !p.post(sipEvent{kind: evClientUp, cc: cc}) {
+		cc.close()
+		return
+	}
+	p.wg.Add(1)
+	go func() {
+		defer p.wg.Done()
+		for {
+			select {
+			case b := <-cc.out:
+				cc.conn.SetWriteDeadline(time.Now().Add(writeTimeout))
+				if _, err := cc.conn.Write(b); err != nil {
+					cc.close()
+					return
+				}
+			case <-cc.done:
+				return
+			}
+		}
+	}()
+	defer func() {
+		cc.close()
+		p.post(sipEvent{kind: evClientDown, cc: cc})
+	}()
+	r := newSIPStreamReader(cc.conn)
+	for {
+		msg, ping, err := r.next()
+		if err != nil {
+			if errors.Is(err, errFraming) {
+				p.cnt.inc("sip.drop.client_framing")
+			}
+			return
+		}
+		if ping {
+			p.cnt.inc("client.keepalive")
+			cc.send([]byte("\r\n"))
+			continue
+		}
+		if !p.post(sipEvent{kind: evClientMsg, data: msg, cc: cc}) {
+			return
+		}
+	}
+}
+
+func (p *sipProxy) readUDP() {
+	defer p.wg.Done()
+	buf := make([]byte, 65536)
+	for {
+		n, from, err := p.udp.ReadFrom(buf)
+		if err != nil {
+			if p.ctx.Err() != nil || errors.Is(err, net.ErrClosed) || !p.pause() {
+				return
+			}
+			continue
+		}
+		src := addrPortOf(from)
+		if src.Addr() != p.upstream.Addr() {
+			p.drop("foreign_source")
+			continue
+		}
+		if len(strings.TrimSpace(string(buf[:n]))) == 0 {
+			continue // keepalive
+		}
+		data := append([]byte(nil), buf[:n]...)
+		if !p.post(sipEvent{kind: evUpstreamMsg, data: data, src: src}) {
+			return
+		}
+	}
+}
+
+func (p *sipProxy) acceptUpstream() {
+	defer p.wg.Done()
+	for {
+		c, err := p.tcpLn.Accept()
+		if err != nil {
+			if p.ctx.Err() != nil || errors.Is(err, net.ErrClosed) || !p.pause() {
+				return
+			}
+			continue
+		}
+		if addrPortOf(c.RemoteAddr()).Addr() != p.upstream.Addr() {
+			p.drop("foreign_source")
+			c.Close()
+			continue
+		}
+		tc := newTCPConn(p.nextID.Add(1), false, c)
+		if !p.post(sipEvent{kind: evTCPUp, tc: tc}) {
+			c.Close()
+			return
+		}
+		p.wg.Add(2)
+		go p.tcpWriter(tc)
+		go p.tcpReader(tc)
+	}
+}
+
+// pause waits a little after a transient accept/read error.
+func (p *sipProxy) pause() bool {
+	select {
+	case <-time.After(100 * time.Millisecond):
+		return true
+	case <-p.ctx.Done():
+		return false
+	}
+}
+
+func (p *sipProxy) dialUpstream(tc *tcpConn) {
+	defer p.wg.Done()
+	ctx, cancel := context.WithTimeout(p.ctx, tcpDialTimeout)
+	c, err := p.nw.DialTCP(ctx, p.upstream)
+	cancel()
+	if err != nil {
+		p.cnt.inc("upstream.tcp_dial_error")
+		p.log.printf("tcp-dial", "p21relay: TCP to miniserver failed (%s)", errClass(err))
+		tc.close()
+		p.post(sipEvent{kind: evTCPDown, tc: tc})
+		return
+	}
+	if !tc.setConn(c) {
+		p.post(sipEvent{kind: evTCPDown, tc: tc})
+		return
+	}
+	p.wg.Add(2)
+	go p.tcpWriter(tc)
+	go p.tcpReader(tc)
+}
+
+func (p *sipProxy) tcpWriter(tc *tcpConn) {
+	defer p.wg.Done()
+	c := tc.getConn()
+	for {
+		select {
+		case b := <-tc.out:
+			c.SetWriteDeadline(time.Now().Add(writeTimeout))
+			if _, err := c.Write(b); err != nil {
+				p.cnt.inc("upstream.tcp_write_error")
+				tc.close()
+				return
+			}
+		case <-tc.done:
+			return
+		}
+	}
+}
+
+func (p *sipProxy) tcpReader(tc *tcpConn) {
+	defer p.wg.Done()
+	stop := context.AfterFunc(p.ctx, tc.close)
+	defer stop()
+	c := tc.getConn()
+	defer func() {
+		tc.close()
+		p.post(sipEvent{kind: evTCPDown, tc: tc})
+	}()
+	src := addrPortOf(c.RemoteAddr())
+	r := newSIPStreamReader(c)
+	for {
+		msg, ping, err := r.next()
+		if err != nil {
+			if errors.Is(err, errFraming) {
+				p.cnt.inc("sip.drop.upstream_framing")
+			}
+			return
+		}
+		if ping {
+			tc.send([]byte("\r\n"))
+			continue
+		}
+		if !p.post(sipEvent{kind: evUpstreamMsg, data: msg, tc: tc, src: src}) {
+			return
+		}
+	}
+}
+
+// ---- the loop ----
+
+func (p *sipProxy) run() {
+	defer p.wg.Done()
+	defer p.shutdown()
+	for {
+		select {
+		case <-p.ctx.Done():
+			return
+		case ev := <-p.events:
+			p.handle(ev)
+		case now := <-p.timer.C:
+			p.timerOn = false
+			p.retransmit(now)
+			p.media.expire(now)
+		}
+		p.armTimer()
+	}
+}
+
+func (p *sipProxy) shutdown() {
+	p.timer.Stop()
+	if p.client != nil {
+		p.client.close()
+		p.client = nil
+	}
+	for _, tc := range p.tcps {
+		tc.close()
+	}
+	p.clientOn.Store(false)
+}
+
+func (p *sipProxy) armTimer() {
+	var next time.Time
+	for _, tx := range p.txs {
+		d := tx.expire
+		if !tx.next.IsZero() && tx.next.Before(d) {
+			d = tx.next
+		}
+		if next.IsZero() || d.Before(next) {
+			next = d
+		}
+	}
+	if d := p.media.nextDeadline(); !d.IsZero() && (next.IsZero() || d.Before(next)) {
+		next = d
+	}
+	if next.IsZero() {
+		if p.timerOn {
+			p.timer.Stop()
+			p.timerOn = false
+		}
+		return
+	}
+	p.timer.Reset(max(time.Until(next), time.Millisecond))
+	p.timerOn = true
+}
+
+func (p *sipProxy) handle(ev sipEvent) {
+	switch ev.kind {
+	case evClientUp:
+		if p.client != nil {
+			p.client.close()
+			p.cnt.inc("client.replaced")
+		}
+		p.client = ev.cc
+		p.clientOn.Store(true)
+		p.cnt.inc("client.accepted")
+		if p.log.logf != nil {
+			p.log.logf("p21relay: SIP client connected")
+		}
+	case evClientDown:
+		if p.client == ev.cc {
+			p.client = nil
+			p.clientOn.Store(false)
+			if p.log.logf != nil {
+				p.log.logf("p21relay: SIP client disconnected")
+			}
+		}
+	case evClientMsg:
+		if ev.cc != p.client {
+			p.cnt.inc("sip.drop.stale_client")
+			return
+		}
+		p.fromClient(ev.data, ev.cc)
+	case evUpstreamMsg:
+		p.fromUpstream(ev.data, ev.tc, ev.src)
+	case evTCPUp:
+		p.tcps[ev.tc.id] = ev.tc
+		p.trimTCP()
+	case evTCPDown:
+		delete(p.tcps, ev.tc.id)
+		if p.outTCP == ev.tc {
+			p.outTCP = nil
+		}
+	}
+}
+
+// trimTCP closes the oldest accepted connections above the limit.
+func (p *sipProxy) trimTCP() {
+	for len(p.tcps) > maxUpstreamTCP {
+		var oldest *tcpConn
+		for _, tc := range p.tcps {
+			if tc != p.outTCP && (oldest == nil || tc.id < oldest.id) {
+				oldest = tc
+			}
+		}
+		if oldest == nil {
+			return
+		}
+		oldest.close()
+		delete(p.tcps, oldest.id)
+	}
+}
+
+// upstreamTCP returns the relay's own TCP connection to the miniserver,
+// dialling a new one when needed (messages queue until it is up).
+func (p *sipProxy) upstreamTCP() *tcpConn {
+	if p.outTCP != nil && !p.outTCP.closed() {
+		return p.outTCP
+	}
+	tc := newTCPConn(p.nextID.Add(1), true, nil)
+	p.outTCP = tc
+	p.tcps[tc.id] = tc
+	p.wg.Add(1)
+	go p.dialUpstream(tc)
+	return tc
+}
+
+// ---- sending ----
+
+func (p *sipProxy) sendClient(b []byte) {
+	if p.client == nil {
+		p.drop("no_client")
+		return
+	}
+	if !p.client.send(b) {
+		p.drop("client_queue")
+		return
+	}
+	p.cnt.inc("sip.to_client")
+}
+
+func (p *sipProxy) sendUDP(b []byte, dst netip.AddrPort) {
+	if _, err := p.udp.WriteTo(b, net.UDPAddrFromAddrPort(dst)); err != nil {
+		p.cnt.inc("upstream.udp_write_error")
+		p.log.printf("udp-write", "p21relay: UDP to miniserver failed (%s)", errClass(err))
+		return
+	}
+	p.cnt.inc("sip.to_upstream_udp")
+}
+
+func (p *sipProxy) sendTCP(tc *tcpConn, b []byte) {
+	if !tc.send(b) {
+		p.drop("tcp_queue")
+		return
+	}
+	p.cnt.inc("sip.to_upstream_tcp")
+}
+
+// viaDest is where a response to the request with this Via goes
+// (RFC 3261 18.2.2 with RFC 3581); only the miniserver is acceptable.
+func (p *sipProxy) viaDest(v *sipVia) (netip.AddrPort, bool) {
+	host := v.host
+	if r, ok := paramValue(v.params, "received"); ok && r != "" {
+		host = r
+	}
+	a, ok := hostAddr(host)
+	if !ok || a != p.upstream.Addr() {
+		return netip.AddrPort{}, false
+	}
+	port := v.port
+	if rp, ok := paramValue(v.params, "rport"); ok {
+		if n, err := strconv.Atoi(rp); err == nil && n > 0 && n <= 65535 {
+			port = n
+		}
+	}
+	if port == 0 {
+		port = 5060
+	}
+	return netip.AddrPortFrom(a, uint16(port)), true
+}
+
+// replyUpstream answers a request from the miniserver locally.
+func (p *sipProxy) replyUpstream(req *sipMsg, status int, reason string, tc *tcpConn, src netip.AddrPort) {
+	resp := newResponse(req, status, reason, p.toTag(req)).bytes()
+	p.cnt.inc("sip.local_reply_" + strconv.Itoa(status))
+	if tc != nil {
+		p.sendTCP(tc, resp)
+		return
+	}
+	top, _ := req.topValue("via")
+	v, ok := parseVia(top)
+	if !ok {
+		return
+	}
+	dst, ok := p.viaDest(v)
+	if !ok {
+		dst = src
+	}
+	p.sendUDP(resp, dst)
+}
+
+func (p *sipProxy) replyClient(req *sipMsg, status int, reason string) {
+	p.cnt.inc("sip.local_reply_" + strconv.Itoa(status))
+	p.sendClient(newResponse(req, status, reason, p.toTag(req)).bytes())
+}
+
+// ---- hashing ----
+
+func (p *sipProxy) mac(parts ...string) string {
+	h := hmac.New(sha256.New, p.secret)
+	for _, s := range parts {
+		h.Write([]byte(s))
+		h.Write([]byte{0})
+	}
+	return hex.EncodeToString(h.Sum(nil)[:12])
+}
+
+// branch derives our Via branch statelessly (RFC 3261 16.11): the same
+// incoming transaction always maps to the same branch, and CANCEL and the
+// ACK of a non-2xx answer map to the branch of their INVITE.
+func (p *sipProxy) branch(side, inBranch string, m *sipMsg) string {
+	method := m.method
+	if method == "ACK" || method == "CANCEL" {
+		method = "INVITE"
+	}
+	if !strings.HasPrefix(inBranch, "z9hG4bK") || len(inBranch) <= len("z9hG4bK") {
+		// RFC 2543 peer: derive from the transaction identifiers instead.
+		num, _, _ := m.cseq()
+		from, _ := paramValue(nameAddrParams(m.get("from")), "tag")
+		inBranch = "legacy\x00" + m.get("call-id") + "\x00" + from + "\x00" + strconv.FormatUint(uint64(num), 10) + "\x00" + m.ruri
+	}
+	return branchPrefix + p.mac(side, inBranch, method)
+}
+
+func (p *sipProxy) toTag(req *sipMsg) string {
+	top, _ := req.topValue("via")
+	return "p21" + p.mac("tag", top, req.get("call-id"))[:16]
+}
+
+// ---- header helpers ----
+
+// maxForwards decrements Max-Forwards; false means the request must not
+// be forwarded (483).
+func (p *sipProxy) maxForwards(m *sipMsg) bool {
+	v, ok := m.lookup("max-forwards")
+	if !ok {
+		m.hdrs = append(m.hdrs, sipHeader{name: "Max-Forwards", key: "max-forwards", value: "70"})
+		return true
+	}
+	n, err := strconv.Atoi(strings.TrimSpace(v))
+	if err != nil || n < 0 {
+		n = 70
+	}
+	if n == 0 {
+		return false
+	}
+	m.set("max-forwards", "Max-Forwards", strconv.Itoa(min(n-1, 255)))
+	return true
+}
+
+// noteSource adds received/rport to the top Via (RFC 3261 18.2.1, RFC 3581).
+func noteSource(m *sipMsg, src netip.AddrPort) (*sipVia, bool) {
+	top, _ := m.topValue("via")
+	v, ok := parseVia(top)
+	if !ok {
+		return nil, false
+	}
+	if hasParam(v.params, "rport") {
+		v.params = setParam(v.params, "rport", strconv.Itoa(int(src.Port())))
+	}
+	if a, ok := hostAddr(v.host); !ok || a != src.Addr() {
+		v.params = setParam(v.params, "received", src.Addr().String())
+	}
+	m.setTopValue("via", v.String())
+	return v, true
+}
+
+func (p *sipProxy) isOwnRoute(v string) bool {
+	u, ok := parseURI(parseNameAddr(v).uri)
+	return ok && u.isLoopback() && (u.port == 0 || u.port == p.sipPort)
+}
+
+func (p *sipProxy) rememberContact(user, uri string) {
+	if _, ok := p.contacts[user]; !ok && len(p.contacts) >= maxRememberedContact {
+		clear(p.contacts)
+	}
+	p.contacts[user] = uri
+}
+
+// contactsToUpstream points the calling library's Contact URIs at the
+// relay's private address (the transport parameter goes away: the
+// miniserver reaches us over UDP, or TCP for big messages).
+func (p *sipProxy) contactsToUpstream(m *sipMsg, register bool) {
+	m.mapValues("contact", func(v string) string {
+		if v == "*" {
+			return v
+		}
+		na := parseNameAddr(v)
+		u, ok := parseURI(na.uri)
+		if !ok {
+			return v
+		}
+		if register && !u.isLoopback() {
+			// Removal of a binding made outside the relay: leave it alone,
+			// it must not remove the relay's own binding.
+			if e, ok := paramValue(parseParams(na.params), "expires"); ok && strings.TrimSpace(e) == "0" {
+				return v
+			}
+		}
+		p.rememberContact(u.user, na.uri)
+		u.scheme = "sip"
+		u.host, u.port = p.localIP.String(), p.upPort
+		u.params = removeParam(u.params, "transport")
+		na.uri = u.String()
+		return na.String()
+	})
+}
+
+// clientURI turns a URI on the relay's private address into one the
+// calling library recognises as its own.
+func (p *sipProxy) clientURI(u *sipURI) string {
+	if orig, ok := p.contacts[u.user]; ok {
+		return orig
+	}
+	port := p.sipPort
+	if p.client != nil {
+		port = int(p.client.remote.Port())
+	}
+	u.scheme = "sip"
+	u.host, u.port = loopback4.String(), port
+	u.params = removeParam(removeParam(u.params, "transport"), "x-ast-orig-host")
+	u.params = append(u.params, sipParam{k: "transport", v: "tls", hasV: true})
+	return u.String()
+}
+
+// contactsToClient points the miniserver's Contact URIs at the relay.
+func (p *sipProxy) contactsToClient(m *sipMsg) {
+	m.mapValues("contact", func(v string) string {
+		if v == "*" {
+			return v
+		}
+		na := parseNameAddr(v)
+		u, ok := parseURI(na.uri)
+		if !ok {
+			return v
+		}
+		u.scheme = "sip"
+		u.host, u.port = loopback4.String(), p.sipPort
+		u.params = removeParam(u.params, "transport")
+		u.params = append(u.params, sipParam{k: "transport", v: "tls", hasV: true})
+		na.uri = u.String()
+		return na.String()
+	})
+}
+
+// registerContactsToClient maps the relay's bindings in a REGISTER
+// response back to the Contact the calling library sent; other bindings
+// of the account pass unchanged.
+func (p *sipProxy) registerContactsToClient(m *sipMsg) {
+	m.mapValues("contact", func(v string) string {
+		na := parseNameAddr(v)
+		u, ok := parseURI(na.uri)
+		if !ok || !u.isHost(p.localIP) {
+			return v
+		}
+		na.uri = p.clientURI(u)
+		return na.String()
+	})
+}
+
+// ---- media lifecycle ----
+
+func (p *sipProxy) mediaOnRequest(m *sipMsg, now time.Time) {
+	switch m.method {
+	case "BYE", "CANCEL":
+		p.media.scheduleRelease(m.get("call-id"), now.Add(mediaByeLinger))
+	}
+}
+
+func (p *sipProxy) mediaOnResponse(m *sipMsg, method string) {
+	callID := m.get("call-id")
+	switch {
+	case method == "BYE" && m.status >= 200 && m.status < 300:
+		p.media.release(callID, "bye")
+	case method == "INVITE" && m.status >= 200 && m.status < 300:
+		p.media.setEstablished(callID)
+	case method == "INVITE" && m.status >= 300:
+		if !p.media.established(callID) {
+			p.media.release(callID, "failed")
+		}
+	}
+}
+
+// rewriteBody anchors the media of an SDP body.
+func (p *sipProxy) rewriteBody(m *sipMsg, fromClient bool, now time.Time) error {
+	callID := m.get("call-id")
+	if m.isSDP() {
+		b, err := p.media.rewrite(callID, fromClient, m.body, now)
+		if err != nil {
+			return err
+		}
+		m.body = b
+	} else if ct := strings.ToLower(m.get("content-type")); strings.HasPrefix(ct, "multipart/") && strings.Contains(strings.ToLower(string(m.body)), "application/sdp") {
+		return errBadSDP // not supported; better fail than leak unanchored media
+	}
+	p.media.touch(callID, now)
+	return nil
+}
+
+// ---- calling library -> miniserver ----
+
+func (p *sipProxy) fromClient(data []byte, cc *clientConn) {
+	p.cnt.inc("sip.from_client")
+	m, err := parseSIP(data)
+	if err != nil || !m.valid() {
+		p.drop("client_malformed")
+		return
+	}
+	if m.isReq {
+		p.clientRequest(m, cc)
+	} else {
+		p.clientResponse(m)
+	}
+}
+
+func (p *sipProxy) clientRequest(m *sipMsg, cc *clientConn) {
+	now := time.Now()
+	cv, ok := noteSource(m, cc.remote)
+	if !ok {
+		p.drop("client_malformed")
+		return
+	}
+	if !p.maxForwards(m) {
+		if m.method != "ACK" {
+			p.replyClient(m, 483, "Too Many Hops")
+		}
+		p.drop("max_forwards")
+		return
+	}
+	for {
+		top, ok := m.topValue("route")
+		if !ok || !p.isOwnRoute(top) {
+			break
+		}
+		m.popTopValue("route")
+	}
+	if u, ok := parseURI(m.ruri); ok && u.isLoopback() {
+		u.scheme = "sip"
+		u.host, u.port = p.upstream.Addr().String(), int(p.upstream.Port())
+		u.params = removeParam(u.params, "transport")
+		m.ruri = u.String()
+	}
+	p.contactsToUpstream(m, m.method == "REGISTER")
+	if err := p.rewriteBody(m, true, now); err != nil {
+		if m.method != "ACK" {
+			p.replyClient(m, 488, "Not Acceptable Here")
+		}
+		p.drop("client_sdp")
+		return
+	}
+	p.mediaOnRequest(m, now)
+
+	branch := p.branch("c", cv.branch(), m)
+	via := &sipVia{transport: "UDP", host: p.localIP.String(), port: p.upPort, params: []sipParam{
+		{k: "branch", v: branch, hasV: true}, {k: "rport"},
+	}}
+	m.pushVia(via.String())
+	out := m.bytes()
+	// REGISTER always uses UDP: over TCP the miniserver would bind the
+	// registration to a short-lived connection port.
+	if len(out) > maxUDPRequest && m.method != "REGISTER" {
+		via.transport = "TCP"
+		m.setTopValue("via", via.String())
+		p.sendTCP(p.upstreamTCP(), m.bytes())
+		return
+	}
+	p.sendUDP(out, p.upstream)
+	switch m.method {
+	case "ACK":
+		if tx := p.txs["req|"+branch+"|INVITE"]; tx != nil {
+			tx.ack = out
+		}
+	default:
+		p.addTx("req|"+branch+"|"+m.method, &txEntry{
+			data: out, dest: p.upstream, invite: m.method == "INVITE",
+			next: now.Add(sipT1), interval: sipT1, expire: now.Add(sipTxTimeout),
+		})
+	}
+}
+
+func (p *sipProxy) clientResponse(m *sipMsg) {
+	now := time.Now()
+	top, _ := m.topValue("via")
+	v, ok := parseVia(top)
+	if !ok || v.host != loopback4.String() || v.port != p.sipPort || !strings.HasPrefix(v.branch(), branchPrefix) {
+		p.drop("via_not_ours")
+		return
+	}
+	conn, _ := paramValue(v.params, viaConnParam)
+	m.popTopValue("via")
+	next, ok := m.topValue("via")
+	if !ok {
+		p.drop("client_malformed")
+		return
+	}
+	nv, ok := parseVia(next)
+	if !ok {
+		p.drop("client_malformed")
+		return
+	}
+	num, method, _ := m.cseq()
+	p.contactsToUpstream(m, false)
+	if err := p.rewriteBody(m, true, now); err != nil {
+		p.drop("client_sdp")
+		return
+	}
+	p.mediaOnResponse(m, method)
+	out := m.bytes()
+
+	if conn != "" && conn != "u" {
+		id, _ := strconv.ParseUint(conn, 10, 64)
+		tc := p.tcps[id]
+		if tc == nil || tc.closed() {
+			tc = p.upstreamTCP() // RFC 3261 18.2.2: new connection to the sender
+		}
+		p.sendTCP(tc, out)
+		return
+	}
+	dst, ok := p.viaDest(nv)
+	if !ok {
+		p.drop("bad_response_destination")
+		return
+	}
+	p.sendUDP(out, dst)
+	if method == "INVITE" && m.status >= 200 {
+		// RFC 3261 13.3.1.4 / 17.2.1: repeat until the miniserver's ACK.
+		p.addTx(rspKey(m.get("call-id"), num), &txEntry{
+			data: out, dest: dst, response: true,
+			next: now.Add(sipT1), interval: sipT1, expire: now.Add(sipTxTimeout),
+		})
+	}
+}
+
+func rspKey(callID string, num uint32) string {
+	return "rsp|" + callID + "|" + strconv.FormatUint(uint64(num), 10)
+}
+
+// ---- miniserver -> calling library ----
+
+func (p *sipProxy) fromUpstream(data []byte, tc *tcpConn, src netip.AddrPort) {
+	p.cnt.inc("sip.from_upstream")
+	m, err := parseSIP(data)
+	if err != nil || !m.valid() {
+		p.drop("upstream_malformed")
+		return
+	}
+	if m.isReq {
+		p.upstreamRequest(m, tc, src)
+	} else {
+		p.upstreamResponse(m)
+	}
+}
+
+func (p *sipProxy) upstreamRequest(m *sipMsg, tc *tcpConn, src netip.AddrPort) {
+	now := time.Now()
+	uv, ok := noteSource(m, src)
+	if !ok {
+		p.drop("upstream_malformed")
+		return
+	}
+	callID := m.get("call-id")
+	num, _, _ := m.cseq()
+	switch m.method {
+	case "ACK":
+		delete(p.txs, rspKey(callID, num))
+	case "INVITE":
+		if tx := p.txs[rspKey(callID, num)]; tx != nil {
+			// Retransmitted INVITE: our final answer got lost, repeat it.
+			p.sendUDP(tx.data, tx.dest)
+			p.cnt.inc("sip.retransmit_answered")
+			return
+		}
+	}
+	if p.client == nil {
+		if m.method != "ACK" {
+			p.replyUpstream(m, 480, "Temporarily Unavailable", tc, src)
+		}
+		p.cnt.inc("sip.no_client")
+		return
+	}
+	if !p.maxForwards(m) {
+		if m.method != "ACK" {
+			p.replyUpstream(m, 483, "Too Many Hops", tc, src)
+		}
+		p.drop("max_forwards")
+		return
+	}
+	if u, ok := parseURI(m.ruri); ok && u.isHost(p.localIP) {
+		m.ruri = p.clientURI(u)
+	}
+	p.contactsToClient(m)
+	if err := p.rewriteBody(m, false, now); err != nil {
+		if m.method != "ACK" {
+			p.replyUpstream(m, 488, "Not Acceptable Here", tc, src)
+		}
+		p.drop("upstream_sdp")
+		return
+	}
+	p.mediaOnRequest(m, now)
+
+	conn := "u"
+	if tc != nil {
+		conn = strconv.FormatUint(tc.id, 10)
+	}
+	via := &sipVia{transport: "TLS", host: loopback4.String(), port: p.sipPort, params: []sipParam{
+		{k: "branch", v: p.branch("u", uv.branch(), m), hasV: true},
+		{k: viaConnParam, v: conn, hasV: true},
+	}}
+	m.pushVia(via.String())
+	p.sendClient(m.bytes())
+}
+
+func (p *sipProxy) upstreamResponse(m *sipMsg) {
+	now := time.Now()
+	top, _ := m.topValue("via")
+	v, ok := parseVia(top)
+	if !ok || v.host != p.localIP.String() || v.port != p.upPort || !strings.HasPrefix(v.branch(), branchPrefix) {
+		p.drop("via_not_ours")
+		return
+	}
+	_, method, _ := m.cseq()
+	if tx := p.txs["req|"+v.branch()+"|"+method]; tx != nil {
+		switch {
+		case m.status < 200 && tx.completed:
+			p.drop("late_provisional")
+			return
+		case m.status < 200:
+			if tx.invite {
+				tx.next = time.Time{}
+			} else {
+				tx.interval, tx.next = sipT2, now.Add(sipT2)
+			}
+		case !tx.completed:
+			tx.completed, tx.next, tx.expire = true, time.Time{}, now.Add(sipTxTimeout)
+		case tx.invite && m.status < 300:
+			// Repeated 2xx: pass on, the calling library acknowledges again.
+		case tx.invite:
+			if tx.ack != nil {
+				p.sendUDP(tx.ack, tx.dest)
+				p.cnt.inc("sip.ack_repeated")
+			}
+			p.cnt.inc("sip.duplicate_response")
+			return
+		default:
+			p.cnt.inc("sip.duplicate_response")
+			return
+		}
+	}
+	m.popTopValue("via")
+	if _, ok := m.topValue("via"); !ok {
+		p.drop("upstream_malformed")
+		return
+	}
+	if method == "REGISTER" {
+		p.registerContactsToClient(m)
+	} else {
+		p.contactsToClient(m)
+	}
+	// The relay is the only route; a service route would bypass it.
+	m.del("service-route")
+	if err := p.rewriteBody(m, false, now); err != nil {
+		p.drop("upstream_sdp")
+		return
+	}
+	p.mediaOnResponse(m, method)
+	p.sendClient(m.bytes())
+}
+
+// ---- retransmissions ----
+
+func (p *sipProxy) addTx(key string, tx *txEntry) {
+	if _, ok := p.txs[key]; !ok && len(p.txs) >= maxTxEntries {
+		p.cnt.inc("sip.tx_table_full")
+		return
+	}
+	p.txs[key] = tx
+}
+
+func (p *sipProxy) retransmit(now time.Time) {
+	for k, tx := range p.txs {
+		if !now.Before(tx.expire) {
+			delete(p.txs, k)
+			continue
+		}
+		if tx.next.IsZero() || now.Before(tx.next) {
+			continue
+		}
+		p.sendUDP(tx.data, tx.dest)
+		p.cnt.inc("sip.retransmit")
+		tx.interval *= 2
+		if !tx.invite && tx.interval > sipT2 {
+			tx.interval = sipT2
+		}
+		tx.next = now.Add(tx.interval)
+	}
+}
