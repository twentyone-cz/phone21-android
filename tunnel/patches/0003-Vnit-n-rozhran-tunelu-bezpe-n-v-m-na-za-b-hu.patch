diff --git a/libtailscale/internaltun/tun_test.go b/libtailscale/internaltun/tun_test.go
new file mode 100644
index 0000000..50fc396
--- /dev/null
+++ b/libtailscale/internaltun/tun_test.go
@@ -0,0 +1,248 @@
+// Copyright (c) Phone21
