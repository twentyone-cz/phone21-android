+
+package internaltun
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"os"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/tailscale/wireguard-go/tun"
+)
+
+var (
+	phoneV4  = netip.MustParseAddr("100.64.0.4")
+	phoneV6  = netip.MustParseAddr("fd7a:115c:a1e0::4")
+	serverV4 = netip.MustParseAddr("100.64.0.1")
+	serverV6 = netip.MustParseAddr("fd7a:115c:a1e0::1")
+)
+
+// pump copies packets read from src into dst until src is closed.
+func pump(t *testing.T, src, dst tun.Device, wg *sync.WaitGroup) {
+	defer wg.Done()
+	slab := make([]byte, 2*tun.ReadPacketSpacing+65535)
+	packets := make([]tun.ReadPacket, src.BatchSize())
+	for {
+		n, err := src.Read(slab, packets)
+		if err != nil {
+			if !errors.Is(err, os.ErrClosed) {
+				t.Errorf("Read: %v", err)
+			}
+			return
+		}
+		for _, p := range packets[:n] {
+			buf := make([]byte, p.Size)
+			copy(buf, slab[p.Offset:p.Offset+p.Size])
+			if _, err := dst.Write([][]byte{buf}, 0); err != nil && !errors.Is(err, os.ErrClosed) {
+				t.Errorf("Write: %v", err)
+			}
+		}
+	}
+}
+
+// backToBack returns two in-process interfaces whose packets are wired to
+// each other, like a phone and a miniserver on the private network.
+func backToBack(t *testing.T) (phone, server *Net) {
+	t.Helper()
+	devA, netA, err := CreateNetTUN([]netip.Addr{phoneV4, phoneV6}, nil, 1280)
+	if err != nil {
+		t.Fatal(err)
+	}
+	devB, netB, err := CreateNetTUN([]netip.Addr{serverV4, serverV6}, nil, 1280)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go pump(t, devA, devB, &wg)
+	go pump(t, devB, devA, &wg)
+	t.Cleanup(func() {
+		devA.Close()
+		devB.Close()
+		wg.Wait()
+	})
+	return netA, netB
+}
+
+func TestUDPBackToBack(t *testing.T) {
+	phone, server := backToBack(t)
+	for _, tc := range []struct {
+		name        string
+		local, peer netip.Addr
+	}{
+		{"v4", phoneV4, serverV4},
+		{"v6", phoneV6, serverV6},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			srv, err := server.ListenUDPAddrPort(netip.AddrPortFrom(tc.peer, 5060))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer srv.Close()
+			cli, err := phone.ListenUDPAddrPort(netip.AddrPortFrom(tc.local, 0))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer cli.Close()
+
+			msg := []byte("OPTIONS sip:test@100.64.0.1 SIP/2.0\r\n\r\n")
+			if _, err := cli.WriteTo(msg, net.UDPAddrFromAddrPort(netip.AddrPortFrom(tc.peer, 5060))); err != nil {
+				t.Fatal(err)
+			}
+			srv.SetDeadline(time.Now().Add(5 * time.Second))
+			buf := make([]byte, 1500)
+			n, from, err := srv.ReadFrom(buf)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(buf[:n], msg) {
+				t.Fatalf("server got %q", buf[:n])
+			}
+			fromAP := from.(*net.UDPAddr).AddrPort()
+			if fromAP.Addr().Unmap() != tc.local {
+				t.Fatalf("source = %v, want %v", fromAP, tc.local)
+			}
+			if _, err := srv.WriteTo([]byte("pong"), from); err != nil {
+				t.Fatal(err)
+			}
+			cli.SetDeadline(time.Now().Add(5 * time.Second))
+			n, _, err = cli.ReadFrom(buf)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if string(buf[:n]) != "pong" {
+				t.Fatalf("client got %q", buf[:n])
+			}
+		})
+	}
+}
+
+func TestTCPBackToBack(t *testing.T) {
+	phone, server := backToBack(t)
+	for _, tc := range []struct {
+		name string
+		peer netip.Addr
+	}{
+		{"v4", serverV4},
+		{"v6", serverV6},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ln, err := server.ListenTCPAddrPort(netip.AddrPortFrom(tc.peer, 80))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer ln.Close()
+			go func() {
+				c, err := ln.Accept()
+				if err != nil {
+					return
+				}
+				defer c.Close()
+				io.Copy(c, c) // echo
+			}()
+
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			c, err := phone.DialContextTCPAddrPort(ctx, netip.AddrPortFrom(tc.peer, 80))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.Close()
+			c.SetDeadline(time.Now().Add(5 * time.Second))
+			// Larger than one MTU to exercise segmentation.
+			msg := bytes.Repeat([]byte("0123456789abcdef"), 1000)
+			go c.Write(msg)
+			got := make([]byte, len(msg))
+			if _, err := io.ReadFull(c, got); err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(got, msg) {
+				t.Fatal("echo mismatch")
+			}
+		})
+	}
+}
+
+func TestClose(t *testing.T) {
+	dev, n, err := CreateNetTUN([]netip.Addr{phoneV4}, nil, 1280)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if e := <-dev.Events(); e != tun.EventUp {
+		t.Fatalf("first event = %v, want EventUp", e)
+	}
+	ln, err := n.ListenTCPAddrPort(netip.AddrPortFrom(phoneV4, 5061))
+	if err != nil {
+		t.Fatal(err)
+	}
+	acceptErr := make(chan error, 1)
+	go func() {
+		_, err := ln.Accept()
+		acceptErr <- err
+	}()
+	readErr := make(chan error, 1)
+	go func() {
+		slab := make([]byte, 2*tun.ReadPacketSpacing+1500)
+		_, err := dev.Read(slab, make([]tun.ReadPacket, 1))
+		readErr <- err
+	}()
+	time.Sleep(50 * time.Millisecond)
+
+	if err := dev.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := dev.Close(); err != nil { // idempotent
+		t.Fatal(err)
+	}
+	select {
+	case err := <-readErr:
+		if !errors.Is(err, os.ErrClosed) {
+			t.Fatalf("Read after Close = %v, want os.ErrClosed", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("Read did not return after Close")
+	}
+	select {
+	case err := <-acceptErr:
+		if err == nil {
+			t.Fatal("Accept succeeded after Close")
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("Accept did not return after Close")
+	}
+	if _, err := dev.Write([][]byte{{0x45, 0}}, 0); !errors.Is(err, os.ErrClosed) {
+		t.Fatalf("Write after Close = %v, want os.ErrClosed", err)
+	}
+	if _, ok := <-dev.Events(); ok {
+		t.Fatal("events channel not closed")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if c, err := n.DialContextTCPAddrPort(ctx, netip.AddrPortFrom(serverV4, 80)); err == nil {
+		c.Close()
+		t.Fatal("dial on closed interface succeeded")
+	}
+}
+
+func TestNoAddresses(t *testing.T) {
+	// No addresses: device is created but has no route; dialing fails fast.
+	dev, n, err := CreateNetTUN(nil, nil, 1280)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer dev.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if c, err := n.DialContextTCPAddrPort(ctx, netip.AddrPortFrom(serverV4, 80)); err == nil {
+		c.Close()
+		t.Fatal("dial without addresses succeeded")
+	}
+}
