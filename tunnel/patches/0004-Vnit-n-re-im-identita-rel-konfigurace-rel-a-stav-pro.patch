+func TestInterfaceReplacedWhileStarting(t *testing.T) {
+	fs := &fakeStarter{}
+	s := NewState(fs.start, t.Logf)
+	s.Install(nil, phoneAddr)
+	fs.during = func() { s.Invalidate("gone during start") }
+	if _, err := s.StartRelay(p21relay.Config{}); !errors.Is(err, ErrNotUp) {
+		t.Fatalf("err = %v", err)
+	}
+	if !fs.relays[0].closed.Load() || s.Status().Relay {
+		t.Fatal("relay started on a vanished interface stays running")
+	}
+}
