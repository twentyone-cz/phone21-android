+func TestStatusJSONShape(t *testing.T) {
+	s := NewState((&fakeStarter{}).start, t.Logf)
+	s.SetRequested(true)
+	s.SetVPNService(true)
+	s.SetLeftoverFunc(func() int { return 2 })
+	var m map[string]any
+	if err := json.Unmarshal([]byte(s.StatusJSON()), &m); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]any{
+		"requested":       true,
+		"up":              false,
+		"addr":            "",
+		"generation":      float64(0),
+		"relay":           false,
+		"error":           "",
+		"vpnService":      true,
+		"leftoverSockets": float64(2),
+	}
+	if len(m) != len(want) {
+		t.Fatalf("keys: got %v", m)
+	}
+	for k, v := range want {
+		if m[k] != v {
+			t.Errorf("%s = %v, want %v", k, m[k], v)
+		}
+	}
+}
+
+func TestStateConcurrent(t *testing.T) {
+	fs := &fakeStarter{}
+	s := NewState(fs.start, func(string, ...any) {})
+	var wg sync.WaitGroup
+	stop := make(chan struct{})
+	wg.Add(3)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 200; i++ {
+			s.Install(nil, phoneAddr)
+			if i%3 == 0 {
+				s.Invalidate("test")
+			}
+		}
+		close(stop)
+	}()
+	go func() {
+		defer wg.Done()
+		for {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			s.StartRelay(p21relay.Config{})
+			s.RelayStats()
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			s.StatusJSON()
+		}
+	}()
+	wg.Wait()
+	s.Invalidate("end")
+	// Every relay except possibly none is closed eventually.
+	waitFor(t, "all relays closed", func() bool {
+		fs.mu.Lock()
+		defer fs.mu.Unlock()
+		for _, r := range fs.relays {
+			if !r.closed.Load() {
+				return false
+			}
+		}
+		return true
+	})
+}
