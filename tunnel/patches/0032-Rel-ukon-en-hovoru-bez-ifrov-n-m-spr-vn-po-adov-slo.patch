 			if m.method != "ACK" {
@@ -1109,7 +1109,7 @@ func (p *sipProxy) clientResponse(m *sipMsg) {
 				p.refuseInsecureAnswer(m, d, num, conn, nv, now)
 				return
 			}
-			defer p.endCall(d, true, now)
+			defer p.endCall(d, true, num, now)
 		}
 	}
 	p.mediaOnResponse(m, method)
@@ -1185,14 +1185,22 @@ func (p *sipProxy) refuseInsecureAnswer(m *sipMsg, d dialogRef, num uint32, conn
 	}
 	ack := p.localRequest("ACK", p.clientTarget(d), p.localVia(true, d.callID, "ACK", num), d.upParty, d.cliParty, d.callID, num)
 	p.sendClient(ack.bytes())
-	p.endCall(d, established, now)
+	// INVITE bez SDP hovor v relé nezaložil, takže jeho CSeq nikde není.
+	p.endCall(d, established, num, now)
 }
 
 // endCall ukončí hovor bez šifrování hlasu: BYE knihovně a případně
 // ústředně (odpovědi na ně relé zachytí), a uvolní jeho hlas.
