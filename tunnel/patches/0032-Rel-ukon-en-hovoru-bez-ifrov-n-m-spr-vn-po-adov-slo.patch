diff --git a/libtailscale/p21relay/srtpcall_test.go b/libtailscale/p21relay/srtpcall_test.go
index 390fc9d..ea074a3 100644
--- a/libtailscale/p21relay/srtpcall_test.go
+++ b/libtailscale/p21relay/srtpcall_test.go
@@ -471,6 +471,36 @@ func TestSRTPInsecureAnswerIncoming(t *testing.T) {
 	}
 }
 
+// INVITE ústředny bez SDP (nabídka až v 200 knihovny) a knihovna nabídne
+// bez šifrování: BYE ke knihovně musí mít CSeq nad INVITE ústředny, jinak ho
+// knihovna jako požadavek mimo pořadí odmítne a hovor bez hlasu jí zůstane.
+func TestSRTPInsecureAnswerLateOfferByeCSeq(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+	register(t, e, c)
+	cl := newCall(t, "late-", 0)
+	inv := strings.Replace(incomingInvite(t, e, cl.callID, 24567, cl.mediaPath.up.port), "Content-Type: application/sdp\r\n", "", 1)
+	inv = inv[:strings.Index(inv, "Content-Length: ")] + "Content-Length: 0\r\n\r\n"
+	e.up.sendUDP(e.privSIP(), inv)
+	ci := c.expectRequest("INVITE")
+	if len(ci.body) != 0 {
+		t.Fatalf("INVITE without SDP got a body:\n%s", ci.body)
+	}
+	c.send(responseText(ci, 200, "OK", "cli-tag", []string{"Contact: <" + c.contact() + ">"}, sdpBody("127.0.0.1", cl.cli.port)))
+
+	e.up.expectResponse(488, "INVITE")
+	if ack := c.expectRequest("ACK"); ack.get("cseq") != "24567 ACK" {
+		t.Fatalf("ACK to the client: CSeq %q", ack.get("cseq"))
+	}
+	bye := c.expectRequest("BYE")
+	if bye.get("cseq") != "24568 BYE" || !strings.Contains(bye.get("reason"), "cause=488") {
+		t.Fatalf("BYE to the client: CSeq %q, Reason %q", bye.get("cseq"), bye.get("reason"))
+	}
+	c.send(responseText(bye, 200, "OK", "cli-tag", nil, ""))
+	waitFor(t, func() bool { return e.counter("sip.local_answered") == 1 })
+	e.up.expectNothing()
+}
+
