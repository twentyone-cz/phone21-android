 func newMediaManager(nw Network, upIP netip.Addr, cnt *counters, log *rateLog) *mediaManager {
@@ -639,6 +640,13 @@ func (mm *mediaManager) pump(st *mediaStream, in, out net.PacketConn, toUp, rtcp
 				mm.dropClientSrc.Add(1)
 				continue
 			}
+			if isSTUN(pkt) {
+				// Knihovna bez ICE posílá zkušební STUN „pro otevření
+				// firewallu“, na portu RTCP dokud nepřijde RTCP. Ústředně
+				// k ničemu není a nejde o poškozený paket.
+				mm.stunFromClient.Add(1)
+				continue
+			}
 			plain, res := st.recv.open(work, pkt, rtcpSock, time.Now())
 			if !mm.countOpen(res) {
 				continue
@@ -860,6 +868,7 @@ func (mm *mediaManager) stats() map[string]int64 {
 		"srtpSealError":      mm.srtpSealErr.Load(),
