+	for _, c := range mm.calls {
+		calls = append(calls, c)
+	}
 	mm.calls = make(map[string]*mediaCall)
 	mm.nstreams = 0
+	hold := mm.holdFor
 	mm.mu.Unlock()
-	for _, c := range calls {
-		for _, s := range c.streams {
-			s.close()
-		}
-	}
+	mm.retire(calls, hold)
 	mm.wg.Wait()
 }
 
@@ -415,6 +532,7 @@ func (mm *mediaManager) stats() map[string]int64 {
 		"dropForeignNetwork": mm.dropUpSrc.Load(),
 		"dropNoDestination":  mm.dropNoDest.Load(),
 		"writeErrors":        mm.writeErrors.Load(),
+		"clientPortsHeld":    int64(heldPorts.count()),
 	}
