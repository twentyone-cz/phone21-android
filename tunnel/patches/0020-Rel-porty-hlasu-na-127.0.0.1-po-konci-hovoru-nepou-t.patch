@@ -90,6 +190,7 @@ type mediaManager struct {
 	calls    map[string]*mediaCall
 	nstreams int
 	closed   bool
+	holdFor  time.Duration // clientPortHold; tests shorten it
 
 	pktToUp, pktToClient     atomic.Int64
 	bytesToUp, bytesToClient atomic.Int64
@@ -105,6 +206,7 @@ func newMediaManager(nw Network, upIP netip.Addr, cnt *counters, log *rateLog) *
 		cnt:     cnt,
 		log:     log,
 		calls:   make(map[string]*mediaCall),
+		holdFor: clientPortHold,
 	}
 }
 
@@ -322,16 +424,29 @@ func (mm *mediaManager) release(callID, reason string) {
 		delete(mm.calls, callID)
 		mm.nstreams -= len(c.streams)
 	}
+	hold := mm.holdFor
 	mm.mu.Unlock()
 	if c == nil {
 		return
 	}
-	for _, s := range c.streams {
-		s.close()
-	}
+	mm.retire([]*mediaCall{c}, hold)
 	mm.cnt.inc("media.released_" + reason)
 }
 
+// retire stops the calls' streams and hands their 127.0.0.1 pairs to
+// heldPorts.
+func (mm *mediaManager) retire(calls []*mediaCall, hold time.Duration) {
+	var held []net.PacketConn
+	for _, c := range calls {
+		for _, s := range c.streams {
+			held = append(held, s.retire()...)
+		}
+	}
+	if n := heldPorts.add(held, hold); n > 0 {
+		mm.cnt.add("media.hold_evicted", int64(n))
+	}
+}
+
 // expire releases calls whose time is up and returns the next deadline
 // (zero when there are no calls).
