 	now := time.Now()
@@ -75,15 +76,75 @@ func TestMediaManagerAnchoring(t *testing.T) {
 		t.Fatalf("counts %d %d", calls, streams)
 	}
 
-	// Release closes the ports.
+	// Release gives the private ports back at once and keeps the
+	// 127.0.0.1 ones bound for a while, without forwarding anything.
 	mm.release("c1", "test")
 	if _, streams := mm.counts(); streams != 0 {
 		t.Fatal("not released")
 	}
-	if c, err := net.ListenUDP("udp4", net.UDPAddrFromAddrPort(rc)); err != nil {
-		t.Fatalf("client-side port still bound: %v", err)
-	} else {
-		c.Close()
+	expectBindable(t, ru, true)
+	expectBindable(t, netip.AddrPortFrom(privIP, uint16(relayU+1)), true)
+	expectBindable(t, rc, false)
+	expectBindable(t, netip.AddrPortFrom(loopback4, uint16(relayC+1)), false)
+	cli.rtp.WriteToUDPAddrPort([]byte("after-release"), rc)
+	expectNoPacket(t, up.rtp)
+	waitFor(t, func() bool { return canBind(rc) && canBind(netip.AddrPortFrom(loopback4, uint16(relayC+1))) })
+}
+
+func canBind(ap netip.AddrPort) bool {
+	c, err := net.ListenUDP("udp4", net.UDPAddrFromAddrPort(ap))
+	if err != nil {
+		return false
+	}
+	c.Close()
+	return true
+}
+
+func expectBindable(t *testing.T, ap netip.AddrPort, want bool) {
+	t.Helper()
+	if got := canBind(ap); got != want {
+		t.Fatalf("port %v bindable=%v, want %v", ap, got, want)
+	}
+}
+
+func TestPortHoldLimit(t *testing.T) {
+	var h portHold
+	open := func() []net.PacketConn {
+		a, b, _, err := listenPair(func(p int) (net.PacketConn, error) {
+			return net.ListenUDP("udp4", net.UDPAddrFromAddrPort(netip.AddrPortFrom(loopback4, uint16(p))))
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return []net.PacketConn{a, b}
+	}
+	first := open()
+	firstAddr := addrPortOf(first[0].LocalAddr())
+	if n := h.add(first, time.Hour); n != 0 {
+		t.Fatalf("evicted %d", n)
+	}
+	var last []net.PacketConn
+	evicted := 0
+	for i := 0; i < maxHeldSockets/2; i++ {
+		last = open()
+		evicted += h.add(last, time.Hour)
+	}
+	// One pair over the limit: the oldest went back early.
+	if evicted != 2 || h.count() != maxHeldSockets || !canBind(firstAddr) {
+		t.Fatalf("evicted %d, held %d, oldest bindable %v", evicted, h.count(), canBind(firstAddr))
+	}
+	if canBind(addrPortOf(last[0].LocalAddr())) {
+		t.Fatal("newest pair given back")
+	}
+	h.mu.Lock()
+	batches := append([]*heldBatch(nil), h.batches...)
+	h.mu.Unlock()
+	for _, b := range batches {
+		b.timer.Stop()
+		h.expire(b)
+	}
+	if h.count() != 0 {
+		t.Fatalf("held %d after expiry", h.count())
 	}
 }
 
