 }
 
-func (s *mediaStream) close() {
-	s.closeOnce.Do(func() {
-		s.cRTP.Close()
-		s.cRTCP.Close()
+// retire ends forwarding: the private pair is closed, the pumps stop, and
+// the 127.0.0.1 pair is returned still bound, for heldPorts.
+func (s *mediaStream) retire() []net.PacketConn {
+	var held []net.PacketConn
+	s.retireOnce.Do(func() {
 		s.uRTP.Close()
 		s.uRTCP.Close()
+		// Wake the pumps reading the client side without giving the
+		// ports up; the other two stop with the private sockets.
+		now := time.Now()
+		s.cRTP.SetReadDeadline(now)
+		s.cRTCP.SetReadDeadline(now)
+		held = []net.PacketConn{s.cRTP, s.cRTCP}
 	})
+	return held
+}
+
+// heldPorts keeps the 127.0.0.1 pairs of finished streams bound for a
+// while. The calling library keeps sending the microphone to such a port
+// until it learns that the call ended or moved (BYE, re-INVITE, or its
+// no-RTP timeout), also when the relay was stopped during a call. Another
+// app that bound a port given back too early would hear the microphone,
+// and the library would play what that app sends from it, because it comes
+// from the address the library expects. Held sockets are not read; the
+// kernel drops what does not fit their (shrunk) buffer. The hold is
+// package-wide, so it outlives Relay.Close, and a new relay simply gets
+// other ports.
+var heldPorts portHold
+
+type heldBatch struct {
+	conns []net.PacketConn
+	timer *time.Timer
+}
+
+type portHold struct {
+	mu      sync.Mutex
+	batches []*heldBatch // oldest first
+	n       int          // sockets held
+}
+
+// add holds conns for d. Above maxHeldSockets the oldest batches are given
+// back early; add returns how many sockets that were.
+func (h *portHold) add(conns []net.PacketConn, d time.Duration) (evicted int) {
+	if len(conns) == 0 {
+		return 0
+	}
+	for _, c := range conns {
+		if u, ok := c.(interface{ SetReadBuffer(int) error }); ok {
+			u.SetReadBuffer(1) // the kernel rounds up to its minimum
+		}
+	}
+	b := &heldBatch{conns: conns}
+	h.mu.Lock()
+	h.batches = append(h.batches, b)
+	h.n += len(conns)
+	var drop []*heldBatch
+	for h.n > maxHeldSockets && len(h.batches) > 1 {
+		old := h.batches[0]
+		h.batches = h.batches[1:]
+		h.n -= len(old.conns)
+		drop = append(drop, old)
+	}
+	// Set under the lock: expire needs the lock, so it cannot run before.
+	b.timer = time.AfterFunc(d, func() { h.expire(b) })
+	h.mu.Unlock()
+	for _, old := range drop {
+		old.timer.Stop()
+		closeConns(old.conns)
+		evicted += len(old.conns)
+	}
+	return evicted
+}
+
+func (h *portHold) expire(b *heldBatch) {
+	h.mu.Lock()
+	found := false
+	for i, x := range h.batches {
+		if x == b {
+			h.batches = append(h.batches[:i], h.batches[i+1:]...)
+			h.n -= len(b.conns)
+			found = true
+			break
+		}
+	}
+	h.mu.Unlock()
+	if found {
+		closeConns(b.conns)
+	}
+}
+
+func (h *portHold) count() int {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return h.n
+}
+
+func closeConns(conns []net.PacketConn) {
+	for _, c := range conns {
+		c.Close()
+	}
 }
 
