+// Stopping the relay during a call must not hand the call's 127.0.0.1
+// ports to another app: the calling library keeps sending the microphone
+// there until it notices that the call is gone.
+func TestCloseHoldsClientMediaPorts(t *testing.T) {
+	e := newEnv(t)
+	e.relay.media.mu.Lock()
+	e.relay.media.holdFor = 500 * time.Millisecond
+	e.relay.media.mu.Unlock()
+	c := newFakeClient(t, e)
+	cl := establishOutgoing(t, e, c)
+	e.relay.Close()
+
+	for _, ap := range []netip.AddrPort{cl.relayClientRTP(), cl.relayClientRTCP()} {
+		if canBind(ap) {
+			t.Fatalf("another app could bind %v after Close", ap)
+		}
+	}
+	for _, ap := range []netip.AddrPort{cl.relayPrivRTP(), cl.relayPrivRTCP()} {
+		if !canBind(ap) {
+			t.Fatalf("private port %v still bound after Close", ap)
+		}
+	}
+	cl.cli.rtp.WriteToUDPAddrPort([]byte("mic-audio"), cl.relayClientRTP())
+	expectNoPacket(t, cl.up.rtp)
+	if e.mediaStat("clientPortsHeld") < 2 {
+		t.Fatalf("held %d", e.mediaStat("clientPortsHeld"))
+	}
+	waitFor(t, func() bool { return canBind(cl.relayClientRTP()) && canBind(cl.relayClientRTCP()) })
+}
+
