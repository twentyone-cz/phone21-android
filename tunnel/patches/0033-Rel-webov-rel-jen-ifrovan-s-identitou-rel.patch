+// pinnedTLS věří jako appka jen přesně certifikátu relé: žádná CA, žádné
+// jméno, porovnává se zakódovaný certifikát.
+func pinnedTLS(c testCert) *tls.Config {
+	der := c.tls.Certificate[0]
+	return &tls.Config{
+		InsecureSkipVerify: true, // ověřuje VerifyConnection, ta běží i tak
+		MinVersion:         tls.VersionTLS12,
+		VerifyConnection: func(cs tls.ConnectionState) error {
+			if len(cs.PeerCertificates) == 0 || !bytes.Equal(cs.PeerCertificates[0].Raw, der) {
+				return errors.New("not the relay's certificate")
+			}
+			return nil
+		},
+	}
+}
+
+// relayClient mluví s relé jen přes TLS s certifikátem relé.
+func relayClient(c testCert) *http.Client {
+	return &http.Client{Transport: &http.Transport{Proxy: nil, TLSClientConfig: pinnedTLS(c)}, Timeout: 10 * time.Second}
+}
+
+// dialRelayTLS otevře na port relé spojení TLS s ověřeným certifikátem.
