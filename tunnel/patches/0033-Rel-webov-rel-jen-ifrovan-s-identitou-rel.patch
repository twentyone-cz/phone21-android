+// httpTLSConfig: TLS 1.2 a novější se serverovou identitou relé, stejné
+// sady jako pro SIP. Bez ALPN, tedy jen HTTP/1.1.
+func httpTLSConfig(cert tls.Certificate) *tls.Config {
+	return &tls.Config{
+		Certificates: []tls.Certificate{cert},
+		MinVersion:   tls.VersionTLS12,
+		CipherSuites: relayCipherSuites,
+	}
+}
+
+// httpsListener udělá z každého přijatého spojení serverovou stranu TLS.
+// Navázání běží až v gorutině HTTP serveru pro to spojení (omezené
+// ReadHeaderTimeout), ne v Accept.
+type httpsListener struct {
+	net.Listener
+	conf *tls.Config
+	cnt  *counters
+}
+
+func (l httpsListener) Accept() (net.Conn, error) {
+	c, err := l.Listener.Accept()
+	if err != nil {
+		return nil, err
+	}
+	return &httpsConn{Conn: tls.Server(c, l.conf), cnt: l.cnt}, nil
+}
+
+// httpsConn je spojení TLS, jak ho vidí HTTP server. Neúspěšné navázání
+// spojení ukončí bez jediného bajtu odpovědi: s původní chybou TLS by HTTP
+// server klientovi, který mluví nešifrovaně, odpověděl nešifrovaným
+// „400 … HTTPS server“, a nic na tomto portu nešifrovaně neodpovídá.
+type httpsConn struct {
+	*tls.Conn
+	cnt *counters
+}
+
+func (c *httpsConn) HandshakeContext(ctx context.Context) error {
+	if err := c.Conn.HandshakeContext(ctx); err != nil {
+		c.cnt.inc("http.tls_failed")
+		return errHTTPHandshake
+	}
+	return nil
+}
