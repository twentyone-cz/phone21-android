+		t.Fatalf("miniserver got %d plain requests", n)
+	}
+	if n := e.cnt.get("http.requests"); n != 0 {
+		t.Fatalf("relay handled %d plain requests", n)
+	}
+	if e.cnt.get("http.tls_failed") == 0 {
+		t.Fatal("failed handshakes not counted")
+	}
+
+	// Šifrovaně se stejným tokenem projde.
+	r2, _ := http.NewRequest("GET", e.url("/"+upAddr+"/x"), nil)
+	r2.Header.Set(TokenHeader, e.token)
+	resp, err := relayClient(e.cert).Do(r2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, _ := io.ReadAll(resp.Body)
+	resp.Body.Close()
+	if resp.StatusCode != 200 || string(body) != "ok" || hits.Load() != 1 {
+		t.Fatalf("over TLS: %d %q, miniserver hits %d", resp.StatusCode, body, hits.Load())
+	}
+}
+
+// Šifrování relé: serverová identita relé, nejméně TLS 1.2, bez HTTP/2.
+// Klient, který čeká jiný certifikát (jako appka, když port obsadil někdo
+// jiný), spojení nenaváže a nic nepošle.
+func TestHTTPRelayTLS(t *testing.T) {
+	var hits atomic.Int32
+	_, upAddr := newHTTPUpstream(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+	}))
+	e := newTestHTTPRelay(t, upIP)
+
+	c := dialRelayTLS(t, e.addr(), e.cert)
+	cs := c.ConnectionState()
+	if !bytes.Equal(cs.PeerCertificates[0].Raw, e.cert.tls.Certificate[0]) || cs.Version < tls.VersionTLS12 {
+		t.Fatalf("certificate or version %x not the relay's", cs.Version)
+	}
+	c.Close()
+
+	h2 := pinnedTLS(e.cert)
+	h2.NextProtos = []string{"h2", "http/1.1"}
+	if c, err := tls.DialWithDialer(&net.Dialer{Timeout: waitLong}, "tcp4", e.addr(), h2); err != nil {
+		t.Fatal(err)
+	} else {
+		if p := c.ConnectionState().NegotiatedProtocol; p == "h2" {
+			t.Fatal("relay negotiated HTTP/2")
+		}
+		c.Close()
+	}
+
+	old := pinnedTLS(e.cert)
+	old.MinVersion, old.MaxVersion = tls.VersionTLS10, tls.VersionTLS11
+	if c, err := tls.DialWithDialer(&net.Dialer{Timeout: waitLong}, "tcp4", e.addr(), old); err == nil {
+		c.Close()
+		t.Fatal("relay accepted TLS 1.1")
+	}
+
+	other := makeCert(t, "relay")
+	req, _ := http.NewRequest("GET", e.url("/"+upAddr+"/x"), nil)
+	req.Header.Set(TokenHeader, e.token)
+	if resp, err := relayClient(other).Do(req); err == nil {
+		resp.Body.Close()
+		t.Fatal("client pinned to another certificate got through")
+	}
+	if hits.Load() != 0 || e.cnt.get("http.requests") != 0 {
+		t.Fatalf("request sent despite a certificate mismatch (miniserver %d, relay %d)", hits.Load(), e.cnt.get("http.requests"))
+	}
+}
