+		var ne net.Error
+		if errors.As(err, &ne) && ne.Timeout() {
+			t.Fatalf("%q: connection left open", line)
+		}
+		if len(got) != 0 {
+			t.Fatalf("%q: relay answered in plain text: %q", line, got)
+		}
+	}
+	// Totéž běžným klientem: žádná odpověď.
+	req, _ := http.NewRequest("GET", "http://"+e.addr()+"/"+upAddr+"/x", nil)
+	req.Header.Set(TokenHeader, e.token)
+	if resp, err := (&http.Client{Transport: &http.Transport{Proxy: nil}, Timeout: waitLong}).Do(req); err == nil {
+		resp.Body.Close()
