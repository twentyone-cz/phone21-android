+
+// Nešifrovaný požadavek na port relé neprojde, ani se správným tokenem,
+// a nedostane žádnou odpověď (ani „400 … HTTPS server“): spojení se
+// zavře bez jediného bajtu a k miniserveru nic nedojde.
+func TestHTTPRelayPlaintextRefused(t *testing.T) {
+	var hits atomic.Int32
+	_, upAddr := newHTTPUpstream(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		io.WriteString(w, "ok")
+	}))
+	e := newTestHTTPRelay(t, upIP)
+
+	for _, req := range []string{
+		fmt.Sprintf("GET /%s/x HTTP/1.1\r\nHost: 127.0.0.1\r\n%s: %s\r\n\r\n", upAddr, TokenHeader, e.token),
+		fmt.Sprintf("GET /%s/x HTTP/1.0\r\n\r\n", upAddr),
+		"PROPFIND / HTTP/1.1\r\nHost: x\r\n\r\n",
+	} {
+		c, err := net.Dial("tcp4", e.addr())
+		if err != nil {
+			t.Fatal(err)
+		}
+		c.Write([]byte(req))
+		c.SetReadDeadline(time.Now().Add(waitLong))
+		got, err := io.ReadAll(c)
+		c.Close()
