 // replacing a relay that is already running. cfgJSON:
 //
 //	{"upstreamSip":"100.64.0.1:5060","httpHosts":["100.64.0.1"],
-//	 "serverCertPem":"…","serverKeyPem":"…","clientCertPem":"…"}
+//	 "serverCertPem":"…","serverKeyPem":"…","clientCertPem":"…",
+//	 "sipPort":int,"httpPort":int,"privateSipPort":int}
 //
-// It returns {"sipPort":int,"httpPort":int,"httpToken":"…"} (p21relay.Info),
-// or an error when the internal mode is not up. The relay stops by itself
-// when the interface is replaced or closed (InternalStatus "relay" false).
+// The three ports are optional preferences (0 or absent = any free port; a
+// port that is taken is replaced by a free one). Pass the ports of the
+// previous result when restarting the relay (new generation, relay stopped):
+// the calling library's route to 127.0.0.1 and the miniserver's
+// registration binding on the private address then stay valid.
+//
+// It returns {"sipPort":int,"httpPort":int,"httpToken":"…","privateSipPort":int}
+// (p21relay.Info), or an error when the internal mode is not up. The relay
+// stops by itself when the interface is replaced or closed (InternalStatus
+// "relay" false).
 func StartRelay(cfgJSON string) (string, error) {
 	cfg, err := p21internal.ParseRelayConfig(cfgJSON)
 	if err != nil {
