 libtailscale/p21_export.go                | 16 ++++++--
 libtailscale/p21internal/relaycfg.go      | 29 ++++++++++++-
 libtailscale/p21internal/relaycfg_test.go | 50 +++++++++++++++++++++++
 3 files changed, 90 insertions(+), 5 deletions(-)

