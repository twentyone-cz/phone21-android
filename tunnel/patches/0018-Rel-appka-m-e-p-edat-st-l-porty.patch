 )
 
 func validRelayConfig(t *testing.T) map[string]any {
@@ -57,6 +59,48 @@ func TestParseRelayConfig(t *testing.T) {
 	if cfg.Logf != nil {
 		t.Error("Logf must be set by the caller")
 	}
+	if cfg.SIPPort != 0 || cfg.HTTPPort != 0 || cfg.PrivateSIPPort != 0 {
+		t.Errorf("ports without preference = %d/%d/%d, want any (0)", cfg.SIPPort, cfg.HTTPPort, cfg.PrivateSIPPort)
+	}
+}
+
+// The app restarts the relay with the ports the previous one reported, so
+// that the calling library's route and the miniserver's registration binding
+// stay valid.
+func TestParseRelayConfigPorts(t *testing.T) {
+	m := validRelayConfig(t)
+	m["sipPort"] = 40001
+	m["httpPort"] = 41001
+	m["privateSipPort"] = 65535
+	cfg, err := ParseRelayConfig(marshal(t, m))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.SIPPort != 40001 || cfg.HTTPPort != 41001 || cfg.PrivateSIPPort != 65535 {
+		t.Errorf("ports = %d/%d/%d", cfg.SIPPort, cfg.HTTPPort, cfg.PrivateSIPPort)
+	}
+
+	// The relay's own result carries the ports under the same names.
+	info, err := json.Marshal(p21relay.Info{SIPPort: 40002, HTTPPort: 41002, PrivateSIPPort: 5062})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var ports map[string]any
+	if err := json.Unmarshal(info, &ports); err != nil {
+		t.Fatal(err)
+	}
+	delete(ports, "httpToken")
+	m = validRelayConfig(t)
+	for k, v := range ports {
+		m[k] = v
+	}
+	cfg, err = ParseRelayConfig(marshal(t, m))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.SIPPort != 40002 || cfg.HTTPPort != 41002 || cfg.PrivateSIPPort != 5062 {
+		t.Errorf("ports from Info = %d/%d/%d", cfg.SIPPort, cfg.HTTPPort, cfg.PrivateSIPPort)
+	}
 }
 
