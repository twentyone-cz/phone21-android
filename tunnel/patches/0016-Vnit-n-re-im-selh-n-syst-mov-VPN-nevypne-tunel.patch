+	if internalState.SystemVPNFailed(err) {
+		log.Printf("internal: VPN failed, tunnel kept on for the internal mode")
+	} else {
+		mp := new(ipn.MaskedPrefs)
+		mp.WantRunning = false
+		mp.WantRunningSet = true
 
-	if _, localApiErr := a.EditPrefs(*mp); localApiErr != nil {
-		log.Printf("localapi edit prefs error %v", localApiErr)
+		if _, localApiErr := a.EditPrefs(*mp); localApiErr != nil {
+			log.Printf("localapi edit prefs error %v", localApiErr)
+		}
 	}
 
 	if b.devices.Down() {
