 	"net/netip"
 	"sync"
 	"sync/atomic"
@@ -110,6 +111,24 @@ func (s *State) SetVPNService(v bool) {
 	s.vpnService = v
 }
 
+// SystemVPNFailed is called when the system VpnService could not carry the
+// tunnel and is being closed. It reports whether the tunnel must stay on,
+// that is, the caller must not store WantRunning=false: true while the app
+// requests the internal mode, which takes the tunnel back right away (the
+// request outlives the system VPN, also when the VPN fails). The failure is
+// then recorded as the last error, until the in-process interface is up
+// again. False means no internal mode to return to; the caller turns the
+// tunnel off as before.
+func (s *State) SystemVPNFailed(err error) (keepRunning bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if !s.requested {
+		return false
+	}
+	s.lastErr = fmt.Sprintf("system VPN failed: %v", err)
+	return true
+}
+
 // SetError records the last internal-mode error ("" clears it).
 func (s *State) SetError(err error) {
 	s.mu.Lock()
diff --git a/libtailscale/p21internal/state_test.go b/libtailscale/p21internal/state_test.go
index a92248b..18cab7e 100644
--- a/libtailscale/p21internal/state_test.go
+++ b/libtailscale/p21internal/state_test.go
@@ -284,3 +284,42 @@ func TestStateConcurrent(t *testing.T) {
 		return true
 	})
 }
+
+// A system VPN that fails while the app still requests the internal mode
+// must not turn the tunnel off: the internal mode takes it back.
+func TestSystemVPNFailed(t *testing.T) {
+	s := NewState((&fakeStarter{}).start, func(string, ...any) {})
+	vpnErr := errors.New("VpnService not prepared")
+
+	// No internal mode requested: the tunnel is turned off as before.
+	if s.SystemVPNFailed(vpnErr) {
+		t.Fatal("keepRunning without an internal request")
+	}
+	if st := s.Status(); st.Error != "" {
+		t.Errorf("error recorded without an internal request: %q", st.Error)
+	}
+
+	// Requested (the system VPN won over it, then failed): keep running.
+	s.SetRequested(true)
+	s.SetVPNService(true)
+	if !s.SystemVPNFailed(vpnErr) {
+		t.Fatal("WantRunning=false would be stored while the internal mode is requested")
+	}
+	s.SetVPNService(false)
+	st := s.Status()
+	if !st.Requested || st.Up || st.Error != "system VPN failed: VpnService not prepared" {
+		t.Errorf("status after failure = %+v", st)
+	}
+
+	// The internal mode is back: a new generation, the failure is history.
+	s.Install(nil, phoneAddr)
+	if st := s.Status(); !st.Up || st.Error != "" {
+		t.Errorf("status after return = %+v", st)
+	}
+
+	// Withdrawn meanwhile: off as before.
+	s.SetRequested(false)
+	if s.SystemVPNFailed(vpnErr) {
+		t.Fatal("keepRunning after StopInternal")
+	}
+}
