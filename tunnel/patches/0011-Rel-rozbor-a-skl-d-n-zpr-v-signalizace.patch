index 0000000..dcf3b8f
--- /dev/null
+++ b/libtailscale/p21relay/sipmsg_test.go
@@ -0,0 +1,159 @@
+// Copyright (c) Phone21
+// SPDX-License-Identifier: BSD-3-Clause
+
+package p21relay
+
+import (
+	"io"
+	"strings"
+	"testing"
+)
+
+func TestParseCompactAndFolded(t *testing.T) {
+	raw := "INVITE sip:+420000000000@100.64.0.1 SIP/2.0\r\n" +
+		"v: SIP/2.0/UDP 100.64.0.1:5060;branch=z9hG4bKa, SIP/2.0/TCP 100.64.0.9;branch=z9hG4bKb\r\n" +
+		"VIA: SIP / 2.0 / TLS 127.0.0.1:5061 ;branch=z9hG4bKc\r\n" +
+		"f: <sip:test@100.64.0.1>;tag=1\r\n" +
+		"t: <sip:+420000000000@100.64.0.1>\r\n" +
+		"i: call-1\r\n" +
+		"CSeq: 1 INVITE\r\n" +
+		"m: \"Test, User\" <sip:test@127.0.0.1:5061;transport=tls>;expires=60,\r\n" +
+		"  <sip:test@127.0.0.2>\r\n" +
+		"Subject: folded\r\n\tline\r\n" +
+		"c: application/sdp\r\n" +
+		"l: 5\r\n" +
+		"\r\n" +
+		"v=0\r\nEXTRA"
+	m, err := parseSIP([]byte(raw))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !m.isReq || m.method != "INVITE" || !m.valid() {
+		t.Fatalf("bad parse: %+v", m)
+	}
+	if got := m.values("via"); len(got) != 3 || !strings.HasPrefix(got[2], "SIP / 2.0 / TLS") {
+		t.Fatalf("via values %q", got)
+	}
+	if got := m.values("contact"); len(got) != 2 || !strings.HasPrefix(got[0], "\"Test, User\"") {
+		t.Fatalf("contact values %q", got)
+	}
+	if m.get("subject") != "folded line" {
+		t.Fatalf("folding: %q", m.get("subject"))
+	}
+	if string(m.body) != "v=0\r\n" || !m.isSDP() {
+		t.Fatalf("body %q", m.body)
+	}
+	v, ok := parseVia(m.values("via")[2])
+	if !ok || v.transport != "TLS" || v.host != "127.0.0.1" || v.port != 5061 || v.branch() != "z9hG4bKc" {
+		t.Fatalf("via parse %+v", v)
+	}
+	m.popTopValue("via")
+	if top, _ := m.topValue("via"); !strings.Contains(top, "z9hG4bKb") {
+		t.Fatalf("pop: top %q", top)
+	}
+	m.pushVia("SIP/2.0/UDP 127.0.0.2:4000;branch=z9hG4bK-p21-x")
+	out := string(m.bytes())
+	if !strings.Contains(out, "Via: SIP/2.0/UDP 127.0.0.2:4000;branch=z9hG4bK-p21-x\r\nv: SIP/2.0/TCP") {
+		t.Fatalf("push order wrong:\n%s", out)
+	}
+	if !strings.Contains(out, "l: 5\r\n") {
+		t.Fatalf("content-length name/value not kept:\n%s", out)
+	}
+}
+
+func TestParseRejects(t *testing.T) {
+	bad := []string{
+		"",
+		"garbage\r\n\r\n",
+		"INVITE sip:a@b SIP/3.0\r\nCall-ID: x\r\n\r\n",
+		"SIP/2.0 99 Low\r\n\r\n",
+		"INVITE sip:a@b SIP/2.0\r\nno colon here\r\n\r\n",
+		"INVITE sip:a@b SIP/2.0\r\nContent-Length: 10\r\n\r\nshort",
+		"INVITE sip:a@b SIP/2.0\r\nContent-Length: -1\r\n\r\n",
+		" folded first\r\n\r\n",
+	}
+	for _, s := range bad {
+		if _, err := parseSIP([]byte(s)); err == nil {
+			t.Errorf("accepted %q", s)
+		}
+	}
+	// Parsable but missing mandatory headers.
+	m, err := parseSIP([]byte("OPTIONS sip:a@b SIP/2.0\r\nVia: SIP/2.0/UDP h;branch=z9hG4bK1\r\nCSeq: 1 OPTIONS\r\n\r\n"))
+	if err != nil || m.valid() {
+		t.Fatalf("missing headers not caught: %v", err)
+	}
+	m, err = parseSIP([]byte("OPTIONS sip:a@b SIP/2.0\r\nVia: SIP/2.0/UDP h;branch=z9hG4bK1\r\nCall-ID: c\r\nFrom: <sip:a@b>\r\nTo: <sip:a@b>\r\nCSeq: 1 INVITE\r\n\r\n"))
+	if err != nil || m.valid() {
+		t.Fatalf("CSeq method mismatch not caught: %v", err)
+	}
+}
+
+func TestURIAndNameAddr(t *testing.T) {
+	u, ok := parseURI("sip:+420000000000;phone-context=x@127.0.0.1:5061;transport=TLS;lr?h=1")
+	if !ok || u.user != "+420000000000;phone-context=x" || u.host != "127.0.0.1" || u.port != 5061 || u.headers != "?h=1" {
+		t.Fatalf("uri %+v", u)
+	}
+	u.params = removeParam(u.params, "transport")
+	if got := u.String(); got != "sip:+420000000000;phone-context=x@127.0.0.1:5061;lr?h=1" {
+		t.Fatalf("uri string %q", got)
+	}
+	if u, ok := parseURI("sip:[fd00::1]:5060"); !ok || u.host != "[fd00::1]" || u.port != 5060 {
+		t.Fatalf("v6 uri %+v", u)
+	}
+	if _, ok := parseURI("tel:+420000000000"); ok {
+		t.Fatal("tel URI accepted")
+	}
+	na := parseNameAddr(`"A <b>" <sip:test@127.0.0.1>;+sip.instance="<urn:uuid:0>";expires=60`)
+	if na.uri != "sip:test@127.0.0.1" || na.params != `;+sip.instance="<urn:uuid:0>";expires=60` {
+		t.Fatalf("name-addr %+v", na)
+	}
+	na = parseNameAddr("sip:test@127.0.0.1;expires=0")
+	if na.uri != "sip:test@127.0.0.1" || na.params != ";expires=0" {
+		t.Fatalf("addr-spec %+v", na)
+	}
+	if got := na.String(); got != "<sip:test@127.0.0.1>;expires=0" {
+		t.Fatalf("addr-spec string %q", got)
+	}
+	if got := splitComma(`"a,b" <sip:x>, <sip:y;p=1,2>, z`); len(got) != 3 {
+		t.Fatalf("splitComma %q", got)
+	}
+}
+
+// slowReader returns one byte per Read.
+type slowReader struct{ r io.Reader }
+
+func (s slowReader) Read(p []byte) (int, error) { return s.r.Read(p[:1]) }
+
+func TestStreamFraming(t *testing.T) {
+	msg1 := "MESSAGE sip:a@b SIP/2.0\r\nl: 4\r\n\r\nbody"
+	msg2 := "SIP/2.0 200 OK\r\nContent-Length: 0\r\n\r\n"
+	stream := "\r\n\r\n" + msg1 + "\r\n" + msg2 + "\r\n\r\n"
+	r := newSIPStreamReader(slowReader{strings.NewReader(stream)})
+	if _, ping, err := r.next(); err != nil || !ping {
+		t.Fatalf("ping: %v %v", ping, err)
+	}
+	if m, _, err := r.next(); err != nil || string(m) != msg1 {
+		t.Fatalf("msg1 %q %v", m, err)
+	}
+	if m, _, err := r.next(); err != nil || string(m) != msg2 {
+		t.Fatalf("msg2 %q %v", m, err)
+	}
+	if _, ping, err := r.next(); err != nil || !ping {
+		t.Fatalf("ping 2: %v %v", ping, err)
+	}
+	if _, _, err := r.next(); err != io.EOF {
+		t.Fatalf("want EOF, got %v", err)
+	}
+
+	big := "MESSAGE sip:a@b SIP/2.0\r\nContent-Length: 999999\r\n\r\n"
+	if _, _, err := newSIPStreamReader(strings.NewReader(big)).next(); err != errFraming {
+		t.Fatalf("oversized body: %v", err)
+	}
+	long := "MESSAGE sip:a@b SIP/2.0\r\nX: " + strings.Repeat("a", maxSIPHeaderBytes) + "\r\n\r\n"
+	if _, _, err := newSIPStreamReader(strings.NewReader(long)).next(); err != errFraming {
+		t.Fatalf("oversized header: %v", err)
+	}
+	if _, _, err := newSIPStreamReader(strings.NewReader("\rX")).next(); err != errFraming {
+		t.Fatalf("bare CR: %v", err)
+	}
+}
diff --git a/libtailscale/p21relay/sipuri.go b/libtailscale/p21relay/sipuri.go
new file mode 100644
index 0000000..2de5657
--- /dev/null
+++ b/libtailscale/p21relay/sipuri.go
@@ -0,0 +1,295 @@
+// Copyright (c) Phone21
+// SPDX-License-Identifier: BSD-3-Clause
+
+package p21relay
+
+import (
+	"net/netip"
+	"strconv"
+	"strings"
+)
+
+// sipParam is one ;name[=value] parameter.
+type sipParam struct {
+	k, v string
+	hasV bool
+}
+
+func parseParams(s string) []sipParam {
+	var out []sipParam
+	for _, p := range strings.Split(s, ";") {
+		p = strings.TrimSpace(p)
+		if p == "" {
+			continue
+		}
+		k, v, has := strings.Cut(p, "=")
+		out = append(out, sipParam{k: strings.TrimSpace(k), v: strings.TrimSpace(v), hasV: has})
+	}
+	return out
+}
+
+func formatParams(ps []sipParam) string {
+	var b strings.Builder
+	for _, p := range ps {
+		b.WriteByte(';')
+		b.WriteString(p.k)
+		if p.hasV {
+			b.WriteByte('=')
+			b.WriteString(p.v)
+		}
+	}
+	return b.String()
+}
+
+func paramValue(ps []sipParam, k string) (string, bool) {
+	for _, p := range ps {
+		if strings.EqualFold(p.k, k) {
+			return p.v, true
+		}
+	}
+	return "", false
+}
+
+func hasParam(ps []sipParam, k string) bool {
+	_, ok := paramValue(ps, k)
+	return ok
+}
+
+func setParam(ps []sipParam, k, v string) []sipParam {
+	for i := range ps {
+		if strings.EqualFold(ps[i].k, k) {
+			ps[i].v, ps[i].hasV = v, true
+			return ps
+		}
+	}
+	return append(ps, sipParam{k: k, v: v, hasV: true})
+}
+
+func removeParam(ps []sipParam, k string) []sipParam {
+	out := ps[:0]
+	for _, p := range ps {
+		if !strings.EqualFold(p.k, k) {
+			out = append(out, p)
+		}
+	}
+	return out
+}
+
+// splitHostPort splits host[:port]; IPv6 hosts keep their brackets.
+func splitHostPort(s string) (host string, port int, ok bool) {
+	if s == "" {
+		return "", 0, false
+	}
+	if s[0] == '[' {
+		end := strings.IndexByte(s, ']')
+		if end < 0 {
+			return "", 0, false
+		}
+		host, s = s[:end+1], s[end+1:]
+		if s == "" {
+			return host, 0, true
+		}
+		if s[0] != ':' {
+			return "", 0, false
+		}
+		s = s[1:]
+	} else {
+		h, p, has := strings.Cut(s, ":")
+		host = h
+		if !has {
+			return host, 0, host != ""
+		}
+		s = p
+	}
+	n, err := strconv.Atoi(s)
+	if err != nil || n <= 0 || n > 65535 || host == "" {
+		return "", 0, false
+	}
+	return host, n, true
+}
+
+func joinHostPort(host string, port int) string {
+	if port == 0 {
+		return host
+	}
+	return host + ":" + strconv.Itoa(port)
+}
+
+// hostAddr parses a URI/Via host as an IP address.
+func hostAddr(host string) (netip.Addr, bool) {
+	a, err := netip.ParseAddr(strings.TrimSuffix(strings.TrimPrefix(host, "["), "]"))
+	if err != nil {
+		return netip.Addr{}, false
+	}
+	return a.Unmap(), true
+}
+
+// sipVia is one parsed Via value.
+type sipVia struct {
+	transport string // upper case: UDP, TCP, TLS, ...
+	host      string
+	port      int // 0 = not present
+	params    []sipParam
+}
+
+func parseVia(s string) (*sipVia, bool) {
+	s = strings.TrimSpace(s)
+	// sent-protocol: name / version / transport, LWS allowed around "/".
+	var fields [3]string
+	for i := 0; i < 3; i++ {
+		s = strings.TrimLeft(s, " \t")
+		j := 0
+		for j < len(s) && isTokenChar(s[j]) {
+			j++
+		}
+		fields[i], s = s[:j], s[j:]
+		if fields[i] == "" {
+			return nil, false
+		}
+		if i < 2 {
+			s = strings.TrimLeft(s, " \t")
+			if s == "" || s[0] != '/' {
+				return nil, false
+			}
+			s = s[1:]
+		}
+	}
+	if !strings.EqualFold(fields[0], "SIP") || fields[1] != "2.0" {
+		return nil, false
+	}
+	if s == "" || (s[0] != ' ' && s[0] != '\t') {
+		return nil, false
+	}
+	sentBy, params, _ := strings.Cut(strings.TrimSpace(s), ";")
+	host, port, ok := splitHostPort(strings.TrimSpace(sentBy))
+	if !ok {
+		return nil, false
+	}
+	return &sipVia{
+		transport: strings.ToUpper(fields[2]),
+		host:      host,
+		port:      port,
+		params:    parseParams(params),
+	}, true
+}
+
+func (v *sipVia) String() string {
+	return "SIP/2.0/" + v.transport + " " + joinHostPort(v.host, v.port) + formatParams(v.params)
+}
+
+func (v *sipVia) branch() string {
+	b, _ := paramValue(v.params, "branch")
+	return b
+}
+
+// sipURI is a parsed sip: or sips: URI.
+type sipURI struct {
+	scheme   string
+	user     string // userinfo without "@"
+	hasUser  bool
+	host     string
+	port     int
+	params   []sipParam
+	headers  string // raw, including the leading "?"
+	original string
+}
+
+func parseURI(s string) (*sipURI, bool) {
+	s = strings.TrimSpace(s)
+	scheme, rest, ok := strings.Cut(s, ":")
+	if !ok || !(strings.EqualFold(scheme, "sip") || strings.EqualFold(scheme, "sips")) {
+		return nil, false
+	}
+	u := &sipURI{scheme: strings.ToLower(scheme), original: s}
+	// "@" never appears unescaped outside the userinfo.
+	if at := strings.LastIndexByte(rest, '@'); at >= 0 {
+		u.user, u.hasUser, rest = rest[:at], true, rest[at+1:]
+	}
+	if q := strings.IndexByte(rest, '?'); q >= 0 {
+		u.headers, rest = rest[q:], rest[:q]
+	}
+	hp, params, _ := strings.Cut(rest, ";")
+	host, port, ok := splitHostPort(hp)
+	if !ok {
+		return nil, false
+	}
+	u.host, u.port, u.params = host, port, parseParams(params)
+	return u, true
+}
+
+func (u *sipURI) String() string {
+	var b strings.Builder
+	b.WriteString(u.scheme)
+	b.WriteByte(':')
+	if u.hasUser {
+		b.WriteString(u.user)
+		b.WriteByte('@')
+	}
+	b.WriteString(joinHostPort(u.host, u.port))
+	b.WriteString(formatParams(u.params))
+	b.WriteString(u.headers)
+	return b.String()
+}
+
+// isHost reports whether the URI host is the address a.
+func (u *sipURI) isHost(a netip.Addr) bool {
+	h, ok := hostAddr(u.host)
+	return ok && h == a
+}
+
+func (u *sipURI) isLoopback() bool {
+	if strings.EqualFold(u.host, "localhost") {
+		return true
+	}
+	h, ok := hostAddr(u.host)
+	return ok && h.IsLoopback()
+}
+
+// nameAddr is a Contact/Route/From/To value: [display] <uri> ;params, or
+// the addr-spec form uri;params (params are then header parameters).
+type nameAddr struct {
+	display string // text before "<", untrimmed
+	uri     string
+	params  string // raw header parameters, starting with ";" or empty
+}
+
+func parseNameAddr(s string) nameAddr {
+	s = strings.TrimSpace(s)
+	inQuote, esc := false, false
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case esc:
+			esc = false
+		case inQuote:
+			if c == '\\' {
+				esc = true
+			} else if c == '"' {
+				inQuote = false
+			}
+		case c == '"':
+			inQuote = true
+		case c == '<':
+			end := strings.IndexByte(s[i:], '>')
+			if end < 0 {
+				return nameAddr{uri: s}
+			}
+			return nameAddr{display: s[:i], uri: s[i+1 : i+end], params: strings.TrimSpace(s[i+end+1:])}
+		}
+	}
+	uri, params, has := strings.Cut(s, ";")
+	if has {
+		params = ";" + params
+	}
+	return nameAddr{uri: strings.TrimSpace(uri), params: params}
+}
+
+// String always uses the angle-bracket form, so URI parameters survive.
+func (n nameAddr) String() string {
+	return n.display + "<" + n.uri + ">" + n.params
+}
+
+// nameAddrParams returns the header parameters of a name-addr value.
+func nameAddrParams(s string) []sipParam {
+	return parseParams(parseNameAddr(s).params)
+}
