@@ -0,0 +1,105 @@
+// Copyright (c) Phone21
+// SPDX-License-Identifier: BSD-3-Clause
+
+package p21relay
+
+import (
+	"bufio"
+	"errors"
+	"io"
+	"strconv"
+	"strings"
+)
+
+var errFraming = errors.New("SIP stream framing error")
+
+// sipStreamReader splits a SIP byte stream (TLS or TCP) into messages by
+// Content-Length and recognises RFC 5626 keepalive pings (CRLFCRLF).
+type sipStreamReader struct {
+	r *bufio.Reader
+}
+
+func newSIPStreamReader(r io.Reader) *sipStreamReader {
+	return &sipStreamReader{r: bufio.NewReaderSize(r, 8<<10)}
+}
+
+// next returns the next complete message, or ping=true when the peer sent a
+// keepalive ping that should be answered with a single CRLF.
+func (s *sipStreamReader) next() (msg []byte, ping bool, err error) {
+	// Between messages only CRLFs may appear.
+	crlf := 0
+	for {
+		c, err := s.r.ReadByte()
+		if err != nil {
+			return nil, false, err
+		}
+		switch c {
+		case '\r':
+			c2, err := s.r.ReadByte()
+			if err != nil {
+				return nil, false, err
+			}
+			if c2 != '\n' {
+				return nil, false, errFraming
+			}
+			fallthrough
+		case '\n':
+			crlf++
+			if crlf == 2 {
+				return nil, true, nil
+			}
+			continue
+		}
+		if err := s.r.UnreadByte(); err != nil {
+			return nil, false, err
+		}
+		break
+	}
+
+	var head []byte
+	cl := 0
+	for {
+		line, err := s.readLine(maxSIPHeaderBytes - len(head))
+		if err != nil {
+			return nil, false, err
+		}
+		head = append(head, line...)
+		if len(line) <= 2 && strings.TrimRight(string(line), "\r\n") == "" {
+			break // empty line: end of headers
+		}
+		name, value, ok := strings.Cut(string(line), ":")
+		if ok && canonHeaderName(strings.TrimSpace(name)) == "content-length" {
+			n, err := strconv.Atoi(strings.TrimSpace(value))
+			if err != nil || n < 0 || n > maxSIPBodyBytes {
+				return nil, false, errFraming
+			}
+			cl = n
+		}
+	}
+	msg = make([]byte, len(head)+cl)
+	copy(msg, head)
+	if _, err := io.ReadFull(s.r, msg[len(head):]); err != nil {
+		return nil, false, err
+	}
+	return msg, false, nil
+}
+
+// readLine reads one line including its terminator, at most max bytes.
+func (s *sipStreamReader) readLine(max int) ([]byte, error) {
+	var line []byte
+	for {
+		frag, err := s.r.ReadSlice('\n')
+		if len(line)+len(frag) > max {
+			return nil, errFraming
+		}
+		line = append(line, frag...)
+		switch err {
+		case nil:
+			return line, nil
+		case bufio.ErrBufferFull:
+			continue
+		default:
+			return nil, err
+		}
+	}
+}
diff --git a/libtailscale/p21relay/sipmsg.go b/libtailscale/p21relay/sipmsg.go
new file mode 100644
index 0000000..3eacff8
--- /dev/null
+++ b/libtailscale/p21relay/sipmsg.go
@@ -0,0 +1,449 @@
+// Copyright (c) Phone21
+// SPDX-License-Identifier: BSD-3-Clause
+
+package p21relay
+
+import (
+	"bytes"
+	"errors"
+	"strconv"
+	"strings"
+)
+
+// Size limits of one SIP message. The calling library and the miniserver
+// never come close; anything bigger is treated as garbage.
+const (
+	maxSIPHeaderBytes = 32 << 10
+	maxSIPBodyBytes   = 64 << 10
+	maxSIPHeaders     = 200
+)
+
+var errMalformed = errors.New("malformed SIP message")
+
+// compactForms maps compact header names (RFC 3261 7.3.3 and extensions)
+// to their full lowercase names.
+var compactForms = map[string]string{
+	"a": "accept-contact",
+	"b": "referred-by",
+	"c": "content-type",
+	"d": "request-disposition",
+	"e": "content-encoding",
+	"f": "from",
+	"i": "call-id",
+	"j": "reject-contact",
+	"k": "supported",
+	"l": "content-length",
+	"m": "contact",
+	"n": "identity-info",
+	"o": "event",
+	"r": "refer-to",
+	"s": "subject",
+	"t": "to",
+	"u": "allow-events",
+	"v": "via",
+	"x": "session-expires",
+	"y": "identity",
+}
+
+// canonHeaderName returns the lowercase full name of a header.
+func canonHeaderName(n string) string {
+	l := strings.ToLower(n)
+	if f, ok := compactForms[l]; ok {
+		return f
+	}
+	return l
+}
+
+func isTokenChar(c byte) bool {
+	switch {
+	case c >= 'a' && c <= 'z', c >= 'A' && c <= 'Z', c >= '0' && c <= '9':
+		return true
+	}
+	return strings.IndexByte("-.!%*_+`'~", c) >= 0
+}
+
+func isToken(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if !isTokenChar(s[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+type sipHeader struct {
+	name  string // as received (full or compact form, original case)
+	key   string // canonical lowercase full name
+	value string // unfolded, trimmed
+}
+
+// sipMsg is a parsed SIP request or response. Headers keep their order
+// and spelling; only the ones the relay touches are rewritten.
+type sipMsg struct {
+	isReq  bool
+	method string // request only
+	ruri   string // request only
+	status int    // response only
+	reason string // response only
+	hdrs   []sipHeader
+	body   []byte
+}
+
+// parseSIP parses one complete message (a datagram or a framed stream
+// message). With Content-Length the body is cut to that length; without it
+// the rest of the buffer is the body (RFC 3261 18.3).
+func parseSIP(b []byte) (*sipMsg, error) {
+	for len(b) > 0 && (b[0] == '\r' || b[0] == '\n') {
+		b = b[1:]
+	}
+	headEnd, bodyStart := -1, -1
+	if i := bytes.Index(b, []byte("\r\n\r\n")); i >= 0 {
+		headEnd, bodyStart = i, i+4
+	}
+	if j := bytes.Index(b, []byte("\n\n")); j >= 0 && (headEnd < 0 || j < headEnd) {
+		headEnd, bodyStart = j, j+2
+	}
+	if headEnd < 0 || headEnd > maxSIPHeaderBytes {
+		return nil, errMalformed
+	}
+	lines := strings.Split(string(b[:headEnd]), "\n")
+	for i := range lines {
+		lines[i] = strings.TrimSuffix(lines[i], "\r")
+	}
+	m := &sipMsg{}
+	if err := m.parseStartLine(lines[0]); err != nil {
+		return nil, err
+	}
+	for _, ln := range lines[1:] {
+		if ln == "" {
+			return nil, errMalformed
+		}
+		if ln[0] == ' ' || ln[0] == '\t' { // folded continuation line
+			if len(m.hdrs) == 0 {
+				return nil, errMalformed
+			}
+			h := &m.hdrs[len(m.hdrs)-1]
+			h.value = strings.TrimSpace(h.value + " " + strings.TrimSpace(ln))
+			continue
+		}
+		colon := strings.IndexByte(ln, ':')
+		if colon <= 0 {
+			return nil, errMalformed
+		}
+		name := strings.TrimRight(ln[:colon], " \t")
+		if !isToken(name) || len(m.hdrs) >= maxSIPHeaders {
+			return nil, errMalformed
+		}
+		m.hdrs = append(m.hdrs, sipHeader{
+			name:  name,
+			key:   canonHeaderName(name),
+			value: strings.TrimSpace(ln[colon+1:]),
+		})
+	}
+	body := b[bodyStart:]
+	if cl, ok := m.lookup("content-length"); ok {
+		n, err := strconv.Atoi(cl)
+		if err != nil || n < 0 || n > len(body) {
+			return nil, errMalformed
+		}
+		body = body[:n]
+	}
+	if len(body) > maxSIPBodyBytes {
+		return nil, errMalformed
+	}
+	if len(body) > 0 {
+		m.body = append([]byte(nil), body...)
+	}
+	return m, nil
+}
+
+func (m *sipMsg) parseStartLine(l string) error {
+	if len(l) > 8 && strings.EqualFold(l[:8], "SIP/2.0 ") {
+		code, reason, _ := strings.Cut(l[8:], " ")
+		n, err := strconv.Atoi(code)
+		if err != nil || len(code) != 3 || n < 100 || n > 699 {
+			return errMalformed
+		}
+		m.status, m.reason = n, reason
+		return nil
+	}
+	parts := strings.Split(l, " ")
+	if len(parts) != 3 || !isToken(parts[0]) || parts[1] == "" || !strings.EqualFold(parts[2], "SIP/2.0") {
+		return errMalformed
+	}
+	m.isReq, m.method, m.ruri = true, parts[0], parts[1]
+	return nil
+}
+
+// bytes serialises the message; Content-Length always matches the body.
+func (m *sipMsg) bytes() []byte {
+	var b bytes.Buffer
+	b.Grow(512 + len(m.body))
+	if m.isReq {
+		b.WriteString(m.method)
+		b.WriteByte(' ')
+		b.WriteString(m.ruri)
+		b.WriteString(" SIP/2.0\r\n")
+	} else {
+		b.WriteString("SIP/2.0 ")
+		b.WriteString(strconv.Itoa(m.status))
+		b.WriteByte(' ')
+		b.WriteString(m.reason)
+		b.WriteString("\r\n")
+	}
+	haveCL := false
+	for _, h := range m.hdrs {
+		v := h.value
+		if h.key == "content-length" {
+			if haveCL {
+				continue
+			}
+			haveCL = true
+			v = strconv.Itoa(len(m.body))
+		}
+		b.WriteString(h.name)
+		b.WriteString(": ")
+		b.WriteString(v)
+		b.WriteString("\r\n")
+	}
+	if !haveCL {
+		b.WriteString("Content-Length: ")
+		b.WriteString(strconv.Itoa(len(m.body)))
+		b.WriteString("\r\n")
+	}
+	b.WriteString("\r\n")
+	b.Write(m.body)
+	return b.Bytes()
+}
+
+// lookup returns the value of the first header with the canonical key.
+func (m *sipMsg) lookup(key string) (string, bool) {
+	for _, h := range m.hdrs {
+		if h.key == key {
+			return h.value, true
+		}
+	}
+	return "", false
+}
+
+func (m *sipMsg) get(key string) string {
+	v, _ := m.lookup(key)
+	return v
+}
+
+func (m *sipMsg) index(key string) int {
+	for i, h := range m.hdrs {
+		if h.key == key {
+			return i
+		}
+	}
+	return -1
+}
+
+func (m *sipMsg) has(key string) bool { return m.index(key) >= 0 }
+
+func (m *sipMsg) del(key string) {
+	out := m.hdrs[:0]
+	for _, h := range m.hdrs {
+		if h.key != key {
+			out = append(out, h)
+		}
+	}
+	m.hdrs = out
+}
+
+func (m *sipMsg) insert(i int, h sipHeader) {
+	m.hdrs = append(m.hdrs, sipHeader{})
+	copy(m.hdrs[i+1:], m.hdrs[i:])
+	m.hdrs[i] = h
+}
+
+// set replaces the value of the first header with key, or appends one.
+func (m *sipMsg) set(key, name, value string) {
+	if i := m.index(key); i >= 0 {
+		m.hdrs[i].value = value
+		return
+	}
+	m.hdrs = append(m.hdrs, sipHeader{name: name, key: key, value: value})
+}
+
+// values returns all comma-separated values of all headers with key.
+func (m *sipMsg) values(key string) []string {
+	var out []string
+	for _, h := range m.hdrs {
+		if h.key == key {
+			out = append(out, splitComma(h.value)...)
+		}
+	}
+	return out
+}
+
+// mapValues calls f for every comma-separated value of every header with
+// key; f returns the replacement, or "" to drop the value. Headers left
+// without values are removed.
+func (m *sipMsg) mapValues(key string, f func(v string) string) {
+	out := m.hdrs[:0]
+	for _, h := range m.hdrs {
+		if h.key == key {
+			var keep []string
+			for _, v := range splitComma(h.value) {
+				if nv := f(v); nv != "" {
+					keep = append(keep, nv)
+				}
+			}
+			if len(keep) == 0 {
+				continue
+			}
+			h.value = strings.Join(keep, ", ")
+		}
+		out = append(out, h)
+	}
+	m.hdrs = out
+}
+
+// topValue returns the first value of the first header with key.
+func (m *sipMsg) topValue(key string) (string, bool) {
+	i := m.index(key)
+	if i < 0 {
+		return "", false
+	}
+	vs := splitComma(m.hdrs[i].value)
+	if len(vs) == 0 {
+		return "", false
+	}
+	return vs[0], true
+}
+
+// setTopValue replaces the first value of the first header with key.
+func (m *sipMsg) setTopValue(key, v string) {
+	i := m.index(key)
+	if i < 0 {
+		return
+	}
+	vs := splitComma(m.hdrs[i].value)
+	if len(vs) == 0 {
+		return
+	}
+	vs[0] = v
+	m.hdrs[i].value = strings.Join(vs, ", ")
+}
+
+// popTopValue removes the first value of the first header with key.
+func (m *sipMsg) popTopValue(key string) {
+	i := m.index(key)
+	if i < 0 {
+		return
+	}
+	vs := splitComma(m.hdrs[i].value)
+	if len(vs) <= 1 {
+		m.hdrs = append(m.hdrs[:i], m.hdrs[i+1:]...)
+		return
+	}
+	m.hdrs[i].value = strings.Join(vs[1:], ", ")
+}
+
+// pushVia adds a Via on top of all others.
+func (m *sipMsg) pushVia(v string) {
+	i := m.index("via")
+	if i < 0 {
+		i = 0
+	}
+	m.insert(i, sipHeader{name: "Via", key: "via", value: v})
+}
+
+// cseq returns the CSeq number and method.
+func (m *sipMsg) cseq() (uint32, string, bool) {
+	f := strings.Fields(m.get("cseq"))
+	if len(f) != 2 || !isToken(f[1]) {
+		return 0, "", false
+	}
+	n, err := strconv.ParseUint(f[0], 10, 32)
+	if err != nil {
+		return 0, "", false
+	}
+	return uint32(n), f[1], true
+}
+
+// valid checks the headers every message must carry.
+func (m *sipMsg) valid() bool {
+	if m.get("call-id") == "" || m.get("from") == "" || m.get("to") == "" {
+		return false
+	}
+	if _, ok := m.topValue("via"); !ok {
+		return false
+	}
+	_, method, ok := m.cseq()
+	if !ok {
+		return false
+	}
+	if m.isReq && method != m.method {
+		return false
+	}
+	return true
+}
+
+// isSDP reports whether the body is a session description.
+func (m *sipMsg) isSDP() bool {
+	if len(m.body) == 0 {
+		return false
+	}
+	ct, _, _ := strings.Cut(m.get("content-type"), ";")
+	return strings.EqualFold(strings.TrimSpace(ct), "application/sdp")
+}
+
+// splitComma splits a header value at commas that are outside quoted
+// strings and angle brackets; parts are trimmed, empty ones dropped.
+func splitComma(s string) []string {
+	var out []string
+	inQuote, inAngle, esc := false, false, false
+	start := 0
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case esc:
+			esc = false
+		case inQuote:
+			switch c {
+			case '\\':
+				esc = true
+			case '"':
+				inQuote = false
+			}
+		case c == '"':
+			inQuote = true
+		case c == '<':
+			inAngle = true
+		case c == '>':
+			inAngle = false
+		case c == ',' && !inAngle:
+			if p := strings.TrimSpace(s[start:i]); p != "" {
+				out = append(out, p)
+			}
+			start = i + 1
+		}
+	}
+	if p := strings.TrimSpace(s[start:]); p != "" {
+		out = append(out, p)
+	}
+	return out
+}
+
+// newResponse builds a locally generated response to req (RFC 3261 8.2.6).
+func newResponse(req *sipMsg, status int, reason, toTag string) *sipMsg {
+	r := &sipMsg{status: status, reason: reason}
+	for _, h := range req.hdrs {
+		switch h.key {
+		case "via", "from", "call-id", "cseq":
+			r.hdrs = append(r.hdrs, h)
+		case "to":
+			if toTag != "" && !hasParam(nameAddrParams(h.value), "tag") {
+				h.value += ";tag=" + toTag
+			}
+			r.hdrs = append(r.hdrs, h)
+		}
+	}
+	return r
+}
diff --git a/libtailscale/p21relay/sipmsg_test.go b/libtailscale/p21relay/sipmsg_test.go
