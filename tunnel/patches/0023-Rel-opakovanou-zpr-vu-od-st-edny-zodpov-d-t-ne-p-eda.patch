diff --git a/libtailscale/p21relay/relay_test.go b/libtailscale/p21relay/relay_test.go
index b609da5..fe8ee16 100644
--- a/libtailscale/p21relay/relay_test.go
+++ b/libtailscale/p21relay/relay_test.go
@@ -574,6 +574,46 @@ func TestInviteRetransmissionAnswered(t *testing.T) {
 	waitFor(t, func() bool { return e.mediaStat("streams") == 0 })
 }
 
+// The calling library talks TLS and forgets a non-INVITE transaction as
+// soon as it answered; a retransmission from the miniserver (its answer
+// got lost on UDP) must get the same answer from the relay instead of
+// reaching the library as a new request (a second SMS, 481 to a BYE).
+func TestNonInviteRetransmissionAnswered(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+	register(t, e, c)
+	message := func(branch string) string {
+		return "MESSAGE sip:" + testUser + "@" + e.privSIP().String() + " SIP/2.0\r\n" +
+			"Via: SIP/2.0/UDP " + e.up.addr.String() + ";rport;branch=" + branch + "\r\n" +
+			"Max-Forwards: 70\r\nFrom: <sip:" + testNumber + "@" + upIP.String() + ">;tag=m1\r\n" +
+			"To: <sip:" + testUser + "@" + upIP.String() + ">\r\nCall-ID: sms-" + branch + "\r\nCSeq: 1 MESSAGE\r\n" +
+			"Content-Type: text/plain\r\nContent-Length: 4\r\n\r\ntext"
+	}
+	b := newBranch()
+	e.up.sendUDP(e.privSIP(), message(b))
+	cm := c.expectRequest("MESSAGE")
+	c.send(responseText(cm, 200, "OK", "cli-tag", nil, ""))
+	first := e.up.expectResponse(200, "MESSAGE")
+
+	e.up.sendUDP(e.privSIP(), message(b))
+	select {
+	case again := <-e.up.in:
+		if string(again.raw) != string(first.raw) {
+			t.Fatalf("answer to the retransmission differs:\n%s\n---\n%s", first.raw, again.raw)
+		}
+	case <-time.After(waitLong):
+		t.Fatal("retransmission not answered")
+	}
+	c.expectNothing()
+	if n := e.counter("sip.retransmit_answered"); n != 1 {
+		t.Fatalf("retransmit_answered %d", n)
+	}
+
+	// A new request (other branch) still reaches the calling library.
+	e.up.sendUDP(e.privSIP(), message(newBranch()))
+	c.expectRequest("MESSAGE")
+}
+
