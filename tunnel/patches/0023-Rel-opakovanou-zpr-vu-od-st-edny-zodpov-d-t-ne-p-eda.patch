 	c := newFakeClient(t, e)
diff --git a/libtailscale/p21relay/sipproxy.go b/libtailscale/p21relay/sipproxy.go
index a471628..896ab45 100644
--- a/libtailscale/p21relay/sipproxy.go
+++ b/libtailscale/p21relay/sipproxy.go
@@ -25,6 +25,7 @@ const (
 	sipTxTimeout         = 64 * sipT1
 	maxUDPRequest        = 1200 // bigger requests go to the miniserver over TCP
 	maxTxEntries         = 256
+	maxCachedAnswers     = 64 // of maxTxEntries
 	maxUpstreamTCP       = 8
 	maxRememberedContact = 16
 	maxPendingHandshakes = 16 // handshakes that have sent data
@@ -157,6 +158,9 @@ func (t *tcpConn) close() {
 
 // txEntry makes the UDP leg toward the miniserver reliable: the calling
 // library talks TLS and therefore never retransmits.
+//
+// Entries under ansKey hold the final answer to a non-INVITE request from
+// the miniserver for its retransmissions (no timer, just expire).
 type txEntry struct {
 	data      []byte
 	dest      netip.AddrPort
@@ -1003,12 +1007,19 @@ func (p *sipProxy) clientResponse(m *sipMsg) {
 		return
 	}
 	p.sendUDP(out, dst)
-	if method == "INVITE" && m.status >= 200 {
+	switch {
+	case m.status < 200:
+	case method == "INVITE":
 		// RFC 3261 13.3.1.4 / 17.2.1: repeat until the miniserver's ACK.
 		p.addTx(rspKey(m.get("call-id"), num), &txEntry{
 			data: out, dest: dst, response: true,
 			next: now.Add(sipT1), interval: sipT1, expire: now.Add(sipTxTimeout),
 		})
+	default:
+		// RFC 3261 17.2.2: retransmissions of the request get this answer
+		// until Timer J. Over TLS the calling library has already
+		// forgotten the transaction and would take them as new requests.
+		p.cacheAnswer(ansKey(v.branch(), method), out, dst, now)
 	}
 }
 
@@ -1016,6 +1027,28 @@ func rspKey(callID string, num uint32) string {
 	return "rsp|" + callID + "|" + strconv.FormatUint(uint64(num), 10)
 }
 
+// ansKey: our branch toward the calling library is derived from the
+// miniserver's, so a retransmission maps to the same key.
+func ansKey(branch, method string) string {
+	return "ans|" + branch + "|" + method
+}
+
+func (p *sipProxy) cacheAnswer(key string, data []byte, dst netip.AddrPort, now time.Time) {
+	if _, ok := p.txs[key]; !ok {
+		n := 0
+		for k := range p.txs {
+			if strings.HasPrefix(k, "ans|") {
+				n++
+			}
+		}
+		if n >= maxCachedAnswers {
+			p.cnt.inc("sip.answer_cache_full")
+			return
+		}
+	}
+	p.addTx(key, &txEntry{data: data, dest: dst, expire: now.Add(sipTxTimeout)})
+}
+
 // ---- miniserver -> calling library ----
 
 func (p *sipProxy) fromUpstream(data []byte, tc *tcpConn, src netip.AddrPort) {
@@ -1041,6 +1074,8 @@ func (p *sipProxy) upstreamRequest(m *sipMsg, tc *tcpConn, src netip.AddrPort) {
 	}
 	callID := m.get("call-id")
 	num, _, _ := m.cseq()
+	// Before anything is rewritten, so retransmissions map to the same one.
+	branch := p.branch("u", uv.branch(), m)
 	switch m.method {
 	case "ACK":
 		delete(p.txs, rspKey(callID, num))
@@ -1051,6 +1086,12 @@ func (p *sipProxy) upstreamRequest(m *sipMsg, tc *tcpConn, src netip.AddrPort) {
 			p.cnt.inc("sip.retransmit_answered")
 			return
 		}
+	default:
+		if tx := p.txs[ansKey(branch, m.method)]; tx != nil && tc == nil {
+			p.sendUDP(tx.data, tx.dest)
+			p.cnt.inc("sip.retransmit_answered")
+			return
+		}
 	}
 	if p.client == nil {
 		if m.method != "ACK" {
@@ -1084,7 +1125,7 @@ func (p *sipProxy) upstreamRequest(m *sipMsg, tc *tcpConn, src netip.AddrPort) {
 		conn = strconv.FormatUint(tc.id, 10)
 	}
 	via := &sipVia{transport: "TLS", host: loopback4.String(), port: p.sipPort, params: []sipParam{
-		{k: "branch", v: p.branch("u", uv.branch(), m), hasV: true},
+		{k: "branch", v: branch, hasV: true},
 		{k: viaConnParam, v: conn, hasV: true},
 	}}
 	m.pushVia(via.String())
