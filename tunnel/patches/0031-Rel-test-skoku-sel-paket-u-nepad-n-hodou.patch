 	// A re-offer keeps the ports; a held (0.0.0.0) side gets nothing.
 	held := strings.Replace(string(sdpFor("127.0.0.1", cli.port, mp.cs.attr(1))), "c=IN IP4 127.0.0.1", "c=IN IP4 0.0.0.0", 1)
