 libtailscale/p21relay/media_test.go    |  2 +-
 libtailscale/p21relay/srtpcall_test.go |  4 ++--
 libtailscale/p21relay/srtppeer_test.go | 11 +++++++++++
 3 files changed, 14 insertions(+), 3 deletions(-)

