+// relé nabídlo.
+func (s *mediaStream) answerChoice(values []string) (cryptoLine, bool) {
+	for _, v := range values {
+		c, ok := parseCrypto(v)
+		if ok && s.offered != nil && s.offered[c.tag] == c.key.suite {
+			return c, true
+		}
+	}
+	return cryptoLine{}, false
