+
+// sdpMsg popisuje zprávu, která nese popis relace.
+type sdpMsg struct {
+	isReq  bool
+	method string // metoda požadavku, u odpovědi metoda z CSeq
+	cseq   uint32
+}
+
+type sdpKind int
+
+const (
+	sdpOther sdpKind = iota // mimo výměnu nabídka/odpověď hovoru
+	sdpOffer
+	sdpAnswer
+)
+
+func sideOf(fromClient bool) int8 {
+	if fromClient {
+		return 1
+	}
+	return 2
+}
+
+func offerKey(fromClient bool, method string, cseq uint32) string {
+	return strconv.Itoa(int(sideOf(fromClient))) + "|" + method + "|" + strconv.FormatUint(uint64(cseq), 10)
+}
+
+// kind určí roli popisu relace (RFC 3264, RFC 3262, RFC 3311). c smí být nil.
+func (c *mediaCall) kind(fromClient bool, m sdpMsg) sdpKind {
+	switch m.method {
+	case "INVITE", "UPDATE", "PRACK", "ACK":
+	default:
+		return sdpOther
+	}
+	if m.isReq {
+		switch m.method {
+		case "ACK":
+			return sdpAnswer
+		case "PRACK":
+			if c != nil && c.respOffer == sideOf(!fromClient) {
+				return sdpAnswer
+			}
+		}
+		return sdpOffer
+	}
+	if c != nil && c.reqOffer[offerKey(!fromClient, m.method, m.cseq)] {
+		return sdpAnswer
+	}
+	return sdpOffer
+}
+
+// noteSDP si zapamatuje nabídku nebo vyřízení nabídky z odpovědi.
+func (c *mediaCall) noteSDP(fromClient bool, m sdpMsg, k sdpKind) {
+	switch {
+	case k == sdpOffer && m.isReq:
+		if c.reqOffer == nil || len(c.reqOffer) >= 16 {
+			c.reqOffer = make(map[string]bool)
+		}
+		c.reqOffer[offerKey(fromClient, m.method, m.cseq)] = true
+	case k == sdpOffer:
+		c.respOffer = sideOf(fromClient)
+	case k == sdpAnswer && m.isReq:
+		c.respOffer = 0
+	}
 }
 
