+// Nabídka bez šifrování od knihovny dostane 488 a k ústředně nedojde.
+func TestSRTPOfferWithoutCrypto(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+	register(t, e, c)
+	for i, body := range []string{
+		sdpBody("127.0.0.1", 40000),
+		sdpSecure("127.0.0.1", 40000, "a=crypto:1 AES_256_CM_HMAC_SHA1_80 inline:"+testKey1+testKey1[:16]),
+	} {
+		cl := newCall(t, "plain-", 30)
+		c.send(requestText("INVITE", "sip:"+testNumber+"@"+upIP.String(), append(cl.clientHeaders(c, newBranch(), cl.cseq, "INVITE", false), e.relayRoute()), body))
+		r := c.expectResponse(488, "INVITE")
+		if !strings.Contains(r.get("to"), "tag=") {
+			t.Fatal("488 without To tag")
+		}
+		e.up.expectNothing()
+		if n := e.counter("sip.488_no_crypto"); n != int64(i+1) {
+			t.Fatalf("488_no_crypto %d", n)
+		}
+	}
+	if e.mediaStat("streams") != 0 {
+		t.Fatal("media allocated for a refused offer")
+	}
+}
