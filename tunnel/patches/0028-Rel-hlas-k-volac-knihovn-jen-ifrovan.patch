+	c := newFakeClient(t, e)
+	register(t, e, c)
+	cl := establishOutgoing(t, e, c)
+	cl.us.seq, cl.cs.seq = 65530, 65530
+	for i := 0; i < 10; i++ {
+		cl.checkMedia(t, "wrap"+strconv.Itoa(i))
+	}
+	if cl.us.seq > 100 || cl.cs.seq > 100 {
+		t.Fatal("test did not wrap")
+	}
+
+	// Držení od knihovny, návrat od ústředny.
+	c.send(requestText("INVITE", e.relayURI(), cl.clientHeaders(c, newBranch(), cl.cseq+1, "INVITE", true), cl.offer("a=sendonly")))
+	ri := e.up.expectRequest("INVITE")
+	e.up.reply(ri, 200, "OK", []string{cl.upContact(e)}, sdpBody(upIP.String(), cl.mediaPath.up.port, "a=recvonly"))
+	cl.cs.learnAnswer(c.expectResponse(200, "INVITE").body, 1)
+	c.send(requestText("ACK", e.relayURI(), cl.clientHeaders(c, newBranch(), cl.cseq+1, "ACK", true), ""))
+	e.up.expectRequest("ACK")
+
+	inv := incomingInvite(t, e, cl.callID, 300, cl.mediaPath.up.port)
+	inv = strings.Replace(inv, "To: <sip:"+testUser+"@"+upIP.String()+">", "To: <sip:"+testUser+"@"+upIP.String()+">;tag=c1", 1)
+	e.up.sendUDP(e.privSIP(), inv)
+	ci := c.expectRequest("INVITE")
+	decBefore := cl.cs.dec
+	answer, _ := cl.cs.answerOffer(ci.body, 1)
+	if cl.cs.dec != decBefore {
+		t.Fatal("relay offered a new key for the suite in use")
+	}
+	c.send(responseText(ci, 200, "OK", "c1", []string{"Contact: <" + c.contact() + ">"}, sdpSecure("127.0.0.1", cl.cli.port, answer)))
+	e.up.expectResponse(200, "INVITE")
+	e.up.sendUDP(e.privSIP(), upRequest(e, "ACK", cl.callID, 300, "c1"))
+	c.expectRequest("ACK")
+	// Kontexty z doby před přetečením platí dál (ROC 1 na obou stranách).
+	cl.checkMedia(t, "resumed")
+	if e.mediaStat("srtpAuthFail") != 0 || e.mediaStat("srtpKeySwitch") != 0 {
+		t.Fatalf("media stats %v", e.relay.media.stats())
+	}
+}
+
+// Skok čísel paketů od ústředny v rámci jedné SSRC relé vyrovná, ať je
+// knihovna (okno 128) nezahodí.
+func TestSRTPSequenceJumpToClient(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+	cl := establishOutgoing(t, e, c)
+	last := cl.toClient(t, false, "a")
+	cl.us.seq -= 1000 // zpět o 1000
+	if got := cl.toClient(t, false, "after-back-jump"); got != last+1 {
+		t.Fatalf("seq %d after the jump, want %d", got, last+1)
+	}
+	cl.us.seq += 40000 // dopředu přes 2^15
+	if got := cl.toClient(t, false, "after-forward-jump"); got != last+2 {
+		t.Fatalf("seq %d after the jump, want %d", got, last+2)
+	}
+	cl.us.seq += 5 // malá mezera zůstane
+	if got := cl.toClient(t, false, "gap"); got != last+8 {
+		t.Fatalf("seq %d after a gap, want %d", got, last+8)
+	}
+	if n := e.mediaStat("srtpSeqResync"); n != 2 {
+		t.Fatalf("srtpSeqResync %d", n)
+	}
+	// Nová SSRC začíná vlastní řadou.
+	cl.us.ssrc++
+	cl.us.seq = 7
+	if got := cl.toClient(t, false, "new-ssrc"); got != 8 {
+		t.Fatalf("new SSRC seq %d", got)
+	}
+}
+
+// rtcp-mux na obou stranách: RTCP jde po portu RTP a šifruje se jako SRTCP.
+func TestSRTPRtcpMux(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+	cl := newCall(t, "mux-", 40)
+	mux := func(port int) []string { return []string{"a=rtcp:" + strconv.Itoa(port), "a=rtcp-mux"} }
+	c.send(requestText("INVITE", "sip:"+testNumber+"@"+upIP.String(), append(cl.clientHeaders(c, cl.branch, cl.cseq, "INVITE", false), e.relayRoute()),
+		cl.offer(mux(cl.cli.port)...)))
+	inv := e.up.expectRequest("INVITE")
+	_, cl.relayU = sdpMedia(t, inv.m.body)
+	if !strings.Contains(string(inv.m.body), "a=rtcp:"+strconv.Itoa(cl.relayU)+"\r\n") {
+		t.Fatalf("mux offer:\n%s", inv.m.body)
+	}
+	e.up.reply(inv, 200, "OK", []string{cl.upContact(e)}, sdpBody(upIP.String(), cl.mediaPath.up.port, mux(cl.mediaPath.up.port)...))
+	r := c.expectResponse(200, "INVITE")
+	_, cl.relayC = sdpMedia(t, r.body)
+	cl.cs.learnAnswer(r.body, 1)
+
+	// RTCP z portu RTP knihovny k portu RTP ústředny a zpět.
+	plain, sealed := cl.cs.sealRTCP("mux-rtcp-up")
+	sendUDP(t, cl.cli.rtp, cl.relayClientRTP(), sealed)
+	if got := recvFrom(t, cl.mediaPath.up.rtp, cl.relayPrivRTP(), "mux-rtcp-up"); !bytes.Equal(got, plain) {
+		t.Fatalf("mux rtcp up %x", got)
+	}
+	plain = rtcpPkt(cl.us.ssrc, "mux-rtcp-down")
+	sendUDP(t, cl.mediaPath.up.rtp, cl.relayPrivRTP(), plain)
+	got := recvFrom(t, cl.cli.rtp, cl.relayClientRTP(), "mux-rtcp-down")
+	dec, err := cl.cs.dec.DecryptRTCP(nil, got, nil)
+	if err != nil || !bytes.Equal(dec, plain) {
+		t.Fatalf("mux rtcp down: %v %x", err, dec)
+	}
+	cl.toUp(t, false, "mux-rtp-up")
+	cl.toClient(t, false, "mux-rtp-down")
+}
+
+// Bez dohodnutých klíčů hlas neprojde ani jedním směrem (knihovna
+// odpověděla na nabídku relé bez použitelného a=crypto).
+func TestSRTPNoKeyMedia(t *testing.T) {
+	mm := newMediaManager(fakeNet{}, upIP, &counters{}, &rateLog{})
+	defer mm.closeAll()
+	mp := &mediaPath{cli: newRTPPair(t, loopback4), up: newRTPPair(t, upIP), cs: newTestSRTP(t), us: &plainRTP{ssrc: 7}}
+	now := time.Now()
+	out, err := mm.rewrite("n", false, testInvite, sdpFor(upIP.String(), mp.up.port), now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	mp.relayC = firstPort(t, out)
+	out, err = mm.rewrite("n", true, testAnswer, secureSDP(sdpFor("127.0.0.1", mp.cli.port)), now)
+	if err != errClientNoCrypto {
+		t.Fatalf("answer without crypto: %v", err)
+	}
+	expectPlainSDP(t, out)
+	mp.relayU = firstPort(t, out)
+	sendUDP(t, mp.up.rtp, mp.relayPriv(false), mp.us.next("no-key-down"))
+	expectNoPacket(t, mp.cli.rtp)
+	_, sealed := mp.cs.sealRTP("no-key-up")
+	sendUDP(t, mp.cli.rtp, mp.relayCli(false), sealed)
+	expectNoPacket(t, mp.up.rtp)
+	waitFor(t, func() bool { return mm.srtpNoKeyToClient.Load() == 1 && mm.srtpNoKey.Load() == 1 })
+}
+
+// Knihovna přijme příchozí hovor bez šifrování: ústředna dostane 488
+// (hovor se nespojí), knihovna ACK a BYE; nic z toho nejde dál.
+func TestSRTPInsecureAnswerIncoming(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+	register(t, e, c)
+	cl := newCall(t, "insec-", 0)
+	e.up.sendUDP(e.privSIP(), incomingInvite(t, e, cl.callID, 100, cl.mediaPath.up.port))
+	ci := c.expectRequest("INVITE")
+	c.send(responseText(ci, 200, "OK", "cli-tag", []string{"Contact: <" + c.contact() + ">"}, sdpBody("127.0.0.1", cl.cli.port)))
+
+	r := e.up.expectResponse(488, "INVITE")
+	if !strings.Contains(r.m.get("to"), "tag=cli-tag") || len(r.m.body) != 0 || r.m.has("contact") {
+		t.Fatalf("488 to the miniserver:\n%s", r.raw)
+	}
+	ack := c.expectRequest("ACK")
+	if ack.ruri != c.contact() || ack.get("cseq") != "100 ACK" || !strings.Contains(ack.get("to"), "tag=cli-tag") || !strings.Contains(ack.get("from"), "tag=u1") {
+		t.Fatalf("ACK to the client: %+v", ack)
+	}
+	bye := c.expectRequest("BYE")
+	if bye.get("cseq") != "101 BYE" || bye.get("call-id") != cl.callID || !strings.Contains(bye.get("reason"), "cause=488") ||
+		!strings.Contains(bye.get("to"), "tag=cli-tag") || !strings.Contains(bye.get("from"), "tag=u1") {
+		t.Fatalf("BYE to the client: %+v", bye)
+	}
+	c.send(responseText(bye, 200, "OK", "cli-tag", nil, ""))
+	waitFor(t, func() bool { return e.counter("sip.local_answered") == 1 })
+	// ACK ústředny na 488 ke knihovně nejde.
+	e.up.sendUDP(e.privSIP(), upRequest(e, "ACK", cl.callID, 100, "cli-tag"))
+	waitFor(t, func() bool { return e.counter("sip.local_acked") == 1 })
+	c.expectNothing()
+	e.up.expectNothing()
+	if e.counter("sip.insecure_answer") != 1 || e.mediaStat("streams") != 0 {
+		t.Fatalf("insecure_answer %d, streams %d", e.counter("sip.insecure_answer"), e.mediaStat("streams"))
+	}
+}
+
+// Spojený hovor, re-INVITE ústředny a knihovna odpoví bez šifrování: re-INVITE
+// dostane 488 a oba konce BYE.
+func TestSRTPInsecureAnswerReinvite(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+	register(t, e, c)
+	cl := establishOutgoing(t, e, c)
+	cl.checkMedia(t, "talk")
+
+	inv := incomingInvite(t, e, cl.callID, 300, cl.mediaPath.up.port)
+	inv = strings.Replace(inv, "To: <sip:"+testUser+"@"+upIP.String()+">", "To: <sip:"+testUser+"@"+upIP.String()+">;tag=c1", 1)
+	e.up.sendUDP(e.privSIP(), inv)
+	ci := c.expectRequest("INVITE")
+	// Odpověď se značkou, kterou relé nenabídlo.
+	c.send(responseText(ci, 200, "OK", "c1", []string{"Contact: <" + c.contact() + ">"},
+		sdpSecure("127.0.0.1", cl.cli.port, "a=crypto:9 AES_CM_128_HMAC_SHA1_80 inline:"+testKey1)))
+
+	e.up.expectResponse(488, "INVITE")
+	ubye := e.up.expectRequest("BYE")
+	if ubye.m.get("cseq") != fmt.Sprintf("%d BYE", cl.cseq+1) || !strings.Contains(ubye.m.get("from"), "tag=c1") ||
+		!strings.Contains(ubye.m.get("reason"), "cause=488") || ubye.src != e.privSIP() {
+		t.Fatalf("BYE to the miniserver:\n%s", ubye.raw)
+	}
+	c.expectRequest("ACK")
+	cbye := c.expectRequest("BYE")
+	if cbye.get("cseq") != "301 BYE" || !strings.Contains(cbye.get("to"), "tag=c1") {
+		t.Fatalf("BYE to the client: %+v", cbye)
+	}
+	e.up.reply(ubye, 200, "OK", nil, "")
+	c.send(responseText(cbye, 200, "OK", "c1", nil, ""))
+	waitFor(t, func() bool { return e.counter("sip.local_answered") == 2 })
+	c.expectNothing()
+	e.up.expectNothing()
+	waitFor(t, func() bool { return e.mediaStat("streams") == 0 })
+	// Hlas už nejde.
+	_, sealed := cl.cs.sealRTP("after-end")
+	sendUDP(t, cl.cli.rtp, cl.relayClientRTP(), sealed)
+	expectNoPacket(t, cl.mediaPath.up.rtp)
+}
+
+// Statistiky obsahují počty šifrování, log ani statistiky nikdy klíče.
+func TestSRTPStatsAndLogs(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+	cl := establishOutgoing(t, e, c)
+	cl.checkMedia(t, "s")
+	m := e.stats()["media"].(map[string]any)
+	for _, k := range []string{"srtpAuthFail", "srtpReplay", "srtpNoKey", "srtpMalformed", "srtpRepeat", "srtpKeySwitch", "srtpNoKeyToClient", "srtpSealError", "srtpSeqResync", "srtpKeyError"} {
+		if _, ok := m[k]; !ok {
+			t.Errorf("stats without %s", k)
+		}
+	}
+	st := e.relay.Stats()
+	for _, bad := range []string{"inline", cl.cs.attr(1)[len("a=crypto:1 AES_CM_128_HMAC_SHA1_80 inline:"):]} {
+		if strings.Contains(st, bad) || strings.Contains(e.logs.String(), bad) {
+			t.Fatalf("key material leaked: %q", bad)
+		}
+	}
+}
diff --git a/libtailscale/p21relay/srtppeer_test.go b/libtailscale/p21relay/srtppeer_test.go
new file mode 100644
index 0000000..2de4b6b
--- /dev/null
+++ b/libtailscale/p21relay/srtppeer_test.go
@@ -0,0 +1,332 @@
+// Copyright (c) Phone21
+// SPDX-License-Identifier: BSD-3-Clause
+
+package p21relay
+
+// Testovací protějšky hlasu: volací knihovna mluví SRTP (kontexty pion
+// s vlastními klíči a s klíči z SDP, nezávisle na kódu relé), ústředna
+// obyčejné RTP.
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/binary"
+	"fmt"
+	"net"
+	"net/netip"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/pion/srtp/v3"
+)
+
+var testSuites = map[string]srtp.ProtectionProfile{
+	"AES_CM_128_HMAC_SHA1_80": srtp.ProtectionProfileAes128CmHmacSha1_80,
+	"AES_CM_128_HMAC_SHA1_32": srtp.ProtectionProfileAes128CmHmacSha1_32,
+}
+
+// testSRTP je šifrování na straně volací knihovny.
+type testSRTP struct {
+	t      *testing.T
+	suite  string
+	master []byte // vlastní klíč a sůl (odesílání)
+	enc    *srtp.Context
+	dec    *srtp.Context // klíčem relé
+	decKey string        // řádek a=crypto relé, ze kterého je dec
+	ssrc   uint32
+	seq    uint16
+	ts     uint32
+}
+
+func newTestSRTP(t *testing.T) *testSRTP {
+	t.Helper()
+	c := &testSRTP{t: t, suite: "AES_CM_128_HMAC_SHA1_80", ssrc: 0xC1C1C1C1, seq: 40000, ts: 160}
+	c.rekey()
+	return c
+}
+
+// rekey vytvoří nový vlastní klíč (knihovna při změně klíče začíná znovu).
+func (c *testSRTP) rekey() {
+	c.master = make([]byte, 30)
+	rand.Read(c.master)
+	c.newEnc()
+}
+
+func (c *testSRTP) newEnc() {
+	c.t.Helper()
+	enc, err := srtp.CreateContext(c.master[:16], c.master[16:], testSuites[c.suite])
+	if err != nil {
+		c.t.Fatal(err)
+	}
+	c.enc = enc
+}
+
+func (c *testSRTP) attr(tag int) string {
+	return fmt.Sprintf("a=crypto:%d %s inline:%s", tag, c.suite, base64.StdEncoding.EncodeToString(c.master))
+}
+
+// testCrypto je řádek a=crypto, jak ho přečte test.
+type testCrypto struct {
+	tag    int
+	suite  string
+	master []byte
+	line   string
+}
+
+// sdpCryptos vrátí přenosový protokol a řádky a=crypto prvního m=.
+func sdpCryptos(t *testing.T, body []byte) (string, []testCrypto) {
+	t.Helper()
+	var proto string
+	var out []testCrypto
+	inMedia := false
+	for _, l := range strings.Split(strings.TrimRight(string(body), "\r\n"), "\r\n") {
+		if strings.HasPrefix(l, "m=") {
+			if inMedia {
+				break
+			}
+			inMedia = true
+			proto = strings.Fields(l)[2]
+			continue
+		}
+		v, ok := strings.CutPrefix(l, "a=crypto:")
+		if !ok {
+			continue
+		}
+		if !inMedia {
+			t.Fatalf("session-level a=crypto:\n%s", body)
+		}
+		f := strings.Fields(v)
+		if len(f) != 3 {
+			t.Fatalf("a=crypto with %d fields: %q", len(f), l)
+		}
+		tag, err := strconv.Atoi(f[0])
+		key, ok := strings.CutPrefix(f[2], "inline:")
+		raw, err2 := base64.StdEncoding.DecodeString(key)
+		if err != nil || !ok || err2 != nil || len(raw) != 30 || testSuites[f[1]] == 0 {
+			t.Fatalf("bad a=crypto %q", l)
+		}
+		out = append(out, testCrypto{tag: tag, suite: f[1], master: raw, line: l})
+	}
+	return proto, out
+}
+
+// expectPlainSDP ověří, že tělo pro ústřednu nemá šifrování.
+func expectPlainSDP(t *testing.T, body []byte) {
+	t.Helper()
+	for _, l := range strings.Split(string(body), "\r\n") {
+		if strings.HasPrefix(l, "m=") && strings.Contains(l, "SAVP") {
+			t.Fatalf("secure profile toward the miniserver:\n%s", body)
+		}
+		for _, a := range []string{"a=crypto", "a=fingerprint", "a=setup", "a=tcap", "a=acap", "a=pcfg", "inline:"} {
+			if strings.Contains(l, a) {
+				t.Fatalf("%s toward the miniserver:\n%s", a, body)
+			}
+		}
+	}
+}
+
+// learnAnswer převezme klíč relé z odpovědi na nabídku knihovny (jeden
+// řádek se značkou wantTag) a vrátí ho.
+func (c *testSRTP) learnAnswer(body []byte, wantTag int) testCrypto {
+	c.t.Helper()
+	proto, cs := sdpCryptos(c.t, body)
+	if proto != "RTP/SAVP" || len(cs) != 1 || cs[0].tag != wantTag || cs[0].suite != c.suite {
+		c.t.Fatalf("answer to the client: proto %s, crypto %+v\n%s", proto, cs, body)
+	}
+	c.useRelayKey(cs[0])
+	return cs[0]
+}
+
+// answerOffer vybere z nabídky relé řádek se značkou tag, převezme jeho
+// sadu a klíč relé a vrátí atribut odpovědi s vlastním klíčem.
+func (c *testSRTP) answerOffer(body []byte, tag int) (string, []testCrypto) {
+	c.t.Helper()
+	proto, cs := sdpCryptos(c.t, body)
+	if proto != "RTP/SAVP" || len(cs) != 2 || cs[0].tag != 1 || cs[1].tag != 2 || cs[0].suite == cs[1].suite ||
+		bytes.Equal(cs[0].master, cs[1].master) {
+		c.t.Fatalf("offer to the client: proto %s, crypto %+v\n%s", proto, cs, body)
+	}
+	for _, x := range cs {
+		if x.tag == tag {
+			if x.suite != c.suite {
+				c.suite = x.suite
+				c.newEnc()
+			}
+			c.useRelayKey(x)
+			return c.attr(tag), cs
+		}
+	}
+	c.t.Fatalf("no tag %d offered", tag)
+	return "", nil
+}
+
+// useRelayKey nastaví dešifrování; stejný klíč kontext ponechá (jako
+// volací knihovna).
+func (c *testSRTP) useRelayKey(x testCrypto) {
+	c.t.Helper()
+	if c.dec != nil && c.decKey == x.suite+string(x.master) {
+		return
+	}
+	dec, err := srtp.CreateContext(x.master[:16], x.master[16:], testSuites[x.suite], srtp.SRTPReplayProtection(128), srtp.SRTCPReplayProtection(128))
+	if err != nil {
+		c.t.Fatal(err)
+	}
+	c.dec, c.decKey = dec, x.suite+string(x.master)
+}
+
+// plainRTP je odesílatel na straně ústředny.
+type plainRTP struct {
+	ssrc uint32
+	seq  uint16
+	ts   uint32
+}
+
+func (p *plainRTP) next(payload string) []byte {
+	p.seq++
+	p.ts += 160
+	return rtpPkt(p.ssrc, p.seq, p.ts, payload)
+}
+
+// sealRTP zašifruje další paket knihovny.
+func (c *testSRTP) sealRTP(payload string) (plain, sealed []byte) {
+	c.t.Helper()
+	c.seq++
+	c.ts += 160
+	plain = rtpPkt(c.ssrc, c.seq, c.ts, payload)
+	sealed, err := c.enc.EncryptRTP(nil, plain, nil)
+	if err != nil {
+		c.t.Fatal(err)
+	}
+	return plain, sealed
+}
+
+func (c *testSRTP) sealRTCP(payload string) (plain, sealed []byte) {
+	c.t.Helper()
+	plain = rtcpPkt(c.ssrc, payload)
+	sealed, err := c.enc.EncryptRTCP(nil, plain, nil)
+	if err != nil {
+		c.t.Fatal(err)
+	}
+	return plain, sealed
+}
+
+// recvFrom přečte jeden datagram a ověří jeho zdroj.
+func recvFrom(t *testing.T, at *net.UDPConn, wantSrc netip.AddrPort, what string) []byte {
+	t.Helper()
+	at.SetReadDeadline(time.Now().Add(waitLong))
+	buf := make([]byte, 4096)
+	n, src, err := at.ReadFromUDPAddrPort(buf)
+	if err != nil {
+		t.Fatalf("%s not delivered: %v", what, err)
+	}
+	if src = netip.AddrPortFrom(src.Addr().Unmap(), src.Port()); src != wantSrc {
+		t.Fatalf("%s from %v, want %v", what, src, wantSrc)
+	}
+	return buf[:n]
+}
+
+func sendUDP(t *testing.T, from *net.UDPConn, to netip.AddrPort, b []byte) {
+	t.Helper()
+	if _, err := from.WriteToUDPAddrPort(b, to); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// ---- hlas jednoho proudu přes relé ----
+
+// mediaPath je proud mezi testovací knihovnou a testovací ústřednou.
+type mediaPath struct {
+	cli, up        *rtpPair
+	cs             *testSRTP
+	us             *plainRTP
+	relayC, relayU int // porty relé na 127.0.0.1 a v privátní síti
+}
+
+func (m *mediaPath) relayCli(rtcp bool) netip.AddrPort {
+	p := m.relayC
+	if rtcp {
+		p++
+	}
+	return netip.AddrPortFrom(loopback4, uint16(p))
+}
+
+func (m *mediaPath) relayPriv(rtcp bool) netip.AddrPort {
+	p := m.relayU
+	if rtcp {
+		p++
+	}
+	return netip.AddrPortFrom(privIP, uint16(p))
+}
+
+func (m *mediaPath) sock(p *rtpPair, rtcp bool) *net.UDPConn {
+	if rtcp {
+		return p.rtcp
+	}
+	return p.rtp
+}
+
+// toUp pošle šifrovaný paket knihovny a čeká ho dešifrovaný u ústředny.
+func (m *mediaPath) toUp(t *testing.T, rtcp bool, payload string) {
+	t.Helper()
+	var plain, sealed []byte
+	if rtcp {
+		plain, sealed = m.cs.sealRTCP(payload)
+	} else {
+		plain, sealed = m.cs.sealRTP(payload)
+	}
+	sendUDP(t, m.sock(m.cli, rtcp), m.relayCli(rtcp), sealed)
+	got := recvFrom(t, m.sock(m.up, rtcp), m.relayPriv(rtcp), payload)
+	if !bytes.Equal(got, plain) {
+		t.Fatalf("%s: miniserver got %x, want %x", payload, got, plain)
+	}
+}
+
+// toClient pošle obyčejný paket ústředny a čeká ho šifrovaný u knihovny;
+// vrátí číslo paketu, které knihovna dostala.
+func (m *mediaPath) toClient(t *testing.T, rtcp bool, payload string) uint16 {
+	t.Helper()
+	var plain []byte
+	if rtcp {
+		plain = rtcpPkt(m.us.ssrc, payload)
+	} else {
+		plain = m.us.next(payload)
+	}
+	sendUDP(t, m.sock(m.up, rtcp), m.relayPriv(rtcp), plain)
+	got := recvFrom(t, m.sock(m.cli, rtcp), m.relayCli(rtcp), payload)
+	if bytes.Equal(got, plain) || bytes.Contains(got, []byte(payload)) {
+		t.Fatalf("%s reached the client unencrypted", payload)
+	}
+	var dec []byte
+	var err error
+	if rtcp {
+		dec, err = m.cs.dec.DecryptRTCP(nil, got, nil)
+	} else {
+		dec, err = m.cs.dec.DecryptRTP(nil, got, nil)
+	}
+	if err != nil {
+		t.Fatalf("%s: client cannot decrypt: %v", payload, err)
+	}
+	if rtcp {
+		if !bytes.Equal(dec, plain) {
+			t.Fatalf("%s: client got %x, want %x", payload, dec, plain)
+		}
+		return 0
+	}
+	// Číslo paketu smí relé vyrovnat, zbytek musí sedět.
+	if !bytes.Equal(dec[:2], plain[:2]) || !bytes.Equal(dec[4:], plain[4:]) {
+		t.Fatalf("%s: client got %x, want %x", payload, dec, plain)
+	}
+	return binary.BigEndian.Uint16(dec[2:])
+}
+
+// both ověří hlas oběma směry, RTP i RTCP.
+func (m *mediaPath) both(t *testing.T, tag string) {
+	t.Helper()
+	m.toClient(t, false, tag+"-rtp-down")
+	m.toUp(t, false, tag+"-rtp-up")
+	m.toClient(t, true, tag+"-rtcp-down")
+	m.toUp(t, true, tag+"-rtcp-up")
+}
