+func TestSDPCryptoRewrite(t *testing.T) {
+	mm := newMediaManager(fakeNet{}, upIP, &counters{}, &rateLog{})
+	defer mm.closeAll()
+	now := time.Now()
+
+	// Nabídka knihovny: první podporovaný řádek (_32), vše o šifrování pryč.
+	offer := "v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nc=IN IP4 127.0.0.1\r\nt=0 0\r\n" +
+		"a=crypto:9 AES_CM_128_HMAC_SHA1_80 inline:" + testKey1 + "\r\n" +
+		"a=tcap:1 RTP/SAVP\r\n" +
+		"m=audio 40000 RTP/SAVPF 0 101\r\n" +
+		"a=rtpmap:101 telephone-event/8000\r\n" +
+		"a=crypto:1 AES_256_CM_HMAC_SHA1_80 inline:" + testKey1 + testKey1[:16] + "\r\n" +
+		"a=crypto:2 AES_CM_128_HMAC_SHA1_32 inline:" + testKey2 + "\r\n" +
+		"a=crypto:3 AES_CM_128_HMAC_SHA1_80 inline:" + testKey1 + "\r\n" +
+		"a=acap:1 crypto:4 AES_CM_128_HMAC_SHA1_80 inline:" + testKey1 + "\r\n" +
+		"a=pcfg:1 t=1 a=1\r\n" +
+		"a=fingerprint:sha-256 00:11\r\n" +
+		"a=setup:actpass\r\n" +
+		"a=zrtp-hash:1.10 00\r\n" +
+		"a=cryptex\r\n" +
+		"a=sendrecv\r\n" +
+		"m=video 0 RTP/SAVP 96\r\n"
+	out, err := mm.rewrite("x", true, testInvite, []byte(offer), now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	expectPlainSDP(t, out)
+	for _, want := range []string{"m=audio ", " RTP/AVPF 0 101\r\n", "m=video 0 RTP/AVP 96\r\n", "a=rtpmap:101 telephone-event/8000\r\n", "a=sendrecv\r\n"} {
+		if !strings.Contains(string(out), want) {
+			t.Fatalf("missing %q:\n%s", want, out)
+		}
+	}
+	for _, gone := range []string{"zrtp", "cryptex", "fingerprint", "setup", "pcfg"} {
+		if strings.Contains(string(out), gone) {
+			t.Fatalf("%s left:\n%s", gone, out)
+		}
+	}
+
+	// Odpověď ústředny: stejná značka a sada, klíč relé, profil podle nabídky.
+	ans, err := mm.rewrite("x", false, testAnswer, []byte("v=0\r\nc=IN IP4 "+upIP.String()+"\r\nm=audio 30000 RTP/AVPF 0\r\nm=video 0 RTP/AVP 96\r\n"), now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(ans), " RTP/SAVPF 0\r\n") || !strings.Contains(string(ans), "m=video 0 RTP/SAVP 96\r\n") {
+		t.Fatalf("answer protocols:\n%s", ans)
+	}
+	_, lines := sdpCryptos(t, ans)
+	if len(lines) != 1 || lines[0].tag != 2 || lines[0].suite != "AES_CM_128_HMAC_SHA1_32" || strings.Contains(lines[0].line, testKey2) {
+		t.Fatalf("answer crypto %+v\n%s", lines, ans)
+	}
+	if strings.Count(string(ans), "a=crypto:") != 1 {
+		t.Fatalf("crypto on a disabled stream:\n%s", ans)
+	}
+	relayKey := lines[0]
+
+	// Nabídka ústředny (re-INVITE): obě sady, používaná sada první se
+	// stejným klíčem.
+	reoffer, err := mm.rewrite("x", false, sdpMsg{isReq: true, method: "INVITE", cseq: 50}, []byte("v=0\r\nc=IN IP4 "+upIP.String()+"\r\nm=audio 30000 RTP/AVP 0\r\n"), now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, lines = sdpCryptos(t, reoffer)
+	if len(lines) != 2 || lines[0].tag != 1 || lines[0].suite != "AES_CM_128_HMAC_SHA1_32" || lines[1].tag != 2 || lines[1].suite != "AES_CM_128_HMAC_SHA1_80" {
+		t.Fatalf("re-offer crypto %+v", lines)
+	}
+	if !bytes.Equal(lines[0].master, relayKey.master) {
+		t.Fatal("relay key of the suite in use changed in a re-offer")
+	}
+	// Na první nabídku (bez klíče relé) jde první sada _80.
+	first, err := mm.rewrite("z", false, testInvite, []byte("v=0\r\nc=IN IP4 "+upIP.String()+"\r\nm=audio 30000 RTP/AVP 0\r\n"), now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, l := sdpCryptos(t, first); len(l) != 2 || l[0].suite != "AES_CM_128_HMAC_SHA1_80" {
+		t.Fatalf("first offer crypto %+v", l)
+	}
+
+	// Odpověď knihovny se značkou, kterou relé nenabídlo: bez klíče.
+	_, err = mm.rewrite("x", true, sdpMsg{method: "INVITE", cseq: 50}, secureSDP(sdpFor("127.0.0.1", 40000, "a=crypto:7 AES_CM_128_HMAC_SHA1_80 inline:"+testKey1)), now)
+	if err != errClientNoCrypto {
+		t.Fatalf("answer with a foreign tag: %v", err)
+	}
+	// … ani se sadou jinou, než relé pod značkou nabídlo.
+	_, err = mm.rewrite("x", true, sdpMsg{method: "INVITE", cseq: 50}, secureSDP(sdpFor("127.0.0.1", 40000, "a=crypto:1 AES_CM_128_HMAC_SHA1_80 inline:"+testKey1)), now)
+	if err != errClientNoCrypto {
+		t.Fatalf("answer with another suite: %v", err)
+	}
+	st := mm.calls["x"].streams[0]
+	if st.recv.hasKey() {
+		t.Fatal("insecure answer left a key")
+	}
+	if _, ok := st.send.key(); ok {
+		t.Fatal("insecure answer left the relay's key")
+	}
+
+	// Nabídka bez použitelného šifrování nic nepřidělí.
+	for _, bad := range []string{
+		string(sdpFor("127.0.0.1", 40000)),
+		string(secureSDP(sdpFor("127.0.0.1", 40000))),
+		string(secureSDP(sdpFor("127.0.0.1", 40000, "a=crypto:1 AES_256_CM_HMAC_SHA1_80 inline:"+testKey1+testKey1[:16]))),
+		string(secureSDP(sdpFor("127.0.0.1", 40000, "a=crypto:1 AES_CM_128_HMAC_SHA1_80 inline:"+testKey1+" UNENCRYPTED_SRTP"))),
+		strings.Replace(string(sdpFor("127.0.0.1", 40000, "a=fingerprint:sha-256 00", "a=setup:actpass")), "RTP/AVP", "UDP/TLS/RTP/SAVP", 1),
+	} {
+		if _, err := mm.rewrite("y", true, testInvite, []byte(bad), now); err != errClientNoCrypto {
+			t.Fatalf("offer accepted (%v):\n%s", err, bad)
+		}
+	}
+	if mm.calls["y"] != nil {
+		t.Fatal("refused offer allocated media")
+	}
+}
