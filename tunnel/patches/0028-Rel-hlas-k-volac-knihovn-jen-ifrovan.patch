+// ---- hovor bez šifrování hlasu ----
+
+// dialogRef popisuje dialog, který relé ukončuje samo.
+type dialogRef struct {
+	callID    string
+	cliParty  string // From/To (name-addr se značkou) strany volací knihovny
+	upParty   string // totéž za ústřednu
+	cliTarget string // Contact knihovny, "" = podle registrace
+}
+
+// refuseInsecureAnswer vyřídí 2xx knihovny na INVITE z ústředny, které
+// nemá použitelné šifrování: ústředna místo něj dostane 488 (hovor se
+// nespojí; u re-INVITE zůstane původní relace), knihovna ACK a hned BYE.
+// U už spojeného hovoru dostane BYE i ústředna, ať hovor nezůstane viset.
+func (p *sipProxy) refuseInsecureAnswer(m *sipMsg, d dialogRef, num uint32, conn string, nv *sipVia, now time.Time) {
+	established := p.media.established(d.callID)
+	out := newResponse(m, 488, "Not Acceptable Here", "").bytes()
+	p.cnt.inc("sip.local_reply_488")
+	if tc, dst, ok := p.sendResponseUpstream(out, conn, nv); ok {
+		// Opakovat do ACK ústředny (po TCP jen pro jeho zachycení).
+		tx := &txEntry{data: out, dest: dst, response: true, local: true, tcp: tc, expire: now.Add(sipTxTimeout)}
+		if tc == nil {
+			tx.next, tx.interval = now.Add(sipT1), sipT1
+		}
+		p.addTx(rspKey(d.callID, num), tx)
+	}
+	ack := p.localRequest("ACK", p.clientTarget(d), p.localVia(true, d.callID, "ACK", num), d.upParty, d.cliParty, d.callID, num)
+	p.sendClient(ack.bytes())
+	p.endCall(d, established, now)
+}
+
+// endCall ukončí hovor bez šifrování hlasu: BYE knihovně a případně
+// ústředně (odpovědi na ně relé zachytí), a uvolní jeho hlas.
+func (p *sipProxy) endCall(d dialogRef, byeUpstream bool, now time.Time) {
+	reason := sipHeader{name: "Reason", key: "reason", value: insecureReason}
+	n := p.media.lastCSeq(d.callID, false) + 1
+	bye := p.localRequest("BYE", p.clientTarget(d), p.localVia(true, d.callID, "BYE", n), d.upParty, d.cliParty, d.callID, n, reason)
+	p.sendClient(bye.bytes())
+	if byeUpstream {
+		n := p.media.lastCSeq(d.callID, true) + 1
+		via := p.localVia(false, d.callID, "BYE", n)
+		out := p.localRequest("BYE", "sip:"+p.upstream.String(), via, d.cliParty, d.upParty, d.callID, n, reason).bytes()
+		p.sendUDP(out, p.upstream)
+		p.addTx("req|"+via.branch()+"|BYE", &txEntry{
+			data: out, dest: p.upstream,
+			next: now.Add(sipT1), interval: sipT1, expire: now.Add(sipTxTimeout),
+		})
+	}
+	p.cnt.inc("sip.local_bye")
+	p.media.release(d.callID, "insecure")
+}
+
+// localVia je Via požadavku relé: ke knihovně (TLS) nebo k ústředně (UDP).
+func (p *sipProxy) localVia(toClient bool, callID, method string, num uint32) *sipVia {
+	side := "u"
+	if toClient {
+		side = "c"
+	}
+	branch := localBranchPrefix + p.mac("local", side, callID, method, strconv.FormatUint(uint64(num), 10))
+	if toClient {
+		return &sipVia{transport: "TLS", host: loopback4.String(), port: p.sipPort, params: []sipParam{{k: "branch", v: branch, hasV: true}}}
+	}
+	return &sipVia{transport: "UDP", host: p.localIP.String(), port: p.upPort, params: []sipParam{{k: "branch", v: branch, hasV: true}, {k: "rport"}}}
+}
+
+// clientTarget je Request-URI pro knihovnu: její Contact, jinak kontakt
+// z registrace, jinak samotné spojení (knihovna hledá dialog podle
+// Call-ID a značek, ne podle Request-URI).
+func (p *sipProxy) clientTarget(d dialogRef) string {
+	if d.cliTarget != "" {
+		return d.cliTarget
+	}
+	if u, ok := parseURI(parseNameAddr(d.cliParty).uri); ok {
+		if c, ok := p.contacts[u.user]; ok {
+			return c
+		}
+	}
+	port := p.sipPort
+	if p.client != nil {
+		port = int(p.client.remote.Port())
+	}
+	return "sip:127.0.0.1:" + strconv.Itoa(port) + ";transport=tls"
+}
+
+// localRequest sestaví požadavek relé uvnitř dialogu.
+func (p *sipProxy) localRequest(method, ruri string, via *sipVia, from, to, callID string, num uint32, extra ...sipHeader) *sipMsg {
+	m := &sipMsg{isReq: true, method: method, ruri: ruri}
+	m.hdrs = append(m.hdrs,
+		sipHeader{name: "Via", key: "via", value: via.String()},
+		sipHeader{name: "Max-Forwards", key: "max-forwards", value: "70"},
+		sipHeader{name: "From", key: "from", value: from},
+		sipHeader{name: "To", key: "to", value: to},
+		sipHeader{name: "Call-ID", key: "call-id", value: callID},
+		sipHeader{name: "CSeq", key: "cseq", value: strconv.FormatUint(uint64(num), 10) + " " + method},
+	)
+	m.hdrs = append(m.hdrs, extra...)
+	return m
+}
