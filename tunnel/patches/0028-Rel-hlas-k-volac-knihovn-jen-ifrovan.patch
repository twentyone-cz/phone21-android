+// Re-INVITE s novým klíčem knihovny: do přechodu platí starý, potom jen nový.
+func TestSRTPReinviteNewClientKey(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+	register(t, e, c)
+	cl := establishOutgoing(t, e, c)
+	old := *cl.cs
+	cl.cs.rekey()
+	cl.cs.seq, cl.cs.ts = old.seq, old.ts // knihovna čísluje dál
+
+	c.send(requestText("INVITE", e.relayURI(), cl.clientHeaders(c, newBranch(), cl.cseq+1, "INVITE", true), cl.offer()))
+	ri := e.up.expectRequest("INVITE")
+	expectPlainSDP(t, ri.m.body)
+	// Před dokončením výměny knihovna šifruje starým klíčem.
+	oldPath := cl.mediaPath
+	oldPath.cs = &old
+	oldPath.toUp(t, false, "old-key")
+	cl.cs.seq, cl.cs.ts = old.seq, old.ts
+
+	e.up.reply(ri, 200, "OK", []string{cl.upContact(e)}, sdpBody(upIP.String(), cl.mediaPath.up.port))
+	cl.cs.learnAnswer(c.expectResponse(200, "INVITE").body, 1)
+	c.send(requestText("ACK", e.relayURI(), cl.clientHeaders(c, newBranch(), cl.cseq+1, "ACK", true), ""))
+	e.up.expectRequest("ACK")
+
+	cl.checkMedia(t, "new-key")
+	if n := e.mediaStat("srtpKeySwitch"); n != 1 {
+		t.Fatalf("srtpKeySwitch %d", n)
+	}
+	// Starý klíč už neprojde.
+	before := e.mediaStat("srtpAuthFail")
+	old.seq = cl.cs.seq + 5
+	_, stale := old.sealRTP("stale-key")
+	sendUDP(t, cl.cli.rtp, cl.relayClientRTP(), stale)
+	expectNoPacket(t, cl.mediaPath.up.rtp)
+	waitFor(t, func() bool { return e.mediaStat("srtpAuthFail") == before+1 })
+}
