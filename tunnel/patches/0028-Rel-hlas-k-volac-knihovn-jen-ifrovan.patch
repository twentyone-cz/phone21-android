+// relayKey vrátí klíč relé pro sadu; vytvoří ho při prvním použití.
+func (s *mediaStream) relayKey(suite srtpSuite) srtpKey {
+	if k, ok := s.relayKeys[suite]; ok {
+		return k
+	}
+	if s.relayKeys == nil {
+		s.relayKeys = make(map[srtpSuite]srtpKey)
+	}
+	k := newRelayKey(suite)
+	s.relayKeys[suite] = k
+	return k
