+// Podvržené, poškozené a přehrané pakety z 127.0.0.1 se do hovoru nedostanou.
+func TestSRTPInjectionDropped(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+	cl := establishOutgoing(t, e, c)
+	cl.checkMedia(t, "before")
+	none := func(what string) {
+		t.Helper()
+		expectNoPacket(t, cl.mediaPath.up.rtp)
+		expectNoPacket(t, cl.mediaPath.up.rtcp)
+	}
+
+	// Nešifrovaný paket ze správného portu knihovny.
+	authFail := e.mediaStat("srtpAuthFail")
+	sendUDP(t, cl.cli.rtp, cl.relayClientRTP(), rtpPkt(cl.cs.ssrc, cl.cs.seq+1, 0, "plain-inject"))
+	sendUDP(t, cl.cli.rtcp, cl.relayClientRTCP(), rtcpPkt(cl.cs.ssrc, "plain-rtcp-injection-payload"))
+	none("plain")
+	// Špatně podepsaný a cizím klíčem šifrovaný paket.
+	_, bad := cl.cs.sealRTP("tampered")
+	bad[len(bad)-1] ^= 0x55
+	sendUDP(t, cl.cli.rtp, cl.relayClientRTP(), bad)
+	other := newTestSRTP(t)
+	other.seq = cl.cs.seq + 10
+	_, foreign := other.sealRTP("other-key")
+	sendUDP(t, cl.cli.rtp, cl.relayClientRTP(), foreign)
+	none("forged")
+	waitFor(t, func() bool { return e.mediaStat("srtpAuthFail") == authFail+4 })
+
+	// Správně šifrovaný paket z jiného portu na 127.0.0.1.
+	intruder, err := net.ListenUDP("udp4", &net.UDPAddr{IP: loopback4.AsSlice()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer intruder.Close()
+	foreignSrc := e.mediaStat("dropForeignClient")
+	_, good := cl.cs.sealRTP("right-key-wrong-port")
+	sendUDP(t, intruder, cl.relayClientRTP(), good)
+	none("other port")
+	waitFor(t, func() bool { return e.mediaStat("dropForeignClient") == foreignSrc+1 })
+
+	// Přehrání: starší ověřený paket znovu.
+	_, p1 := cl.cs.sealRTP("first")
+	sendUDP(t, cl.cli.rtp, cl.relayClientRTP(), p1)
+	recvFrom(t, cl.mediaPath.up.rtp, cl.relayPrivRTP(), "first")
+	cl.toUp(t, false, "second")
+	sendUDP(t, cl.cli.rtp, cl.relayClientRTP(), p1)
+	_, r1 := cl.cs.sealRTCP("rtcp-once")
+	sendUDP(t, cl.cli.rtcp, cl.relayClientRTCP(), r1)
+	recvFrom(t, cl.mediaPath.up.rtcp, cl.relayPrivRTCP(), "rtcp-once")
+	sendUDP(t, cl.cli.rtcp, cl.relayClientRTCP(), r1)
+	none("replay")
+	waitFor(t, func() bool { return e.mediaStat("srtpReplay") == 2 })
+
+	// Konec tónové volby: knihovna pošle stejný paket třikrát hned po sobě;
+	// všechny tři dojdou ústředně, čtvrtý už ne.
+	plain, dtmf := cl.cs.sealRTP("dtmf-end")
+	for i := 0; i < 4; i++ {
+		sendUDP(t, cl.cli.rtp, cl.relayClientRTP(), dtmf)
+		if i < 3 {
+			if got := recvFrom(t, cl.mediaPath.up.rtp, cl.relayPrivRTP(), "dtmf-end"); !bytes.Equal(got, plain) {
+				t.Fatalf("dtmf end %d: %x", i, got)
+			}
+		}
+	}
+	none("fourth repeat")
+	if e.mediaStat("srtpRepeat") != 2 {
+		t.Fatalf("srtpRepeat %d", e.mediaStat("srtpRepeat"))
+	}
+	cl.checkMedia(t, "after")
+}
