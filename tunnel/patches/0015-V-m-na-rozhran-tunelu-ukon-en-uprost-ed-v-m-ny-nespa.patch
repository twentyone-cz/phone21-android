 		if p := recover(); p != nil {
@@ -221,6 +292,10 @@ func (d *multiTUN) readFrom(dev *tunDevice) {
 			if stop {
 				return
 			}
+		case <-dev.close:
+			// Phone21: replaced or shut down. Do not wait for another read
+			// request to notice: Shutdown waits for this goroutine.
+			return
 		case <-d.close:
 			return
 		}
