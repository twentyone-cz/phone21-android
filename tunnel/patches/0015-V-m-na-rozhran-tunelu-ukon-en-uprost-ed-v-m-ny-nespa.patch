+// stopDevice asks dev to stop, once. The writer's runDevice closes its
+// underlying device; any other device never ran runDevice (it was replaced
+// before its turn) and is closed here, in the background like runDevice
+// does, so that its reads end. Only called by run.
+func (d *multiTUN) stopDevice(dev, writer *tunDevice) {
+	if dev.closed {
+		return
+	}
+	dev.closed = true
+	close(dev.close)
+	if dev == writer {
+		return
+	}
+	d.closers.Add(1)
+	go func() {
+		defer d.closers.Done()
+		if err := dev.dev.Close(); err != nil {
+			log.Printf("multiTUN: closing a replaced device: %v", err)
+		}
+	}()
+}
