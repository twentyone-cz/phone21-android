 // txEntry makes the UDP leg toward the miniserver reliable: the calling
 // library talks TLS and therefore never retransmits.
 //
+// Requests that went over TCP have an entry too (tcp set, no timer): when
+// the connection fails before any answer, tcpLost sends them again.
+//
 // Entries under ansKey hold the final answer to a non-INVITE request from
 // the miniserver for its retransmissions (no timer, just expire).
 type txEntry struct {
@@ -167,6 +171,9 @@ type txEntry struct {
 	invite    bool // INVITE client transaction: Timer A is not capped at T2
 	response  bool // final response to an INVITE from the miniserver, until its ACK
 	completed bool // final response seen (request entries only)
+	answered  bool // any response seen (request entries only)
+	tcp       *tcpConn
+	tcpSends  int // connections tried
 	ack       []byte
 	next      time.Time // zero: no more retransmissions
 	interval  time.Duration
@@ -566,7 +573,49 @@ func (p *sipProxy) handle(ev sipEvent) {
 		if p.outTCP == ev.tc {
 			p.outTCP = nil
 		}
+		p.tcpLost(ev.tc)
+	}
+}
+
+// tcpLost deals with requests of the calling library that went over a TCP
+// connection which failed (or never came up) before any answer: the
+// miniserver may never have got them, and the library (TLS) does not
+// repeat them. Each goes once more over a new connection; after that the
+// library gets 503 at once instead of waiting for its 32 s timeout.
+func (p *sipProxy) tcpLost(tc *tcpConn) {
+	for k, tx := range p.txs {
+		if tx.tcp != tc || tx.answered {
+			continue
+		}
+		if tx.tcpSends < maxTCPSends {
+			tx.tcpSends++
+			tx.tcp = p.upstreamTCP()
+			p.cnt.inc("upstream.tcp_resent")
+			if p.sendTCP(tx.tcp, tx.data) {
+				continue
+			}
+		}
+		delete(p.txs, k)
+		p.cnt.inc("upstream.tcp_failed")
+		p.failRequest(tx.data)
+	}
+}
+
+// failRequest answers a request of the calling library that the relay
+// forwarded (data, with the relay's Via on top) with 503.
+func (p *sipProxy) failRequest(data []byte) {
+	m, err := parseSIP(data)
+	if err != nil || !m.isReq || m.method == "ACK" {
+		return
 	}
+	m.popTopValue("via")
+	if _, ok := m.topValue("via"); !ok {
+		return
+	}
+	resp := newResponse(m, 503, "Service Unavailable", p.toTag(m))
+	p.mediaOnResponse(resp, m.method)
+	p.cnt.inc("sip.local_reply_503")
+	p.sendClient(resp.bytes())
 }
 
