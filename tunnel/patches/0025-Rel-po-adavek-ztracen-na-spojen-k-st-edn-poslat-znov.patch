+// A request sent over a TCP connection that breaks before any answer
+// (the miniserver restarted and answers the old connection with a reset)
+// goes again over a new connection.
+func TestTCPRequestResentAfterReset(t *testing.T) {
+	e := newEnv(t)
+	c := newFakeClient(t, e)
+	c.send(bigMessage(c))
+	first := e.up.expectRequest("MESSAGE")
+	if first.conn == nil {
+		t.Fatal("big MESSAGE went over UDP")
+	}
+	first.conn.(*net.TCPConn).SetLinger(0)
+	first.conn.Close() // reset, no answer
+	var again upMsg
+	select {
+	case again = <-e.up.in: // identical bytes, so not via recv
+	case <-time.After(waitLong):
+		t.Fatal("request not sent again")
+	}
+	if string(again.raw) != string(first.raw) || again.conn == nil || again.conn == first.conn {
+		t.Fatalf("sent again over %v (first %v):\n%s", again.conn, first.conn, again.raw)
+	}
+	e.up.reply(again, 200, "OK", nil, "")
+	c.expectResponse(200, "MESSAGE")
+	if e.counter("upstream.tcp_resent") != 1 {
+		t.Fatalf("tcp_resent %d", e.counter("upstream.tcp_resent"))
+	}
+
+	// After an answer, a broken connection sends nothing again.
+	c.send(bigMessage(c))
+	m := e.up.expectRequest("MESSAGE")
+	e.up.reply(m, 200, "OK", nil, "")
+	c.expectResponse(200, "MESSAGE")
+	m.conn.(*net.TCPConn).SetLinger(0)
+	m.conn.Close()
+	e.up.expectNothing()
+	if e.counter("upstream.tcp_resent") != 1 {
+		t.Fatalf("tcp_resent %d", e.counter("upstream.tcp_resent"))
+	}
+}
+
+// When the connection cannot be made, the request is tried once more,
+// and then the calling library gets 503 at once instead of waiting 32 s.
+func TestTCPDialFailure(t *testing.T) {
+	nw := &failDialNet{}
+	e := newEnvNet(t, nw)
+	c := newFakeClient(t, e)
+
+	nw.fails.Store(2)
+	cl := &call{callID: "tcpfail-" + newBranch(), cli: newRTPPair(t, loopback4), cseq: 5}
+	hdrs := append(cl.clientHeaders(c, newBranch(), cl.cseq, "INVITE", false), e.relayRoute(), "Subject: "+strings.Repeat("s", 1200))
+	start := time.Now()
+	c.send(requestText("INVITE", "sip:"+testNumber+"@"+upIP.String(), hdrs, sdpBody("127.0.0.1", cl.cli.port)))
+	r := c.expectResponse(503, "INVITE")
+	if d := time.Since(start); d > 2*time.Second {
+		t.Fatalf("503 after %v", d)
+	}
+	if !strings.Contains(r.get("to"), "tag=") || len(r.values("via")) != 1 {
+		t.Fatalf("503 headers: To %q, Vias %q", r.get("to"), r.values("via"))
+	}
+	waitFor(t, func() bool { return e.mediaStat("streams") == 0 })
+	if e.counter("upstream.tcp_failed") != 1 {
+		t.Fatalf("tcp_failed %d", e.counter("upstream.tcp_failed"))
+	}
+	e.up.expectNothing()
+
+	// Only the first attempt fails: the request gets through.
+	nw.fails.Store(1)
+	c.send(bigMessage(c))
+	m := e.up.expectRequest("MESSAGE")
+	e.up.reply(m, 200, "OK", nil, "")
+	c.expectResponse(200, "MESSAGE")
+	if e.counter("upstream.tcp_failed") != 1 || e.counter("upstream.tcp_resent") != 2 {
+		t.Fatalf("tcp_failed %d, tcp_resent %d", e.counter("upstream.tcp_failed"), e.counter("upstream.tcp_resent"))
+	}
+}
