+// Data that already waits when a connection is accepted counts as
+// progress (and stays readable).
+func TestGuardDataAtAccept(t *testing.T) {
+	ln, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	g := &connGuard{name: "test", maxSilent: 4, maxBusy: 4, silentTimeout: time.Minute, cnt: &counters{}}
+	accept := func(payload string) *guardedConn {
+		c, err := net.Dial("tcp4", ln.Addr().String())
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { c.Close() })
+		if payload != "" {
+			c.Write([]byte(payload))
+		}
+		s, err := ln.Accept()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if payload != "" {
+			waitFor(t, func() bool { return hasData(s) })
+		}
+		gc := g.add(s)
+		t.Cleanup(func() { gc.Close() })
+		return gc
+	}
+	accept("")
+	gc := accept("x")
+	if silent, busy := g.counts(); silent != 1 || busy != 1 {
+		t.Fatalf("%d silent, %d busy", silent, busy)
+	}
+	buf := make([]byte, 4)
+	if n, err := gc.Read(buf); err != nil || string(buf[:n]) != "x" {
+		t.Fatalf("read %q %v", buf[:n], err)
+	}
+	gc.Close()
+	if silent, busy := g.counts(); silent != 1 || busy != 0 {
+		t.Fatalf("after close: %d silent, %d busy", silent, busy)
+	}
+}
diff --git a/libtailscale/p21relay/peek_linux.go b/libtailscale/p21relay/peek_linux.go
new file mode 100644
index 0000000..ce6857f
--- /dev/null
+++ b/libtailscale/p21relay/peek_linux.go
@@ -0,0 +1,30 @@
+// Copyright (c) Phone21
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build linux
+
+package p21relay
+
+import (
+	"net"
+	"syscall"
+)
+
+// hasData reports whether data already waits on c, without reading it.
+func hasData(c net.Conn) bool {
+	sc, ok := c.(syscall.Conn)
+	if !ok {
+		return false
+	}
+	rc, err := sc.SyscallConn()
+	if err != nil {
+		return false
+	}
+	var buf [1]byte
+	n := 0
+	rc.Read(func(fd uintptr) bool {
+		n, _, _ = syscall.Recvfrom(int(fd), buf[:], syscall.MSG_PEEK|syscall.MSG_DONTWAIT)
+		return true // never wait
+	})
+	return n > 0
+}
